@namespace MealPlanner.Shared.Components
@inject ILocalizationService Loc
@implements IDisposable

@* The app's "add to home screen" screenshots on the shared Nxt.UI carousel. Used in the first-launch
   welcome wizard and the iOS guide (App.razor) and on the /settings/install help page. *@
<NxtInstallCarousel Slides="slides" @bind-Current="Current" ShowProgress="ShowProgress"
                    FinishText="@(string.IsNullOrWhiteSpace(FinishText) ? Loc["carousel_start"] : FinishText)" OnFinish="OnFinish" />

@code {
    private List<NxtInstallCarousel.Slide> slides = new();

    [Parameter] public int Current { get; set; }
    [Parameter] public EventCallback<int> CurrentChanged { get; set; }
    [Parameter] public string? FinishText { get; set; }
    [Parameter] public bool ShowProgress { get; set; } = true;
    [Parameter] public string ImagePrefix { get; set; } = "images/";
    [Parameter] public EventCallback OnFinish { get; set; }

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += RebuildSlides;
        RebuildSlides();
    }

    private void RebuildSlides()
    {
        slides =
        [
            new(Loc["carousel_step1"], $"{ImagePrefix}step1.jpg", Loc["carousel_step1_alt"], Loc.T("carousel_badge", 1)),
            new(Loc["carousel_step2"], $"{ImagePrefix}step2.jpg", Loc["carousel_step2_alt"], Loc.T("carousel_badge", 2)),
            new(Loc["carousel_step3"], $"{ImagePrefix}step3.jpg", Loc["carousel_step3_alt"], Loc.T("carousel_badge", 3))
        ];
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Loc.OnLanguageChanged -= RebuildSlides;
}
