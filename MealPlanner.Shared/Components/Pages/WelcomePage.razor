@page "/welcome"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@implements IDisposable
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="mk-page mk-welcome" dir="@Loc.Direction">
    <div class="mk-welcome-head">
        <span class="mk-eyebrow">@Loc["welcome_eyebrow"]</span>
        <h1 class="mk-welcome-title">@Loc["app_title"]</h1>
        <p class="mk-welcome-lead">@Loc["welcome_lead"]</p>
    </div>

    <div class="mk-welcome-tiles" aria-hidden="true">
        <span class="mk-tile t-vegetarian"><img src="img/meals/stew.svg" alt="" /></span>
        <span class="mk-tile t-vegan"><img src="img/meals/salad.svg" alt="" /></span>
        <span class="mk-tile t-fish"><img src="img/meals/fish.svg" alt="" /></span>
        <span class="mk-tile t-meat"><img src="img/meals/meat.svg" alt="" /></span>
    </div>

    <div class="mk-start-list">
        <button class="mk-start is-primary" disabled="@busy" @onclick="StartEmpty">
            <span class="mk-start-icon"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span>
            <span class="mk-start-copy"><strong>@Loc["welcome_empty"]</strong><span>@Loc["welcome_empty_desc"]</span></span>
        </button>
        <button class="mk-start" disabled="@busy" @onclick="AskAssistant">
            <span class="mk-start-icon is-soft"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg></span>
            <span class="mk-start-copy"><strong>@Loc["welcome_assistant"]</strong><span>@Loc["welcome_assistant_desc"]</span></span>
        </button>
    </div>

    <p class="mk-welcome-note">@Loc["welcome_note"]</p>
</div>

@code {
    private string uid = "";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguage;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) { Nav.NavigateTo("/signin", replace: true); return; }
        uid = user.Uid;
    }


    private Task StartEmpty() => FinishAsync("/");
    private Task AskAssistant() => FinishAsync("/ai-plan");

    // Remembering the choice is what stops the Week page from sending the user back here.
    private async Task FinishAsync(string target)
    {
        busy = true;
        try
        {
            var profile = await UserService.GetProfileAsync(uid) ?? new UserProfile { Uid = uid, DisplayName = uid };
            profile.FirstWeekAutoFilled = true;
            await UserService.CreateProfileAsync(profile);
        }
        catch { }
        Nav.NavigateTo(target, replace: true);
    }

    private void OnLanguage() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.OnLanguageChanged -= OnLanguage;
}
