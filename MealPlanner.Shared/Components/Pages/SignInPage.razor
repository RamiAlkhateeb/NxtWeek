@page "/signin"
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Models
@implements IDisposable
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="mk-page mk-signin" dir="@Loc.Direction">
    <div class="mk-signin-head">
        <h1 class="mk-welcome-title">@Loc["app_title"]</h1>
        <p class="mk-signin-lead">@Loc["signin_lead"]</p>
        <p class="mk-subtitle">@Loc["signin_sub"]</p>
    </div>

    <div class="mk-signin-card">
        <label class="mk-field">
            <span class="mk-label">@Loc["signin_email"]</span>
            <input class="mk-input" type="email" dir="ltr" placeholder="name@example.com" @bind="email" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@isProcessing" />
        </label>
        @if (!string.IsNullOrEmpty(error)) { <div class="mk-notice is-error">@error</div> }
        <button class="mk-btn is-lg is-block" @onclick="Submit" disabled="@(string.IsNullOrWhiteSpace(email) || isProcessing)">
            @(isProcessing ? Loc["loading"] : Loc["signin_continue"])
        </button>
    </div>

    <div class="mk-signin-guest">
        <button class="mk-link-btn" @onclick="ContinueAsGuest">@Loc["signin_guest"]</button>
        <span class="mk-subtitle">@Loc["signin_guest_note"]</span>
    </div>
</div>

@code {
    private string email = "";
    private string error = "";
    private bool isProcessing;

    protected override void OnInitialized() => Loc.OnLanguageChanged += OnLanguage;
    private void OnLanguage() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.OnLanguageChanged -= OnLanguage;

    private void ContinueAsGuest() => Nav.NavigateTo("/", replace: true);

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(email)) return;
        email = email.Trim();

        if (!IsValidEmail(email)) { error = Loc["signin_invalid_email"]; return; }

        isProcessing = true;
        error = "";
        StateHasChanged();

        try
        {
            await Auth.SignInAsync(email);
            Nav.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            error = Loc.T("signin_failed", ex.Message);
        }
        finally { isProcessing = false; }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private static bool IsValidEmail(string emailStr)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(emailStr);
            return addr.Address == emailStr && emailStr.Contains('.');
        }
        catch { return false; }
    }
}
