@page "/friends"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@implements IDisposable
@inject IAuthService Auth
@inject IUserService UserService
@inject IMealCatalogService CatalogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject ToastService Toasts

<div class="mk-page mk-friends" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row is-start">
            <BackButton Fallback="/settings" />
            <div class="mk-title-block">
                <h1 class="mk-title">@Loc["friends_title"]</h1>
                <p class="mk-subtitle">@Loc["friends_subtitle"]</p>
            </div>
        </div>

        @if (!isLoading && hasUsername)
        {
            <div class="mk-add-friend">
                <label class="mk-search">
                    <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
                    <input dir="ltr" @bind="friendUsername" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="@Loc["friends_add_placeholder"]" aria-label="@Loc["friends_add_placeholder"]" disabled="@isSendingRequest" />
                </label>
                <button class="mk-icon-btn is-ink is-lg" @onclick="SendRequest" disabled="@(isSendingRequest || string.IsNullOrWhiteSpace(friendUsername))" aria-label="@Loc["friends_send_request"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(feedback)) { <div class="mk-notice @(isError ? "is-error" : "")">@feedback</div> }

            <div class="mk-username-card">
                <div class="mk-username-text">
                    <span class="mk-subtitle">@Loc["friends_your_username"]</span>
                    <strong dir="ltr">@uid</strong>
                </div>
                <button class="mk-btn is-outline is-sm" @onclick="CopyUsername">
                    <svg class="i" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/></svg>
                    @Loc["copy"]
                </button>
            </div>
        }
    </header>

    <main class="mk-stack">
        @if (isLoading)
        {
            <NxtSkeleton /><NxtSkeleton />
        }
        else if (!hasUsername)
        {
            <NxtEmptyState Icon="🔒" Title="@Loc["friends_need_username"]" Message="">
                <a class="mk-btn" href="settings">@Loc["friends_go_settings"]</a>
            </NxtEmptyState>
        }
        else
        {
            @foreach (var request in incomingRequests)
            {
                <article class="mk-request">
                    <span class="mk-avatar is-pink" aria-hidden="true">@Initial(request.SenderDisplayName)</span>
                    <div class="mk-person-copy">
                        <strong>@request.SenderDisplayName</strong>
                        <span class="mk-subtitle">@Loc["friends_wants_to_add"]</span>
                    </div>
                    <button class="mk-icon-btn is-ink is-lg" @onclick="() => AcceptRequest(request.SenderUid)" aria-label="@Loc["friends_accept"]">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
                    </button>
                    <button class="mk-icon-btn is-outline is-lg" @onclick="() => DeclineRequest(request.SenderUid)" aria-label="@Loc["friends_decline"]">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                </article>
            }

            @if (friends.Count == 0)
            {
                <p class="mk-empty-line">@Loc["friends_empty"]</p>
            }

            @for (var index = 0; index < friends.Count; index++)
            {
                var friend = friends[index];
                var open = selectedFriend?.Uid == friend.Uid;
                var tone = index % 4;
                <section class="mk-friend @(open ? "is-open" : "")">
                    <button class="mk-friend-head" @onclick="() => SelectFriend(friend)" aria-expanded="@open">
                        <span class="mk-avatar tone-@tone @(open ? "is-ink" : "")" aria-hidden="true">@Initial(friend.DisplayName)</span>
                        <span class="mk-person-copy">
                            <strong>@friend.DisplayName</strong>
                            @if (open && !isLoadingFriendWeek) { <span class="mk-subtitle">@Loc.T("friends_planned_days", PlannedDays)</span> }
                            else { <span class="mk-subtitle" dir="ltr">@friend.Uid</span> }
                        </span>
                        <svg class="i mk-past-chev @(open ? "is-open" : "")" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </button>

                    @if (open)
                    {
                        <div class="mk-friend-body">
                            <div class="mk-weeknav">
                                <button class="mk-icon-btn is-plain" @onclick="PreviousWeek" disabled="@isLoadingFriendWeek" aria-label="@Loc["friends_prev_week"]">
                                    <svg class="i mk-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                                </button>
                                <span class="mk-weeknav-label">@WeekRangeLabel</span>
                                <button class="mk-icon-btn is-plain" @onclick="NextWeek" disabled="@isLoadingFriendWeek" aria-label="@Loc["friends_next_week"]">
                                    <svg class="i mk-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                                </button>
                            </div>

                            <div class="mk-friend-days @(isLoadingFriendWeek ? "is-loading" : "")">
                                @foreach (var day in selectedFriendWeek)
                                {
                                    var meal = MealFor(day.MealId);
                                    var mine = MyMealFor(day.Date);
                                    <div class="mk-friend-day @(meal is null ? "is-empty" : "")">
                                        <span class="mk-friend-dayname">@Loc.GetShortDayName(day.Date.DayOfWeek)</span>
                                        @if (meal is null)
                                        {
                                            <span class="mk-friend-meal is-none">—</span>
                                        }
                                        else
                                        {
                                            <span class="mk-dot @MealTypeStyle.T(meal.MealType)" aria-hidden="true"></span>
                                            <span class="mk-friend-meal">@meal.Name</span>
                                            @if (mine is null) { <span class="mk-diff is-ok">@Loc["friends_empty_day"]</span> }
                                            else if (mine.Id != meal.Id) { <span class="mk-diff">@Loc.T("friends_replaces", mine.Name)</span> }
                                        }
                                    </div>
                                }
                            </div>

                            <div class="mk-friend-actions">
                                <button class="mk-btn is-pink" disabled="@(isLoadingFriendWeek || isSyncing)" @onclick="ReplaceWeek">@Loc["friends_replace_week"]</button>
                                <button class="mk-btn" disabled="@(isLoadingFriendWeek || isSyncing)" @onclick="CopyEmptyDays">@Loc["friends_copy_empty"]</button>
                            </div>
                        </div>
                    }
                </section>
            }

            @if (discoverable.Count > 0)
            {
                <div class="mk-section-head"><h2>@Loc["friends_discoverable"]</h2><span class="mk-subtitle">@Loc["friends_discover_hint"]</span></div>
                @foreach (var user in discoverable)
                {
                    <article class="mk-request is-plain">
                        <span class="mk-avatar" aria-hidden="true">@Initial(user.DisplayName)</span>
                        <div class="mk-person-copy">
                            <strong>@user.DisplayName</strong>
                            <span class="mk-subtitle" dir="ltr">@@@user.Username</span>
                        </div>
                        <button class="mk-icon-btn is-ink is-lg" @onclick="() => AddDiscovered(user)" disabled="@isSendingRequest" aria-label="@Loc.T("friends_add_named", user.Username)">
                            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        </button>
                    </article>
                }
            }
        }
    </main>
</div>

@code {
    private string uid = "";
    private bool isLoading = true;
    private bool isSendingRequest;
    private bool isError;
    private string friendUsername = "";
    private string feedback = "";
    private List<FriendRequest> incomingRequests = new();
    private List<UserProfile> friends = new();
    private List<UserProfile> discoverable = new();
    private HashSet<string> alreadyConnected = new(StringComparer.OrdinalIgnoreCase);
    private UserProfile? selectedFriend;
    private List<WeeklyPlanEntry> selectedFriendWeek = new();
    private Dictionary<string, MealCatalogItem> catalog = new();
    private Dictionary<DateOnly, string> myWeek = new();
    private DateOnly displayedWeekStart;
    private bool isSyncing;
    private bool isLoadingFriendWeek;
    private int friendWeekRequestId;
    private bool hasUsername;
    private string WeekRangeLabel => $"{displayedWeekStart.Day} {Loc.GetMonthName(displayedWeekStart.Month)} – {displayedWeekStart.AddDays(6).Day} {Loc.GetMonthName(displayedWeekStart.AddDays(6).Month)}";

    private int PlannedDays => selectedFriendWeek.Count(d => !string.IsNullOrEmpty(d.MealId));

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguage;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }

        uid = user.Uid;
        displayedWeekStart = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        catalog = (await CatalogService.GetAllMealsAsync()).GroupBy(meal => meal.Id).ToDictionary(g => g.Key, g => g.First());
        await LoadProfileAsync();
        isLoading = false;
    }

    private async Task LoadProfileAsync()
    {
        var profile = await UserService.GetProfileAsync(uid);
        hasUsername = !string.IsNullOrWhiteSpace(profile?.Username);
        incomingRequests = profile?.IncomingFriendRequests?.Values.OrderByDescending(request => request.SentAtUtc).ToList() ?? new();
        var friendIds = profile?.FriendIds?.Distinct(StringComparer.OrdinalIgnoreCase).ToList() ?? new();
        var profiles = await Task.WhenAll(friendIds.Select(UserService.GetProfileAsync));
        friends = profiles.Where(profile => profile is not null).Cast<UserProfile>().OrderBy(profile => profile.DisplayName).ToList();

        // People already friends, or with a request in-flight either way.
        alreadyConnected = new HashSet<string>(friendIds, StringComparer.OrdinalIgnoreCase);
        foreach (var incoming in profile?.IncomingFriendRequests?.Keys ?? Enumerable.Empty<string>())
            alreadyConnected.Add(incoming);
        foreach (var outgoing in profile?.OutgoingFriendRequestIds ?? new List<string>())
            alreadyConnected.Add(outgoing);

        var all = await UserService.GetRegisteredUsersAsync(uid);
        discoverable = all
            .Where(p => !alreadyConnected.Contains(p.Uid))
            .OrderBy(p => p.DisplayName)
            .ToList();

        if (selectedFriend is not null)
        {
            selectedFriend = friends.FirstOrDefault(friend => friend.Uid == selectedFriend.Uid);
            if (selectedFriend is not null) await LoadSelectedFriendWeekAsync();
        }
    }

    private async Task SendRequest()
    {
        if (!hasUsername) { isError = true; feedback = Loc["friends_need_username_short"]; return; }
        if (string.IsNullOrWhiteSpace(friendUsername)) return;
        isSendingRequest = true;
        feedback = "";
        try
        {
            await UserService.SendFriendRequestAsync(uid, friendUsername.Trim());
            friendUsername = "";
            isError = false;
            feedback = Loc["friends_request_sent"];
            await LoadProfileAsync();
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
        }
        finally { isSendingRequest = false; }
    }

    private async Task AddDiscovered(UserProfile user)
    {
        if (!hasUsername) { isError = true; feedback = Loc["friends_need_username_short"]; return; }
        isSendingRequest = true;
        feedback = "";
        try
        {
            await UserService.SendFriendRequestAsync(uid, user.Uid);
            isError = false;
            feedback = Loc.T("friends_request_sent_to", user.Username);
            await LoadProfileAsync();
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
        }
        finally { isSendingRequest = false; }
    }

    private async Task AcceptRequest(string senderUid)
    {
        if (!hasUsername) { isError = true; feedback = Loc["friends_need_username_short"]; return; }
        try
        {
            await UserService.AcceptFriendRequestAsync(uid, senderUid);
            isError = false;
            feedback = Loc["friends_now_friends"];
            await LoadProfileAsync();
        }
        catch (Exception ex) { isError = true; feedback = ex.Message; }
    }

    private async Task DeclineRequest(string senderUid)
    {
        try { await UserService.DeclineFriendRequestAsync(uid, senderUid); await LoadProfileAsync(); }
        catch (Exception ex) { isError = true; feedback = ex.Message; }
    }

    private async Task SelectFriend(UserProfile friend)
    {
        if (string.Equals(selectedFriend?.Uid, friend.Uid, StringComparison.OrdinalIgnoreCase))
        {
            selectedFriend = null;
            selectedFriendWeek.Clear();
            friendWeekRequestId++;
            isLoadingFriendWeek = false;
            return;
        }

        selectedFriend = friend;
        // Always start on the current week for a newly opened friend, rather than
        // silently keeping whatever week was last navigated to for a different friend.
        displayedWeekStart = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        await LoadSelectedFriendWeekAsync();
    }

    private async Task PreviousWeek() { displayedWeekStart = displayedWeekStart.AddDays(-7); await LoadSelectedFriendWeekAsync(); }
    private async Task NextWeek() { displayedWeekStart = displayedWeekStart.AddDays(7); await LoadSelectedFriendWeekAsync(); }
    private async Task LoadSelectedFriendWeekAsync()
    {
        if (selectedFriend is null) return;
        // Tag this fetch with a request id: if the user navigates again (or
        // picks a different friend) before this one resolves, its result must
        // not land after a newer request's, or the grid — and a sync started
        // from it — would silently use the wrong week's data.
        var requestId = ++friendWeekRequestId;
        var requestedWeekStart = displayedWeekStart;
        var requestedFriendUid = selectedFriend.Uid;
        isLoadingFriendWeek = true;
        try
        {
            var fetchedTask = UserService.GetWeeklyPlanAsync(requestedFriendUid, requestedWeekStart, requestedWeekStart.AddDays(6));
            var mineTask = UserService.GetWeeklyPlanAsync(uid, requestedWeekStart, requestedWeekStart.AddDays(6));
            var fetched = await fetchedTask;
            var mine = await mineTask;
            if (requestId != friendWeekRequestId) return;

            myWeek = mine.Where(entry => !string.IsNullOrEmpty(entry.MealId)).GroupBy(entry => entry.Date).ToDictionary(g => g.Key, g => g.First().MealId);

            selectedFriendWeek = Enumerable.Range(0, 7).Select(offset =>
            {
                var date = requestedWeekStart.AddDays(offset);
                return fetched.FirstOrDefault(entry => entry.Date == date) ?? new WeeklyPlanEntry { Date = date };
            }).ToList();
        }
        finally { if (requestId == friendWeekRequestId) isLoadingFriendWeek = false; }
    }

    private Task ReplaceWeek() => ApplyWeekAsync(selectedFriendWeek, "friends_sync_success");

    // Fills only the days I left empty and the friend has planned; the rest of my week is untouched.
    private async Task CopyEmptyDays()
    {
        var entries = selectedFriendWeek.Where(day => !string.IsNullOrEmpty(day.MealId) && !myWeek.ContainsKey(day.Date)).ToList();
        if (entries.Count == 0) { Toasts.Show(Loc["friends_nothing_to_copy"]); return; }
        await ApplyWeekAsync(entries, "friends_copy_empty_success");
    }

    private async Task ApplyWeekAsync(List<WeeklyPlanEntry> entries, string successKey)
    {
        if (selectedFriend is null || isLoadingFriendWeek) return;
        isSyncing = true;
        try
        {
            // For a full replace the list is hydrated to all 7 dates, so a day the friend left empty clears mine too.
            await UserService.SaveWeeklyPlanEntriesAsync(uid, entries);
            Toasts.Show(Loc.T(successKey, selectedFriend.DisplayName));
            await LoadSelectedFriendWeekAsync();
        }
        catch (Exception ex) { isError = true; feedback = ex.Message; }
        finally { isSyncing = false; }
    }

    private async Task CopyUsername()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", uid);
            Toasts.Show(Loc["friends_username_copied"]);
        }
        catch { isError = true; feedback = Loc["friends_copy_failed"]; }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SendRequest(); }
    private MealCatalogItem? MealFor(string? mealId) => !string.IsNullOrEmpty(mealId) && catalog.TryGetValue(mealId, out var meal) ? meal : null;
    private MealCatalogItem? MyMealFor(DateOnly date) => myWeek.TryGetValue(date, out var id) ? MealFor(id) : null;
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private void OnLanguage() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.OnLanguageChanged -= OnLanguage;
    private static DateOnly StartOfWeek(DateOnly date) => date.AddDays(-(7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7);
}
