@page "/"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IMealService MealService
@inject IMealCatalogService CatalogService
@inject IDayPlanService DayPlan
@inject INutritionStore NutritionStore
@inject IWeekFillService WeekFill
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject IMealImageService MealImages
@inject ToastService Toasts
@implements IAsyncDisposable

@* One day at a time: the day strip, the day's targets and its slots (the meals the user
   eats, sorted by their times). *@
<div class="mk-page mk-week" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <div class="mk-title-block">
                <h1 class="mk-title">@Loc.GetDayName(selectedDate)</h1>
                <span class="mk-subtitle">@Loc.T("nut_day_month", selectedDate.Day, Loc.GetMonthName(selectedDate.Month))@if (selectedDate == Today) { <text> · @Loc["nut_today"]</text> }</span>
            </div>
            <div class="mk-header-actions">
                <a class="mk-icon-btn mk-has-dot" href="friends" aria-label="@(friendRequests > 0 ? Loc.T("nut_friends_requests", friendRequests) : Loc["nut_friends"])">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c2.1.6 3.5 2.3 3.5 5.2"/></svg>
                    @if (friendRequests > 0) { <span class="mk-dot" aria-hidden="true"></span> }
                </a>
                <a class="mk-icon-btn" href="shopping" aria-label="@Loc["nut_shopping"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
                </a>
                <a class="mk-icon-btn" href="progress" aria-label="@Loc["nut_progress"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
                </a>
            </div>
        </div>

        <div class="mk-week-nav is-simple">
            <div class="mk-week-range">
                <span class="mk-week-range-text">@WeekRangeLabel</span>
                @if (weekOffset == 1) { <span class="mk-subtitle">@Loc["nut_next_week"]</span> }
            </div>
            <a class="mk-icon-btn is-plain is-muted" href="month" aria-label="@Loc["week_month_view"]">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
            </a>
        </div>

        <DayStrip Dates="WeekDates" Selected="selectedDate" Today="Today" Dots="dots" Logged="logged" OnSelect="SelectDay"
                  CanGoPrev="weekOffset == 1" CanGoNext="weekOffset == 0" OnPrev="() => GoToWeekAsync(0)" OnNext="() => GoToWeekAsync(1)" />
    </header>

    @if (isLoading)
    {
        <div class="mk-stack"><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (loadError)
    {
        <div class="mk-stack">
            <div class="mk-notice is-error" role="alert">@Loc["nut_load_error"]</div>
            <button class="mk-btn is-block" @onclick="ReloadAsync">@Loc["nut_retry"]</button>
        </div>
    }
    else
    {
        var totals = Totals;
        var now = TimeOnly.FromDateTime(DateTime.Now);
        <TargetsPanel Totals="totals" TrackMacros="prefs.TrackMacros">
            <FootContent>
                @if (totals.OpenProtein > 0 && DayMath.EmptySlots(SelectedDay, prefs).Count > 0)
                {
                    <a class="mk-ask" href="@($"ai-plan?ask=protein&day={selectedDate:yyyy-MM-dd}")">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>@Loc["nut_plan_day"]
                    </a>
                }
            </FootContent>
        </TargetsPanel>

        <div class="mk-stack mk-slots">
            @foreach (var slot in Slots)
            {
                var s = slot;
                var entry = SelectedDay?.Slots.GetValueOrDefault(s);
                <SlotCard Slot="s" Time="@TimeOf(s)" Entry="entry" Meal="MealFor(entry)"
                          AskEaten="DayStatus.NeedsCheckIn(entry, TimeOf(s), now, selectedDate == Today)"
                          OnOpen="() => openSlot = s"
                          OnAdd="() => OpenAddAsync(s, false)"
                          OnAnswer="ate => AnswerAsync(s, ate)" />
            }

            @if (EmptyUpcomingMeal1.Count > 0)
            {
                <button class="mk-btn is-pink is-block" @onclick="() => showSurpriseConfirm = true">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                    @Loc["week_surprise_week"]
                </button>
            }
        </div>
    }
</div>

<SlotSheet IsOpen="openSlot is not null"
           Slot="openSlot ?? MealSlot.Meal1"
           Time="@(openSlot is { } os ? TimeOf(os) : "")"
           Entry="@(openSlot is { } o ? SelectedDay?.Slots.GetValueOrDefault(o) : null)"
           Meal="@(openSlot is { } m ? MealFor(SelectedDay?.Slots.GetValueOrDefault(m)) : null)"
           ShowPrep="weekOffset == 0"
           OnServings="v => UpdateOpenAsync(e => e.Servings = v)"
           OnPrep="v => UpdateOpenAsync(e => e.PrepBatches = v)"
           OnLeftover="v => UpdateOpenAsync(e => { e.Leftover = v; if (v) e.PrepBatches = 1; })"
           OnRemove="RemoveOpenAsync"
           OnToggleEaten="ToggleOpenEatenAsync"
           OnChangeMeal="() => { if (openSlot is { } s) _ = OpenAddAsync(s, true); }"
           OnMove="() => OpenMoveAsync(false)"
           OnCopy="() => OpenMoveAsync(true)"
           OnMealSaved="StateHasChanged"
           OnDismiss="() => openSlot = null" />

@if (!isLoading && !loadError)
{
    <AddMealSheet IsOpen="addSlot is not null" Slot="addSlot ?? MealSlot.Meal1" Replacing="addReplacing" Totals="AddTotals"
                  Items="SuggestionsFor(addSlot)" RediscoverItem="RediscoverFor(addSlot)" Catalog="Candidates"
                  OnAdd="AddMealAsync"
                  OnBrowse="() => { if (addSlot is { } s) PickMeal(s, addReplacing); }"
                  OnQuickAdd="() => { quickSlot = addSlot; addSlot = null; }"
                  OnDismiss="() => addSlot = null" />

    <MoveMealSheet IsOpen="moveSlot is not null" Copying="moveCopying" MealName="@moveName"
                   FromDate="moveFromDate" FromSlot="moveSlot ?? MealSlot.Meal1" Today="Today"
                   Dates="TwoWeeks" Days="moveDays" Slots="Slots" SlotLabel="LabelOf"
                   NameOf="id => id is null ? null : catalog.GetValueOrDefault(id)?.Name"
                   IsLoading="moveLoading" LoadFailed="moveFailed" IsBusy="moveBusy"
                   OnPick="MoveToAsync" OnRetry="LoadMoveDaysAsync" OnDismiss="() => moveSlot = null" />
}

<QuickAddSheet IsOpen="quickSlot is not null" Slot="quickSlot ?? MealSlot.Meal1" OnAdd="AddQuickAsync" OnDismiss="() => quickSlot = null" />

<NxtBottomSheet IsOpen="showSurpriseConfirm" Title="@Loc["week_surprise_week"]" Eyebrow="@Loc["week_surprise_week_eyebrow"]" OnDismiss="() => showSurpriseConfirm = false">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <p class="mk-subtitle">@Loc["nut_surprise_meal1"] @Loc["week_surprise_week_note"]</p>
        <button class="mk-btn is-lg is-block" disabled="@isFilling" @onclick="SurpriseWeekAsync">@Loc["week_surprise_week"]</button>
    </div>
</NxtBottomSheet>

@code {
    private string uid = "";
    private bool isLoading = true;
    private bool loadError;
    private int weekOffset;
    private DateOnly selectedDate = Today;
    private Dictionary<DateOnly, PlanDay> days = new();
    private Dictionary<string, MealCatalogItem> catalog = new();
    private Dictionary<DateOnly, DayDot> dots = new();
    private NutritionProfile profile = new();
    private MealPrefs prefs = new();
    private int friendRequests;
    private MealSlot? openSlot;
    private MealSlot? quickSlot;
    private MealSlot? addSlot;
    private bool addReplacing;
    private Dictionary<DateOnly, PlanDay>? history;
    private HashSet<DateOnly> logged = new();
    private MealSlot? moveSlot;
    private DateOnly moveFromDate;
    private bool moveCopying, moveLoading, moveFailed, moveBusy;
    private string moveName = "";
    private Dictionary<DateOnly, PlanDay> moveDays = new();
    private bool showSurpriseConfirm;
    private bool isFilling;
    private bool onboardingDone;
    private DotNetObjectReference<WeekPage>? jsRef;
    private bool disposed;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly StartOfWeek(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private DateOnly WeekStart => StartOfWeek(Today).AddDays(7 * weekOffset);
    private IReadOnlyList<DateOnly> WeekDates => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i)).ToList();
    private string WeekRangeLabel => $"{WeekStart.Day} – {WeekStart.AddDays(6).Day} {Loc.GetMonthName(WeekStart.AddDays(6).Month)}";

    private PlanDay? SelectedDay => days.GetValueOrDefault(selectedDate);
    private IReadOnlyList<MealSlot> Slots => DayMath.SlotsFor(prefs);
    private DayTotals Totals => DayMath.Totals(SelectedDay, TargetCalculator.For(profile), NutritionFor, prefs);

    private List<DateOnly> EmptyUpcomingMeal1 => WeekDates
        .Where(d => d >= Today && !(days.GetValueOrDefault(d)?.Slots.ContainsKey(MealSlot.Meal1) ?? false))
        .ToList();

    private NutritionInfo? NutritionFor(string mealId) => catalog.GetValueOrDefault(mealId)?.Nutrition;
    private MealCatalogItem? MealFor(SlotEntry? entry) => entry?.MealId is { } id ? catalog.GetValueOrDefault(id) : null;
    private string TimeOf(MealSlot slot) => prefs.TimeOf(slot);
    private string LabelOf(MealSlot slot) => Loc.T("nut_slot_time", Loc["nut_slot_" + slot], TimeOf(slot));
    private IReadOnlyList<DateOnly> TwoWeeks => Enumerable.Range(0, 14).Select(i => StartOfWeek(Today).AddDays(i)).ToList();

    // When a meal is being changed, the budget shown in the sheet is the day without that meal.
    private DayTotals AddTotals
    {
        get
        {
            if (!addReplacing || addSlot is not { } slot || SelectedDay is not { } day || !day.Slots.ContainsKey(slot)) return Totals;
            var without = new PlanDay { Date = day.Date, Slots = day.Slots.Where(kv => kv.Key != slot).ToDictionary(kv => kv.Key, kv => kv.Value) };
            return DayMath.Totals(without, TargetCalculator.For(profile), NutritionFor, prefs);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        // ?day=yyyy-MM-dd (back from choosing a meal) opens that day; only this and next week are shown.
        if (QueryValue("day") is { } dayText && DateOnly.TryParse(dayText, out var requested))
        {
            var offset = (StartOfWeek(requested).DayNumber - StartOfWeek(Today).DayNumber) / 7;
            if (offset is 0 or 1) { weekOffset = offset; selectedDate = requested; }
        }
        if (QueryValue("toast") is { } toast) Toasts.Show(toast);

        try
        {
            await MealService.SeedAsync(new List<Meal>());
            var userProfile = await UserService.GetProfileAsync(uid);
            onboardingDone = userProfile?.FirstWeekAutoFilled ?? false;
            friendRequests = userProfile?.IncomingFriendRequests?.Count ?? 0;
        }
        catch { /* offline: the week still loads below or shows its error */ }

        await LoadAsync();

        // A brand-new user (never onboarded, nothing planned) chooses how to start.
        if (!loadError && !onboardingDone && days.Count == 0 && !await SafeHasLegacyPlanAsync())
        {
            Nav.NavigateTo("/setup", replace: true);
            return;
        }

        jsRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeAsync<bool>("nxtweek.emailAuth.subscribeToUser", uid, jsRef); } catch { /* Firebase sync is optional */ }
    }

    private async Task<bool> SafeHasLegacyPlanAsync()
    {
        try { return await UserService.HasAnyPlanEntryAsync(uid); } catch { return true; }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = false;
        try
        {
            var profileTask = NutritionStore.GetProfileAsync(uid);
            var prefsTask = NutritionStore.GetMealPrefsAsync(uid);
            var daysTask = DayPlan.GetDaysAsync(uid, WeekStart, WeekStart.AddDays(6));
            var catalogTask = CatalogService.GetAllMealsAsync();
            await Task.WhenAll(profileTask, prefsTask, daysTask, catalogTask, MealImages.EnsureLoadedAsync());
            profile = await profileTask ?? new NutritionProfile();
            prefs = await prefsTask;
            days = await daysTask;
            catalog = (await catalogTask).ToDictionary(m => m.Id);
            if (!WeekDates.Contains(selectedDate)) selectedDate = weekOffset == 0 ? Today : WeekStart;
            RefreshDots();
        }
        catch
        {
            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private void RefreshDots()
    {
        dots = WeekDates.ToDictionary(d => d, d => DayStatus.DotFor(days.GetValueOrDefault(d), prefs));
        logged = WeekDates.Where(d => DayStatus.DayLogged(days.GetValueOrDefault(d), prefs)).ToHashSet();
    }

    private async Task GoToWeekAsync(int offset)
    {
        if (offset == weekOffset) return;
        weekOffset = offset;
        selectedDate = offset == 0 ? Today : WeekStart;
        await LoadAsync();
    }

    private void SelectDay(DateOnly date) => selectedDate = date;

    // Every change is shown at once and saved in the background; a failed save reloads the truth.
    private async Task SaveAsync(Func<Task<PlanDay>> write, string? toast = null)
    {
        try
        {
            var saved = await write();
            days[saved.Date] = saved;
            RefreshDots();
            if (toast is not null) Toasts.Show(toast);
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, isError: true);
            await LoadAsync();
        }
    }

    // "Did you eat this?" Yes = eaten, No = skipped. A skipped meal is counted nowhere.
    private Task AnswerAsync(MealSlot slot, bool ate)
    {
        var date = selectedDate;
        void Apply(SlotEntry e) { e.Eaten = ate; e.Skipped = !ate; }
        if (SelectedDay?.Slots.GetValueOrDefault(slot) is { } local) Apply(local);
        return SaveAsync(() => DayPlan.UpdateEntryAsync(uid, date, slot, Apply), ate ? Loc["nut_eaten_toast"] : Loc["nut_skipped_toast"]);
    }

    // From the sheet: mark as eaten, or undo an earlier answer (eaten or skipped) back to planned.
    private Task ToggleEatenAsync(MealSlot slot)
    {
        var date = selectedDate;
        var entry = SelectedDay?.Slots.GetValueOrDefault(slot);
        var answered = entry is { Eaten: true } or { Skipped: true };
        void Apply(SlotEntry e) { e.Eaten = !answered; e.Skipped = false; }
        if (entry is not null) Apply(entry);
        return SaveAsync(() => DayPlan.UpdateEntryAsync(uid, date, slot, Apply), answered ? null : Loc["nut_eaten_toast"]);
    }

    private Task UpdateOpenAsync(Action<SlotEntry> change)
    {
        if (openSlot is not { } slot) return Task.CompletedTask;
        var date = selectedDate;
        if (SelectedDay?.Slots.GetValueOrDefault(slot) is { } local) change(local);
        return SaveAsync(() => DayPlan.UpdateEntryAsync(uid, date, slot, change));
    }

    private async Task ToggleOpenEatenAsync()
    {
        if (openSlot is not { } slot) return;
        openSlot = null;
        await ToggleEatenAsync(slot);
    }

    private async Task RemoveOpenAsync()
    {
        if (openSlot is not { } slot) return;
        var date = selectedDate;
        openSlot = null;
        SelectedDay?.Slots.Remove(slot);
        await SaveAsync(() => DayPlan.RemoveEntryAsync(uid, date, slot), Loc["nut_removed_toast"]);
    }

    private async Task AddQuickAsync(SlotEntry entry)
    {
        if (quickSlot is not { } slot) return;
        var date = selectedDate;
        quickSlot = null;
        await SaveAsync(() => DayPlan.SetEntryAsync(uid, date, slot, entry), Loc.T("nut_added_toast", Loc["nut_slot_" + slot]));
    }

    // Suggestions come from meals in the app language (all meals if that language has none).
    private IEnumerable<MealCatalogItem> Candidates
    {
        get
        {
            var live = catalog.Values.Where(m => !m.IsArchived).ToList();
            var inLanguage = live.Where(m => string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, Loc.CurrentLanguage, StringComparison.OrdinalIgnoreCase)).ToList();
            return inLanguage.Count > 0 ? inLanguage : live;
        }
    }

    private IReadOnlyList<Suggestion> SuggestionsFor(MealSlot? slot)
    {
        if (slot is not { } s) return [];
        var totals = AddTotals;
        var empty = DayMath.EmptySlots(SelectedDay, prefs).Count + (addReplacing ? 1 : 0);
        return Suggestions.ForSlot(s, totals.OpenKcal, empty, UsedToday(s), Candidates);
    }

    private Suggestion? RediscoverFor(MealSlot? slot)
    {
        if (slot is not { } s || history is null) return null;
        var shown = SuggestionsFor(slot).Select(x => x.Meal.Id).ToHashSet();
        return Suggestions.Rediscover(s, AddTotals.OpenKcal, UsedToday(s), Candidates, history, Today, shown);
    }

    // Meals already on the day, except the one being changed.
    private HashSet<string> UsedToday(MealSlot adding) =>
        Suggestions.UsedMealIds(SelectedDay, addReplacing ? Slots.Where(x => x != adding).ToList() : Slots);

    private async Task OpenAddAsync(MealSlot slot, bool replacing)
    {
        openSlot = null;
        addReplacing = replacing;
        addSlot = slot;
        if (history is not null) return;
        // "Rediscover" needs what was eaten before; loaded once, and the sheet works without it.
        try { history = await DayPlan.GetDaysAsync(uid, Today.AddDays(-120), Today.AddDays(-1)); }
        catch { history = new(); }
    }

    private async Task AddMealAsync(MealCatalogItem meal)
    {
        if (addSlot is not { } slot) return;
        var date = selectedDate;
        addSlot = null;
        await SaveAsync(() => DayPlan.SetEntryAsync(uid, date, slot, new SlotEntry { MealId = meal.Id }), Loc.T("nut_added_toast", Loc["nut_slot_" + slot]));
    }

    private async Task OpenMoveAsync(bool copying)
    {
        if (openSlot is not { } slot || SelectedDay?.Slots.GetValueOrDefault(slot) is not { } entry) return;
        moveName = entry.Quick?.Name ?? MealFor(entry)?.Name ?? "";
        moveFromDate = selectedDate;
        moveCopying = copying;
        openSlot = null;
        moveSlot = slot;
        await LoadMoveDaysAsync();
    }

    // The picker shows what is already planned in both weeks, so a swap or a replacement is never a surprise.
    private async Task LoadMoveDaysAsync()
    {
        moveLoading = true;
        moveFailed = false;
        try { moveDays = await DayPlan.GetDaysAsync(uid, TwoWeeks[0], TwoWeeks[^1]); }
        catch { moveFailed = true; }
        finally { moveLoading = false; }
    }

    private async Task MoveToAsync((DateOnly Date, MealSlot Slot) target)
    {
        if (moveSlot is not { } fromSlot || moveBusy) return;
        moveBusy = true;
        try
        {
            var changed = moveCopying
                ? (await DayPlan.CopyEntryAsync(uid, moveFromDate, fromSlot, target.Date, target.Slot) is { } copy ? new List<PlanDay> { copy } : [])
                : await DayPlan.MoveEntryAsync(uid, moveFromDate, fromSlot, target.Date, target.Slot);
            foreach (var day in changed)
                if (WeekDates.Contains(day.Date)) days[day.Date] = day;
            RefreshDots();
            moveSlot = null;
            var where = Loc.T("nut_slot_on_day", Loc["nut_slot_" + target.Slot], Loc.GetDayName(target.Date.DayOfWeek));
            Toasts.Show(Loc.T(moveCopying ? "nut_copied_toast" : "nut_moved_toast", where));
        }
        catch
        {
            Toasts.Show(Loc["nut_save_error"], isError: true);
            await LoadAsync();
        }
        finally { moveBusy = false; }
    }

    private void PickMeal(MealSlot slot, bool replace)
    {
        openSlot = null;
        addSlot = null;
        Nav.NavigateTo($"/meals?day={selectedDate:yyyy-MM-dd}&slot={slot}{(replace ? "&replace=1" : "")}");
    }

    private async Task SurpriseWeekAsync()
    {
        isFilling = true;
        try
        {
            await WeekFill.FillEmptyMeal1Async(uid, EmptyUpcomingMeal1, days);
            showSurpriseConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Show(ex.Message, isError: true); }
        finally { isFilling = false; }
    }

    private string? QueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals(key, StringComparison.OrdinalIgnoreCase)) return Uri.UnescapeDataString(kv[1]);
        }
        return null;
    }

    [JSInvokable]
    public async Task OnRemoteUserChanged()
    {
        if (disposed || isLoading) return;
        await InvokeAsync(async () =>
        {
            try
            {
                days = await DayPlan.GetDaysAsync(uid, WeekStart, WeekStart.AddDays(6));
                RefreshDots();
                StateHasChanged();
            }
            catch { /* keep what is shown */ }
        });
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        disposed = true;
        try { await JS.InvokeVoidAsync("nxtweek.emailAuth.unsubscribe"); } catch { }
        jsRef?.Dispose();
    }
}
