@page "/"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IMealService MealService
@inject IMealCatalogService CatalogService
@inject IDayPlanService DayPlan
@inject INutritionStore NutritionStore
@inject IWeekFillService WeekFill
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject IMealImageService MealImages
@inject ToastService Toasts
@implements IAsyncDisposable

@* One day at a time: the day strip, the day's targets and its slots (Meal 1, post-workout on
   training days, dinner, evening snack). *@
<div class="mk-page mk-week" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <div class="mk-title-block">
                <h1 class="mk-title">@Loc.GetDayName(selectedDate)</h1>
                <span class="mk-subtitle">@Loc.T("nut_day_month", selectedDate.Day, Loc.GetMonthName(selectedDate.Month))@if (selectedDate == Today) { <text> · @Loc["nut_today"]</text> }</span>
            </div>
            <div class="mk-header-actions">
                <a class="mk-icon-btn" href="shopping" aria-label="@Loc["nut_shopping"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
                </a>
                <a class="mk-icon-btn" href="progress" aria-label="@Loc["nut_progress"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
                </a>
                <a class="mk-icon-btn is-pink" href="ai-plan" aria-label="@Loc["nut_assistant"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>
                </a>
            </div>
        </div>

        <div class="mk-week-nav">
            <button class="mk-icon-btn is-plain" aria-label="@Loc["week_prev"]" disabled="@(weekOffset == 0)" @onclick="() => GoToWeekAsync(0)">
                <svg class="i mk-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <div class="mk-week-range">
                <span class="mk-week-range-text">@WeekRangeLabel</span>
                @if (weekOffset == 1) { <span class="mk-subtitle">@Loc["nut_next_week"]</span> }
            </div>
            <div class="mk-week-nav-end">
                <a class="mk-icon-btn is-plain is-muted" href="month" aria-label="@Loc["week_month_view"]">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
                </a>
                <button class="mk-icon-btn is-plain" aria-label="@Loc["week_next"]" disabled="@(weekOffset == 1)" @onclick="() => GoToWeekAsync(1)">
                    <svg class="i mk-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                </button>
            </div>
        </div>

        <DayStrip Dates="WeekDates" Selected="selectedDate" Today="Today" Dots="dots" OnSelect="SelectDay" />
    </header>

    @if (isLoading)
    {
        <div class="mk-stack"><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (loadError)
    {
        <div class="mk-stack">
            <div class="mk-notice is-error" role="alert">@Loc["nut_load_error"]</div>
            <button class="mk-btn is-block" @onclick="ReloadAsync">@Loc["nut_retry"]</button>
        </div>
    }
    else
    {
        var totals = Totals;
        <div class="mk-tp-sticky @(compact ? "is-visible" : "")" aria-hidden="@(compact ? "false" : "true")">
            <TargetsPanel Totals="totals" Type="SelectedType" Compact="true" />
        </div>
        <div id="mk-targets-panel">
            <TargetsPanel Totals="totals" Type="SelectedType" OnToggleType="ToggleDayTypeAsync" />
        </div>

        <div class="mk-stack mk-slots">
            @if (SelectedDay is not { Slots.Count: > 0 } || Slots.All(s => !SelectedDay.Slots.ContainsKey(s)))
            {
                <div class="mk-note">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                    <span><b>@Loc["nut_empty_day"]</b><br />@Loc["nut_week_empty"]</span>
                </div>
            }

            @foreach (var slot in Slots)
            {
                var s = slot;
                var entry = SelectedDay?.Slots.GetValueOrDefault(s);
                <SlotCard Slot="s" Time="@TimeOf(s)" Entry="entry" Meal="MealFor(entry)"
                          OpenKcal="totals.OpenKcal" OpenProtein="totals.OpenProtein"
                          OnOpen="() => openSlot = s"
                          OnToggleEaten="() => ToggleEatenAsync(s)"
                          OnQuickAdd="() => quickSlot = s"
                          OnAddMeal="() => PickMeal(s, false)" />
            }

            @if (SelectedType == DayType.Rest)
            {
                <p class="mk-slot-footnote">@Loc["nut_no_post"]</p>
            }

            <div class="mk-card mk-gauge-card">
                <div class="mk-gauge-row"><ProteinGauge Protein="35" /><b>@Loc["nut_aim"]</b></div>
                <div class="mk-legend">
                    <span><i style="background:var(--mk-warn)"></i>@Loc["nut_gauge_legend_low"]</span>
                    <span><i style="background:var(--mk-ok)"></i>@Loc["nut_gauge_legend_aim"]</span>
                    <span><i style="background:var(--mk-pro)"></i>@Loc["nut_gauge_legend_high"]</span>
                </div>
            </div>

            @if (EmptyUpcomingMeal1.Count > 0)
            {
                <button class="mk-btn is-pink is-block" @onclick="() => showSurpriseConfirm = true">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                    @Loc["week_surprise_week"]
                </button>
            }
        </div>
    }
</div>

<SlotSheet IsOpen="openSlot is not null"
           Slot="openSlot ?? MealSlot.Meal1"
           Time="@(openSlot is { } os ? TimeOf(os) : "")"
           Entry="@(openSlot is { } o ? SelectedDay?.Slots.GetValueOrDefault(o) : null)"
           Meal="@(openSlot is { } m ? MealFor(SelectedDay?.Slots.GetValueOrDefault(m)) : null)"
           ShowPrep="weekOffset == 0"
           OnServings="v => UpdateOpenAsync(e => e.Servings = v)"
           OnPrep="v => UpdateOpenAsync(e => e.PrepBatches = v)"
           OnLeftover="v => UpdateOpenAsync(e => { e.Leftover = v; if (v) e.PrepBatches = 1; })"
           OnRemove="RemoveOpenAsync"
           OnToggleEaten="ToggleOpenEatenAsync"
           OnChangeMeal="() => { if (openSlot is { } s) PickMeal(s, true); }"
           OnMealSaved="StateHasChanged"
           OnDismiss="() => openSlot = null" />

<QuickAddSheet IsOpen="quickSlot is not null" Slot="quickSlot ?? MealSlot.Meal1" OnAdd="AddQuickAsync" OnDismiss="() => quickSlot = null" />

<NxtBottomSheet IsOpen="showSurpriseConfirm" Title="@Loc["week_surprise_week"]" Eyebrow="@Loc["week_surprise_week_eyebrow"]" OnDismiss="() => showSurpriseConfirm = false">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <p class="mk-subtitle">@Loc["nut_surprise_meal1"] @Loc["week_surprise_week_note"]</p>
        <button class="mk-btn is-lg is-block" disabled="@isFilling" @onclick="SurpriseWeekAsync">@Loc["week_surprise_week"]</button>
    </div>
</NxtBottomSheet>

@code {
    private string uid = "";
    private bool isLoading = true;
    private bool loadError;
    private bool compact;
    private int weekOffset;
    private DateOnly selectedDate = Today;
    private Dictionary<DateOnly, PlanDay> days = new();
    private Dictionary<string, MealCatalogItem> catalog = new();
    private Dictionary<DateOnly, DayDot> dots = new();
    private NutritionProfile profile = new();
    private MealSlot? openSlot;
    private MealSlot? quickSlot;
    private bool showSurpriseConfirm;
    private bool isFilling;
    private bool onboardingDone;
    private DotNetObjectReference<WeekPage>? jsRef;
    private bool observing;
    private int observerId;
    private bool disposed;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly StartOfWeek(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private DateOnly WeekStart => StartOfWeek(Today).AddDays(7 * weekOffset);
    private IReadOnlyList<DateOnly> WeekDates => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i)).ToList();
    private string WeekRangeLabel => $"{WeekStart.Day} – {WeekStart.AddDays(6).Day} {Loc.GetMonthName(WeekStart.AddDays(6).Month)}";

    private PlanDay? SelectedDay => days.GetValueOrDefault(selectedDate);
    private DayType SelectedType => DayMath.TypeOf(SelectedDay, selectedDate, profile);
    private IReadOnlyList<MealSlot> Slots => DayMath.SlotsFor(SelectedType, profile.MealTimes);
    private DayTotals Totals => DayMath.Totals(SelectedDay, SelectedType, TargetCalculator.For(profile, SelectedType), NutritionFor, profile.MealTimes);

    private List<DateOnly> EmptyUpcomingMeal1 => WeekDates
        .Where(d => d >= Today && !(days.GetValueOrDefault(d)?.Slots.ContainsKey(MealSlot.Meal1) ?? false))
        .ToList();

    private NutritionInfo? NutritionFor(string mealId) => catalog.GetValueOrDefault(mealId)?.Nutrition;
    private MealCatalogItem? MealFor(SlotEntry? entry) => entry?.MealId is { } id ? catalog.GetValueOrDefault(id) : null;
    private string TimeOf(MealSlot slot) => profile.MealTimes.GetValueOrDefault(slot, "");

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        // ?day=yyyy-MM-dd (back from choosing a meal) opens that day; only this and next week are shown.
        if (QueryValue("day") is { } dayText && DateOnly.TryParse(dayText, out var requested))
        {
            var offset = (StartOfWeek(requested).DayNumber - StartOfWeek(Today).DayNumber) / 7;
            if (offset is 0 or 1) { weekOffset = offset; selectedDate = requested; }
        }
        if (QueryValue("toast") is { } toast) Toasts.Show(toast);

        try
        {
            await MealService.SeedAsync(new List<Meal>());
            var userProfile = await UserService.GetProfileAsync(uid);
            onboardingDone = userProfile?.FirstWeekAutoFilled ?? false;
        }
        catch { /* offline: the week still loads below or shows its error */ }

        await LoadAsync();

        // A brand-new user (never onboarded, nothing planned) chooses how to start.
        if (!loadError && !onboardingDone && days.Count == 0 && !await SafeHasLegacyPlanAsync())
        {
            Nav.NavigateTo("/welcome", replace: true);
            return;
        }

        jsRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeAsync<bool>("nxtweek.emailAuth.subscribeToUser", uid, jsRef); } catch { /* Firebase sync is optional */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (observing || isLoading || loadError || jsRef is null) return;
        observing = true;
        // The panel is re-created after every load, so the previous observer would watch a detached element.
        try { if (observerId != 0) await JS.InvokeVoidAsync("nxtweek.unobserveCompact", observerId); } catch { }
        try { observerId = await JS.InvokeAsync<int>("nxtweek.observeCompact", "mk-targets-panel", jsRef); } catch { }
    }

    private async Task<bool> SafeHasLegacyPlanAsync()
    {
        try { return await UserService.HasAnyPlanEntryAsync(uid); } catch { return true; }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        observing = false;
        compact = false;
        loadError = false;
        try
        {
            var profileTask = NutritionStore.GetProfileAsync(uid);
            var daysTask = DayPlan.GetDaysAsync(uid, WeekStart, WeekStart.AddDays(6));
            var catalogTask = CatalogService.GetAllMealsAsync();
            await Task.WhenAll(profileTask, daysTask, catalogTask, MealImages.EnsureLoadedAsync());
            profile = await profileTask ?? new NutritionProfile();
            days = await daysTask;
            catalog = (await catalogTask).ToDictionary(m => m.Id);
            if (!WeekDates.Contains(selectedDate)) selectedDate = weekOffset == 0 ? Today : WeekStart;
            RefreshDots();
        }
        catch
        {
            loadError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private void RefreshDots() =>
        dots = WeekDates.ToDictionary(d => d, d => DayStatus.DotFor(days.GetValueOrDefault(d), DayMath.TypeOf(days.GetValueOrDefault(d), d, profile), profile.MealTimes));

    private async Task GoToWeekAsync(int offset)
    {
        if (offset == weekOffset) return;
        weekOffset = offset;
        selectedDate = offset == 0 ? Today : WeekStart;
        await LoadAsync();
    }

    private void SelectDay(DateOnly date) => selectedDate = date;

    // Every change is shown at once and saved in the background; a failed save reloads the truth.
    private async Task SaveAsync(Func<Task<PlanDay>> write, string? toast = null)
    {
        try
        {
            var saved = await write();
            days[saved.Date] = saved;
            RefreshDots();
            if (toast is not null) Toasts.Show(toast);
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, isError: true);
            await LoadAsync();
        }
    }

    private Task ToggleEatenAsync(MealSlot slot)
    {
        var date = selectedDate;
        var nowEaten = !(SelectedDay?.Slots.GetValueOrDefault(slot)?.Eaten ?? false);
        if (SelectedDay?.Slots.GetValueOrDefault(slot) is { } local) local.Eaten = nowEaten;
        return SaveAsync(() => DayPlan.UpdateEntryAsync(uid, date, slot, e => e.Eaten = nowEaten), nowEaten ? Loc["nut_eaten_toast"] : null);
    }

    private Task UpdateOpenAsync(Action<SlotEntry> change)
    {
        if (openSlot is not { } slot) return Task.CompletedTask;
        var date = selectedDate;
        if (SelectedDay?.Slots.GetValueOrDefault(slot) is { } local) change(local);
        return SaveAsync(() => DayPlan.UpdateEntryAsync(uid, date, slot, change));
    }

    private async Task ToggleOpenEatenAsync()
    {
        if (openSlot is not { } slot) return;
        openSlot = null;
        await ToggleEatenAsync(slot);
    }

    private async Task RemoveOpenAsync()
    {
        if (openSlot is not { } slot) return;
        var date = selectedDate;
        openSlot = null;
        SelectedDay?.Slots.Remove(slot);
        await SaveAsync(() => DayPlan.RemoveEntryAsync(uid, date, slot), Loc["nut_removed_toast"]);
    }

    private async Task AddQuickAsync(SlotEntry entry)
    {
        if (quickSlot is not { } slot) return;
        var date = selectedDate;
        quickSlot = null;
        await SaveAsync(() => DayPlan.SetEntryAsync(uid, date, slot, entry), Loc.T("nut_added_toast", Loc["nut_slot_" + slot]));
    }

    private Task ToggleDayTypeAsync()
    {
        var date = selectedDate;
        var next = SelectedType == DayType.Training ? DayType.Rest : DayType.Training;
        var day = days.TryGetValue(date, out var existing) ? existing : days[date] = new PlanDay { Date = date };
        day.Type = next;
        return SaveAsync(() => DayPlan.SetDayTypeAsync(uid, date, next));
    }

    private void PickMeal(MealSlot slot, bool replace)
    {
        openSlot = null;
        Nav.NavigateTo($"/meals?day={selectedDate:yyyy-MM-dd}&slot={slot}{(replace ? "&replace=1" : "")}");
    }

    private async Task SurpriseWeekAsync()
    {
        isFilling = true;
        try
        {
            await WeekFill.FillEmptyMeal1Async(uid, EmptyUpcomingMeal1, days);
            showSurpriseConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex) { Toasts.Show(ex.Message, isError: true); }
        finally { isFilling = false; }
    }

    private string? QueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals(key, StringComparison.OrdinalIgnoreCase)) return Uri.UnescapeDataString(kv[1]);
        }
        return null;
    }

    [JSInvokable]
    public void SetCompact(bool value)
    {
        if (compact == value || disposed) return;
        compact = value;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnRemoteUserChanged()
    {
        if (disposed || isLoading) return;
        await InvokeAsync(async () =>
        {
            try
            {
                days = await DayPlan.GetDaysAsync(uid, WeekStart, WeekStart.AddDays(6));
                RefreshDots();
                StateHasChanged();
            }
            catch { /* keep what is shown */ }
        });
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        disposed = true;
        try { await JS.InvokeVoidAsync("nxtweek.unobserveCompact", observerId); } catch { }
        try { await JS.InvokeVoidAsync("nxtweek.emailAuth.unsubscribe"); } catch { }
        jsRef?.Dispose();
    }
}
