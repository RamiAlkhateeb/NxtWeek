@page "/"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IMealService MealService
@inject IMealCacheService CacheService
@inject IMealCatalogService CatalogService
@inject ISuggestionService SuggestionService
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Loc
@implements IAsyncDisposable

<div class="app app-content-wrapper" dir="@Loc.Direction">
    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <div class="toast-message" role="status">✅ @toastMessage</div>
    }
    <div class="week-page-header">
        <button class="week-header-action week-profile-link" title="@Loc["settings_title"]" aria-label="@Loc["settings_title"]" @onclick='() => Nav.NavigateTo("/settings")'><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.8 20c.7-4 3-6 6.2-6s5.5 2 6.2 6"/></svg>@if (showProfileNudge) { <span class="profile-nudge-dot" aria-label="@Loc["week_nudge_prompt"]"></span> }</button>
        <button class="week-header-action week-share-link" title="@(Loc.IsArabic ? "شارك أسبوعك" : "Share Week")" aria-label="@(Loc.IsArabic ? "شارك أسبوعك" : "Share Week")" aria-busy="@isSharing" @onclick="ShareWeek" disabled="@isSharing">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.6M8.2 13.2l7.6 4.6"/></svg>
        </button>
        <h1>@(Loc.IsArabic ? "مكدوس" : "NxtWeek")</h1>
        <p>@WeekRangeLabel</p>
        <div class="week-nav week-nav-wide">
            <button @onclick="GoPreviousWeek">‹ @Loc["week_prev"]</button>
            <button @onclick="GoNextWeek">@Loc["week_next"] ›</button>
        </div>
        <button class="week-surprise" @onclick="() => showWeekSurpriseConfirm = true"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01M12 12h.01"/></svg>@(Loc.IsArabic ? "فاجئني بالأسبوع" : "Surprise My Week")</button>
    </div>

    @if (isLoading)
    {
        <p class="loading-text">@(Loc.IsArabic ? "جارِ التحميل..." : "Loading...")</p>
    }
    else
    {
        <div id="week-share-capture" class="week-cards">
            @foreach (var meal in weekMeals)
            {
                var isPast = meal.Date < DateOnly.FromDateTime(DateTime.Today);
                
                @if (string.IsNullOrWhiteSpace(meal.MealId))
                {
                    <button class="week-meal-card week-empty-card @(isPast ? "week-card-past" : "") @(navigatingDate == meal.Date ? "day-selected" : "")" @onclick="() => SuggestEmpty(meal)">
                        <span class="week-card-date">@DayDateLabel(meal.Date)</span>
                        <span class="week-empty-copy"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01M12 12h.01"/></svg>@(Loc.IsArabic ? "فاجئني" : "Surprise Me")</span>
                    </button>
                }
                else
                {
                    <article @key="MealRenderKey(meal)" id="@($"day-{meal.Date:yyyy-MM-dd}")" class="week-meal-card @(string.IsNullOrWhiteSpace(meal.PhotoUrl) ? "" : "has-photo") @(isPast ? "week-card-past" : "") @(animatedDate == meal.Date ? "meal-changed" : "") @(navigatingDate == meal.Date ? "day-selected" : "")" style="@(string.IsNullOrWhiteSpace(meal.PhotoUrl) ? "" : $"background-image: url('{meal.PhotoUrl}');")" @onclick="() => OpenActions(meal)">
                        <div class="week-card-topline">
                            <span class="week-card-date">@DayDateLabel(meal.Date)</span>
                            @if (meal.IsFavorite)
                            {
                                <span class="meal-card-badge favorite">⭐ @(Loc.IsArabic ? "مفضلة" : "Favorite")</span>
                            }
                        </div>
                        <div class="week-card-name"><span aria-hidden="true">@TypeIcon(meal.MealType)</span> @meal.Name</div>
                        <div class="meal-card-actions compact-actions">
                            <button title="@(Loc.IsArabic ? "تعديل الوجبة" : "Edit Meal")" aria-label="@(Loc.IsArabic ? "تعديل الوجبة" : "Edit Meal")" @onclick="() => OpenActions(meal)" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg>
                            </button>
                            <button title="@(Loc.IsArabic ? "فاجئني باقتراح" : "Suggest Meal")" aria-label="@(Loc.IsArabic ? "فاجئني باقتراح" : "Suggest Meal")" @onclick="() => SuggestNew(meal)" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01M12 12h.01"/></svg>
                            </button>
                            <button class="@(meal.IsFavorite ? "liked" : "")" title="@(Loc.IsArabic ? "المفضلة" : "Favorite")" aria-label="@(Loc.IsArabic ? "المفضلة" : "Favorite")" @onclick="() => ToggleFavorite(meal)" @onclick:stopPropagation="true">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/></svg>
                            </button>
                        </div>
                    </article>
                }
            }
        </div>
    }
</div>

<UiBottomSheet IsOpen="@(selectedMeal is not null)"
               Eyebrow="@(selectedMeal is null ? null : DayDateLabel(selectedMeal.Date))"
               Title="@(selectedMeal is null || string.IsNullOrWhiteSpace(selectedMeal.MealId) ? (Loc.IsArabic ? "اختاري وجبة" : "Choose Meal") : selectedMeal.Name)"
               OnDismiss="CloseActions">
    @if (selectedMeal is not null)
    {
            @if (showQuickPicker)
            {
                <div class="quick-picker" dir="@Loc.Direction">
                    @foreach (var item in catalogMeals.Take(8))
                    {
                        <button @onclick="() => ChooseMeal(item)"><span>@item.Name</span></button>
                    }
                </div>
            }
            else if (showMoveDays)
            {
                <div class="move-days" dir="@Loc.Direction">
                    @foreach (var day in weekMeals.Where(x => x.Date != selectedMeal.Date))
                    { <button @onclick="() => MoveTo(day.Date)">@DayDateLabel(day.Date)</button> }
                </div>
            }
            else
            {
                <div class="sheet-actions" dir="@Loc.Direction">
                    <button @onclick="() => OpenMealPicker(selectedMeal.Date)">🍽️ @(Loc.IsArabic ? "تغيير الوجبة" : "Change Meal")</button>
                    <button @onclick="SuggestFromSheet">🎲 @(Loc.IsArabic ? "فاجئني" : "Surprise Me")</button>
                    <button @onclick="() => showMoveDays = true">↔️ @(Loc.IsArabic ? "نقل ليوم آخر" : "Move to another day")</button>
                    @if (!string.IsNullOrWhiteSpace(selectedMeal.MealId))
                    { <button class="danger" @onclick="DeleteSelected">🗑️ @(Loc.IsArabic ? "حذف من اليوم" : "Remove from day")</button> }
                </div>
            }
    }
</UiBottomSheet>

<UiBottomSheet IsOpen="showWeekSurpriseConfirm" Title="@(Loc.IsArabic ? "فاجئني بالأسبوع" : "Surprise My Week")" Eyebrow="@(Loc.IsArabic ? "سنملأ الأيام الفارغة فقط" : "We'll only fill empty days")" OnDismiss="() => showWeekSurpriseConfirm = false">
    <div class="sheet-actions" dir="@Loc.Direction">
        <p>@(Loc.IsArabic ? "لن يتم تغيير أي وجبة مخططة مسبقاً." : "No planned meals will be replaced.")</p>
        <UiButton Variant="primary" OnClick="SurpriseWeek">@(Loc.IsArabic ? "تأكيد" : "Confirm")</UiButton>
    </div>
</UiBottomSheet>

@code {
    private List<Meal> weekMeals = new();
    private DateOnly currentWeekStart;
    private bool isLoading = true;
    private string uid = "";
    private List<MealCatalogItem> catalogMeals = new();
    private Meal? selectedMeal;
    private bool showQuickPicker;
    private bool showMoveDays;
    private DateOnly? animatedDate;
    private int flipSequence;
    private DateOnly? navigatingDate;
    private string toastMessage = "";
    private bool showWeekSurpriseConfirm;
    private bool isSharing;
    private bool showProfileNudge;
    private bool userHasUsername;
    private bool profileFirstWeekFilled;
    private DotNetObjectReference<WeekPage>? remoteListener;
    private bool disposed;

    private string WeekRangeLabel => $"{DayDateLabel(currentWeekStart)} – {DayDateLabel(currentWeekStart.AddDays(6))}";
    private static readonly string[] ArabicMonths = ["كانون الثاني", "شباط", "آذار", "نيسان", "أيار", "حزيران", "تموز", "آب", "أيلول", "تشرين الأول", "تشرين الثاني", "كانون الأول"];
    private static readonly string[] ArabicDays = ["الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"];
    private static readonly string[] EnglishMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
        Console.WriteLine("[WeekPage] OnInitializedAsync started.");
        var user = await Auth.GetCurrentUserAsync();
        Console.WriteLine($"[WeekPage] User returned: {(user == null ? "null" : user.Uid)}");
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Console.WriteLine("[WeekPage] No user session. Redirecting to /signin.");
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        currentWeekStart = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        await EnsureSeededAsync();
        await LoadCatalogMealsAsync();
        await LoadProfileAsync();
        await LoadWeekAsync(currentWeekStart);
        if (!profileFirstWeekFilled) await AutoPopulateFirstWeeksAsync();
        remoteListener = DotNetObjectReference.Create(this);
        try { await JS.InvokeAsync<bool>("nxtweek.emailAuth.subscribeToUser", uid, remoteListener); } catch { /* Firebase configuration is optional until sync is enabled. */ }
        var uri = new Uri(Nav.Uri);
        var updatedPrefix = "updated=";
        var query = uri.Query;
        var index = query.IndexOf(updatedPrefix, StringComparison.OrdinalIgnoreCase);
        if (index >= 0 && DateOnly.TryParse(query[(index + updatedPrefix.Length)..].Split('&')[0], out var updatedDate))
        {
            animatedDate = updatedDate;
        }
        const string toastPrefix = "toast=";
        var toastIndex = query.IndexOf(toastPrefix, StringComparison.OrdinalIgnoreCase);
        if (toastIndex >= 0)
        {
            toastMessage = Uri.UnescapeDataString(query[(toastIndex + toastPrefix.Length)..].Split('&')[0]);
            _ = HideToastAsync();
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(async () =>
    {
        await LoadCatalogMealsAsync();
        StateHasChanged();
    });

    private async Task LoadCatalogMealsAsync()
    {
        var all = await CatalogService.GetAllMealsAsync();
        catalogMeals = all.Where(m => string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, Loc.CurrentLanguage, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task EnsureSeededAsync()
    {
        await MealService.SeedAsync(new List<Meal>());
    }

    private async Task LoadProfileAsync()
    {
        var profile = await UserService.GetProfileAsync(uid);
        userHasUsername = !string.IsNullOrWhiteSpace(profile?.Username);
        profileFirstWeekFilled = profile?.FirstWeekAutoFilled ?? false;
        showProfileNudge = !userHasUsername && uid.StartsWith("guest_", StringComparison.OrdinalIgnoreCase);
    }

    private async Task AutoPopulateFirstWeeksAsync()
    {
        // Only fill genuine first visits: a profile that has never been auto-filled
        // and that has no plan entries anywhere yet (so we don't wipe a plan the
        // user may have started or imported).
        var profile = await UserService.GetProfileAsync(uid);
        if (profile is null || profile.FirstWeekAutoFilled) return;
        if (await UserService.HasAnyPlanEntryAsync(uid)) return;

        var nextWeekStart = currentWeekStart.AddDays(7);
        var nextWeekMeals = await MealService.GetWeekAsync(nextWeekStart, nextWeekStart.AddDays(6));

        await PopulateEmptyWeekAsync(weekMeals);
        await PopulateEmptyWeekAsync(nextWeekMeals);
        await LoadWeekAsync(currentWeekStart);

        profile.FirstWeekAutoFilled = true;
        await UserService.CreateProfileAsync(profile);
        profileFirstWeekFilled = true;
    }

    private async Task PopulateEmptyWeekAsync(List<Meal> meals)
    {
        var emptyDays = meals.Where(m => string.IsNullOrWhiteSpace(m.MealId)).ToList();
        if (emptyDays.Count == 0) return;

        var suggestions = await SuggestionService.GetSuggestionsAsync(uid, meals, emptyDays.Count);
        if (suggestions.Count == 0) return;

        var catalog = await CatalogService.GetAllMealsAsync();
        for (var i = 0; i < emptyDays.Count && i < suggestions.Count; i++)
        {
            var day = emptyDays[i];
            var item = catalog.FirstOrDefault(c => c.Name.Equals(suggestions[i], StringComparison.OrdinalIgnoreCase));
            if (item is null) continue;

            day.MealId = item.Id;
            day.Name = item.Name;
            day.PhotoUrl = item.PhotoUrl;
            day.Ingredients = item.Ingredients;
            day.SideDishes = item.SideDishes;
            day.MealType = item.MealType;
            day.Language = item.Language;

            await UserService.AssignMealToDateAsync(uid, day.Date, item.Id);
        }

        await CacheService.SetCachedWeekAsync(meals);
    }

    private async Task LoadWeekAsync(DateOnly weekStart)
    {
        isLoading = true;
        currentWeekStart = weekStart;
        var fresh = await MealService.GetWeekAsync(weekStart, weekStart.AddDays(6));
        weekMeals = fresh;
        await CacheService.SetCachedWeekAsync(fresh);
        isLoading = false;
    }

    [JSInvokable]
    public async Task OnRemoteUserChanged()
    {
        if (disposed || isLoading) return;
        await InvokeAsync(async () => await LoadWeekAsync(currentWeekStart));
    }

    public async ValueTask DisposeAsync()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        disposed = true;
        remoteListener?.Dispose();
        try { await JS.InvokeVoidAsync("nxtweek.emailAuth.unsubscribe"); } catch { }
    }

    private static DateOnly StartOfWeek(DateOnly date) => date.AddDays(-(7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7);
    private string MealRenderKey(Meal meal) => animatedDate == meal.Date ? $"{meal.Id}-flip-{flipSequence}" : meal.Id;
    private void TriggerMealFlip(DateOnly date) { animatedDate = date; flipSequence++; }

    private Task GoPreviousWeek() => LoadWeekAsync(currentWeekStart.AddDays(-7));
    private Task GoNextWeek() => LoadWeekAsync(currentWeekStart.AddDays(7));
    private async Task ShareWeek()
    {
        isSharing = true;
        try
        {
            await JS.InvokeAsync<string>("nxtweek.captureAndShare", "week-share-capture");
        }
        catch
        {
            toastMessage = Loc.IsArabic ? "تعذرت مشاركة الأسبوع. حاول مرة أخرى." : "Could not share week. Please try again.";
            _ = HideToastAsync();
        }
        finally { isSharing = false; }
    }
    private async Task SuggestNew(Meal meal)
    {
        var otherWeekMeals = weekMeals.Where(existing => existing.Date != meal.Date).ToList();
        var suggestions = await SuggestionService.GetSuggestionsAsync(uid, otherWeekMeals, count: 1);
        if (suggestions.Count == 0) return;

        var suggestedName = suggestions[0];
        var catalog = await CatalogService.GetAllMealsAsync();
        var item = catalog.FirstOrDefault(c => c.Name.Equals(suggestedName, StringComparison.OrdinalIgnoreCase));
        meal.Name = suggestedName;
        meal.MealId = item?.Id ?? "";
        meal.Ingredients = item?.Ingredients ?? new();
        meal.SideDishes = item?.SideDishes ?? new();
        meal.MealType = item?.MealType;
        meal.Language = item?.Language ?? "ar";
        await MealService.UpsertMealAsync(meal);
        TriggerMealFlip(meal.Date);
        await LoadWeekAsync(currentWeekStart);
    }

    private async Task SuggestEmpty(Meal meal)
    {
        await SuggestNew(meal);
    }

    private async Task SurpriseWeek()
    {
        showWeekSurpriseConfirm = false;
        var emptyDays = weekMeals.Where(m => string.IsNullOrWhiteSpace(m.MealId)).ToList();
        if (emptyDays.Count == 0) return;
        var suggestions = await SuggestionService.GetSuggestionsAsync(uid, weekMeals, emptyDays.Count);
        var catalog = await CatalogService.GetAllMealsAsync();
        foreach (var pair in emptyDays.Zip(suggestions))
        {
            var item = catalog.FirstOrDefault(c => c.Name.Equals(pair.Second, StringComparison.OrdinalIgnoreCase));
            if (item is null) continue;
            await UserService.AssignMealToDateAsync(uid, pair.First.Date, item.Id);
        }
        animatedDate = emptyDays[0].Date;
        await LoadWeekAsync(currentWeekStart);
    }

    private void OpenActions(Meal meal) { selectedMeal = meal; showQuickPicker = false; showMoveDays = false; }
    private async Task OpenMealPicker(DateOnly date)
    {
        navigatingDate = date;
        StateHasChanged();
        await Task.Delay(180);
        Nav.NavigateTo($"/meals?day={date:yyyy-MM-dd}");
    }
    private async Task HideToastAsync()
    {
        await Task.Delay(2000);
        toastMessage = "";
        await InvokeAsync(StateHasChanged);
    }
    private void CloseActions() { selectedMeal = null; showQuickPicker = false; showMoveDays = false; }
    private async Task SuggestFromSheet() { if (selectedMeal is not null) { await SuggestNew(selectedMeal); CloseActions(); } }
    private async Task ChooseMeal(MealCatalogItem item)
    {
        if (selectedMeal is null) return;
        selectedMeal.Name = item.Name; selectedMeal.MealId = item.Id; selectedMeal.MealType = item.MealType; selectedMeal.Ingredients = item.Ingredients; selectedMeal.SideDishes = item.SideDishes; selectedMeal.Language = item.Language;
        await MealService.UpsertMealAsync(selectedMeal); animatedDate = selectedMeal.Date; await LoadWeekAsync(currentWeekStart); CloseActions();
    }
    private async Task ToggleFavorite(Meal meal)
    {
        if (string.IsNullOrWhiteSpace(meal.MealId)) return;
        await UserService.ToggleFavoriteMealAsync(uid, meal.MealId); meal.IsFavorite = !meal.IsFavorite;
        await MealService.UpsertMealAsync(meal);
    }
    private async Task DeleteSelected()
    {
        if (selectedMeal is null) return;
        await UserService.SaveWeeklyPlanEntryAsync(uid, new WeeklyPlanEntry { Date = selectedMeal.Date, MealId = "", IsFavorite = false });
        await LoadWeekAsync(currentWeekStart); CloseActions();
    }
    private async Task MoveTo(DateOnly date)
    {
        if (selectedMeal is null) return;
        var target = weekMeals.First(m => m.Date == date); target.MealId = selectedMeal.MealId; target.Name = selectedMeal.Name; target.MealType = selectedMeal.MealType; target.Ingredients = selectedMeal.Ingredients; target.SideDishes = selectedMeal.SideDishes; target.IsFavorite = selectedMeal.IsFavorite; target.Language = selectedMeal.Language;
        await MealService.UpsertMealAsync(target);
        await UserService.SaveWeeklyPlanEntryAsync(uid, new WeeklyPlanEntry { Date = selectedMeal.Date, MealId = "", IsFavorite = false });
        await LoadWeekAsync(currentWeekStart); CloseActions();
    }
    private string DayDateLabel(DateOnly date) =>
        Loc.IsArabic
            ? $"{ArabicDays[(int)date.DayOfWeek]} {date.Day} {ArabicMonths[date.Month - 1]}"
            : $"{Loc.GetDayName(date.DayOfWeek)}, {EnglishMonths[date.Month - 1]} {date.Day}";

    private static string TypeIcon(MealType? type) => type switch { MealType.Meat => "🥩", MealType.Chicken => "🍗", MealType.Fish => "🐟", MealType.Vegetarian => "🥦", MealType.Vegan => "🌱", _ => "🍽️" };
}
