@page "/meals"
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Models
@inject IMealCatalogService CatalogService
@inject IUserService UserService
@inject IAuthService Auth
@inject IMealAssignService Assigner
@inject IMealService MealService
@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject IMealImageService MealImages
@implements IDisposable

<div class="mk-page mk-meals" dir="@Loc.Direction">
    <header class="mk-header is-sticky">
        <div class="mk-header-row">
            <h1 class="mk-title">@Loc["meals_title"]</h1>
            <button class="mk-icon-btn" aria-label="@Loc["meals_filter"]" @onclick="() => showFilters = true">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
                @if (!filterByAppLanguage) { <span class="mk-dot-badge" aria-hidden="true"></span> }
            </button>
        </div>

        @if (isContextMode)
        {
            <div class="mk-banner">
                <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
                <span>@Loc.T("meals_pick_for_day", PickDayLabel)</span>
                <a href="" class="mk-banner-cancel">@Loc["cancel"]</a>
            </div>
        }

        <label class="mk-search">
            <svg class="i" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
            <input type="search" placeholder="@Loc["meals_search_placeholder"]" aria-label="@Loc["meals_search_placeholder"]" @bind="searchText" @bind:event="oninput" />
        </label>

        <div class="mk-chip-row" role="group" aria-label="@Loc["meals_meal_type"]">
            <button class="mk-chip @(selectedMealType is null ? "is-active" : "")" @onclick="() => SetMealType(null)">@Loc["meals_filter_all"]</button>
            @foreach (var type in AllTypes)
            {
                <button class="mk-chip @(selectedMealType == type ? "is-active" : "")" @onclick="() => SetMealType(type)">@Loc.GetMealTypeName(type)</button>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(confirmMessage))
    {
        <div class="mk-stack"><div class="mk-notice">@confirmMessage</div></div>
    }

    @if (isLoading)
    {
        <div class="mk-grid"><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (FilteredMeals.Count == 0)
    {
        <NxtEmptyState Icon="🍳" Title="@Loc["meals_empty_title"]" Message="@Loc["meals_empty_desc"]" />
    }
    else
    {
        <div class="mk-grid">
            @foreach (var meal in FilteredMeals)
            {
                var favorite = userProfile?.FavoriteMealIds?.Contains(meal.Id) ?? false;
                <article class="mk-meal-card">
                    <div class="mk-tile mk-meal-tile @MealTypeStyle.T(meal.MealType) @(string.IsNullOrWhiteSpace(meal.PhotoUrl) ? "" : "has-photo")">
                        <button class="mk-meal-open" aria-label="@meal.Name" @onclick="() => OpenMeal(meal)"><img src="@MealImages.GetImageUrl(meal)" alt="" loading="lazy" /></button>
                        <button class="mk-heart @(favorite ? "is-on" : "")" aria-pressed="@favorite" aria-label="@(favorite ? Loc["meal_remove_favorite_short"] : Loc["meal_favorite"])" @onclick="() => ToggleFavorite(meal)">
                            <span><svg viewBox="0 0 24 24" fill="@(favorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-8-5-9.5-10A5 5 0 0 1 12 7a5 5 0 0 1 9.5 4C20 16 12 21 12 21z"/></svg></span>
                        </button>
                    </div>
                    <div class="mk-meal-foot">
                        <button class="mk-meal-text" @onclick="() => OpenMeal(meal)">
                            <span class="mk-meal-name">@meal.Name</span>
                            <span class="mk-subtitle">@Loc.GetMealTypeName(meal.MealType)@if (meal.PreparationMinutes is > 0) { <text> · @Loc.T("nut_minutes", Loc.Num(meal.PreparationMinutes.Value))</text> }</span>
                        </button>
                        <button class="mk-icon-btn is-ink" aria-label="@(isContextMode ? Loc.T("meals_add_to_named_day", PickDayLabel) : Loc["meals_add_to_day_short"])" @onclick="() => SelectMeal(meal)">
                            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        </button>
                    </div>
                    <div class="mk-meal-nut"><NutritionChips Nutrition="meal.Nutrition" /></div>
                </article>
            }
        </div>
    }

    <button class="mk-fab is-accent is-start" @onclick="OpenNewMeal">
        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        @Loc["meals_new_meal"]
    </button>
</div>

<NxtBottomSheet IsOpen="showFilters" Title="@Loc["meals_filter"]" OnDismiss="() => showFilters = false">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <span class="mk-label">@Loc["meals_language_filter"]</span>
        <div class="mk-seg">
            <button class="@(filterByAppLanguage ? "is-active" : "")" @onclick="() => filterByAppLanguage = true">@Loc["meals_lang_app"]</button>
            <button class="@(!filterByAppLanguage ? "is-active" : "")" @onclick="() => filterByAppLanguage = false">@Loc["meals_lang_all"]</button>
        </div>
        <button class="mk-btn is-lg is-block" @onclick="() => showFilters = false">@Loc["done_action"]</button>
    </div>
</NxtBottomSheet>

<NxtBottomSheet IsOpen="@(showDayPicker && browseMeal is not null)" Eyebrow="@browseMeal?.Name" Title="@Loc["meals_add_to_day"]" OnDismiss="CloseDayPicker">
    <div class="mk-sheet-list" dir="@Loc.Direction">
        @foreach (var day in currentWeekDays)
        {
            <button @onclick="() => ChooseBrowseDay(day)">@Loc.GetDayName(day.DayOfWeek) <span class="mk-sheet-sub">@day.Day</span></button>
        }
    </div>
</NxtBottomSheet>

<NxtBottomSheet IsOpen="showNewMeal" Title="@Loc["meals_new_meal"]" Eyebrow="@Loc["meals_new_meal_eyebrow"]" OnDismiss="CloseNewMeal">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <label class="mk-search">
            <input placeholder="@Loc["meals_meal_name"]" aria-label="@Loc["meals_meal_name"]" @bind="newMealName" @bind:event="oninput" />
        </label>
        <div class="mk-chip-wrap" role="group" aria-label="@Loc["meals_meal_type"]">
            @foreach (var type in AllTypes)
            {
                <button class="mk-chip @(newMealType == type ? "is-active" : "")" @onclick="() => newMealType = type">@Loc.GetMealTypeName(type)</button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(newMealError)) { <div class="mk-notice is-error">@newMealError</div> }
        <button class="mk-btn is-lg is-block" disabled="@string.IsNullOrWhiteSpace(newMealName)" @onclick="CreateNewMeal">@Loc["meals_save_and_select"]</button>
    </div>
</NxtBottomSheet>

<MealIngredientsSheet IsOpen="@(ingredientsMeal is not null)"
                      MealName="@(ingredientsMeal?.Name ?? "")"
                      ImageUrl="@(ingredientsMeal is null ? null : MealImages.GetImageUrl(ingredientsMeal))"
                      MealType="ingredientsMeal?.MealType"
                      Ingredients="ingredientsMeal?.Ingredients"
                      SideDishes="ingredientsMeal?.SideDishes"
                      OnDismiss="() => ingredientsMeal = null" />

@code {
    [SupplyParameterFromQuery(Name = "create")]
    public bool CreateRequested { get; set; }

    private static readonly MealType[] AllTypes = [MealType.Meat, MealType.Chicken, MealType.Fish, MealType.Vegetarian];

    private List<MealCatalogItem> allMeals = new();
    private List<DateOnly> currentWeekDays = new();
    private UserProfile? userProfile;

    private string uid = "";
    private bool isLoading = true;
    private string searchText = "";

    private MealType? selectedMealType;
    private bool filterByAppLanguage = true;
    private bool showFilters;

    private DateOnly selectedDate;
    private bool isContextMode;
    private bool showDayPicker;
    private MealCatalogItem? browseMeal;
    private MealCatalogItem? ingredientsMeal;
    private string confirmMessage = "";
    private bool showNewMeal;
    private string newMealName = "";
    private string newMealError = "";
    private MealType newMealType = MealType.Vegetarian;
    private bool pageInitialized;
    private bool openedFromNavAction;

    private string PickDayLabel => $"{Loc.GetDayName(selectedDate.DayOfWeek)} {selectedDate.Day}";

    private List<MealCatalogItem> FilteredMeals
    {
        get
        {
            var query = allMeals.Where(meal => !meal.IsArchived).AsEnumerable();
            if (filterByAppLanguage)
            {
                var activeLang = Loc.CurrentLanguage;
                var inLanguage = query.Where(m => string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, activeLang, StringComparison.OrdinalIgnoreCase)).ToList();
                // Only narrow to the active language if that language actually has
                // meals — an unseeded language should not produce an empty library.
                if (inLanguage.Count > 0) query = inLanguage;
            }
            if (!string.IsNullOrWhiteSpace(searchText))
                query = query.Where(m => m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                                      || m.Ingredients.Any(i => i.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
            if (selectedMealType.HasValue)
                query = query.Where(m => m.MealType == selectedMealType.Value);
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
        isLoading = true;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        var startOfWeek = StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        selectedDate = startOfWeek;
        var query = new Uri(Nav.Uri).Query;
        const string dateKey = "day=";
        var index = query.IndexOf(dateKey, StringComparison.OrdinalIgnoreCase);
        if (index >= 0)
        {
            var raw = query[(index + dateKey.Length)..].Split('&')[0];
            if (DateOnly.TryParse(raw, out var parsed)) { selectedDate = parsed; isContextMode = true; }
        }
        currentWeekDays = Enumerable.Range(0, 7).Select(i => startOfWeek.AddDays(i)).ToList();

        await MealService.SeedAsync(new List<Meal>());
        await MealImages.EnsureLoadedAsync();
        allMeals = await CatalogService.GetAllMealsAsync();
        userProfile = await UserService.GetProfileAsync(uid);

        isLoading = false;
        pageInitialized = true;
        if (CreateRequested) OpenNewMealFromNavigation();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (pageInitialized && CreateRequested && !showNewMeal)
            OpenNewMealFromNavigation();
    }

    private static DateOnly StartOfWeek(DateOnly date)
    {
        var diff = (7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        return date.AddDays(-diff);
    }

    private void SetMealType(MealType? type) => selectedMealType = type;

    // Tapping a card opens the meal; in "pick a day" mode the day travels along so its button adds to that day.
    private void OpenMeal(MealCatalogItem meal) =>
        Nav.NavigateTo(isContextMode ? $"/meal/{meal.Id}?day={selectedDate:yyyy-MM-dd}" : $"/meal/{meal.Id}");

    private async Task ToggleFavorite(MealCatalogItem meal)
    {
        await UserService.ToggleFavoriteMealAsync(uid, meal.Id);
        userProfile ??= new UserProfile();
        if (userProfile.FavoriteMealIds.Contains(meal.Id)) userProfile.FavoriteMealIds.Remove(meal.Id); else userProfile.FavoriteMealIds.Add(meal.Id);
    }

    private async Task SelectMeal(MealCatalogItem meal)
    {
        if (isContextMode) await ExecuteAssignment(meal, selectedDate);
        else { browseMeal = meal; showDayPicker = true; }
    }
    private async Task ChooseBrowseDay(DateOnly day) { if (browseMeal is not null) await ExecuteAssignment(browseMeal, day); }
    private void CloseDayPicker() { showDayPicker = false; browseMeal = null; }
    private void OpenNewMeal() { openedFromNavAction = false; showNewMeal = true; newMealName = ""; newMealError = ""; newMealType = MealType.Vegetarian; }
    private void OpenNewMealFromNavigation() { OpenNewMeal(); openedFromNavAction = true; }
    private void CloseNewMeal()
    {
        var clearCreateQuery = openedFromNavAction;
        showNewMeal = false;
        newMealError = "";
        openedFromNavAction = false;
        if (clearCreateQuery) Nav.NavigateTo("/meals", replace: true);
    }
    private async Task CreateNewMeal()
    {
        var name = newMealName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { newMealError = Loc["meals_name_required"]; return; }
        try
        {
            var created = await CatalogService.CreateMealAsync(new MealCatalogItem
            {
                Name = name,
                MealType = newMealType,
                Language = Loc.CurrentLanguage,
                CreatedBy = uid
            });
            allMeals = await CatalogService.GetAllMealsAsync();
            CloseNewMeal();
            await SelectMeal(created);
        }
        catch (Exception ex) { newMealError = ex.Message; }
    }

    private async Task ExecuteAssignment(MealCatalogItem meal, DateOnly date)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await Assigner.AssignAsync(uid, date, meal);
            var dayLabel = Loc.GetDayName(date.DayOfWeek);
            var message = Uri.EscapeDataString(Loc.T("meals_added_toast", meal.Name, dayLabel));
            Nav.NavigateTo($"/?updated={date:yyyy-MM-dd}&toast={message}");
        }
        catch (Exception ex)
        {
            confirmMessage = Loc.T("meals_assign_error", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
