@page "/meals"
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Models
@inject IMealCatalogService CatalogService
@inject IUserService UserService
@inject IAuthService Auth
@inject IMealCacheService CacheService
@inject IMealService MealService
@inject NavigationManager Nav
@inject ILocalizationService Loc
@implements IDisposable

<div class="app app-content-wrapper" dir="@Loc.Direction">
    @if (isContextMode)
    {
        <SelectedDayHeader Date="selectedDate" />
    }
    else
    {
        <UiPageHeader Icon="🍽️" Title="@Loc["meals_title"]" Subtitle="@(Loc.IsArabic ? "تصفح الوجبات، احفظ المفضلة، واختر يوماً عند الاستخدام." : "Browse meals, save favorites, and pick a day to add.")" />
    }

    <!-- Search and Filters -->
    <div style="padding: 16px; display: flex; flex-direction: column; gap: 12px;">
        <UiTextInput CssClass="meal-search" Placeholder="@Loc["meals_search_placeholder"]" @bind-Value="searchText" />
        <div style="display: flex; gap: 8px;">
            <UiButton Variant="secondary" OnClick="OpenNewMeal" Style="flex: 1;">＋ @(Loc.IsArabic ? "وجبة جديدة" : "New Meal")</UiButton>
            <UiFilterChip Active="@(!filterByAppLanguage)" OnClick="ToggleLanguageFilter">
                @(filterByAppLanguage ? Loc["meals_lang_app"] : Loc["meals_lang_all"])
            </UiFilterChip>
        </div>

        <!-- Meal Type Filter Chips -->
        <div>
            <span style="font-size:12px; font-weight:bold; color:var(--color-text-secondary); display:block; margin-bottom:6px;">@(Loc.IsArabic ? "النوع:" : "Type:")</span>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <UiFilterChip Active="@(selectedMealType == null)" OnClick="() => SetMealType(null)">@Loc["meals_filter_all"]</UiFilterChip>
                <UiFilterChip Active="@(selectedMealType == MealType.Meat)" OnClick="() => SetMealType(MealType.Meat)">🥩 @Loc["meal_meat"]</UiFilterChip>
                <UiFilterChip Active="@(selectedMealType == MealType.Chicken)" OnClick="() => SetMealType(MealType.Chicken)">🍗 @Loc["meal_chicken"]</UiFilterChip>
                <UiFilterChip Active="@(selectedMealType == MealType.Fish)" OnClick="() => SetMealType(MealType.Fish)">🐟 @Loc["meal_fish"]</UiFilterChip>
                <UiFilterChip Active="@(selectedMealType == MealType.Vegetarian)" OnClick="() => SetMealType(MealType.Vegetarian)">🥦 @Loc["meal_vegetarian"]</UiFilterChip>
                <UiFilterChip Active="@(selectedMealType == MealType.Vegan)" OnClick="() => SetMealType(MealType.Vegan)">🌱 @Loc["meal_vegan"]</UiFilterChip>
            </div>
        </div>
    </div>

    <!-- Playful Toast Confirmation -->
    @if (!string.IsNullOrEmpty(confirmMessage))
    {
        <div style="padding: 0 16px;">
            <div class="alert-playful" style="padding: 12px; text-align: center; margin-bottom: 12px; font-size: 14px;">
                🎉 @confirmMessage
            </div>
        </div>
    }

    <!-- Meals List -->
    <div style="padding: 0 16px 20px; display: flex; flex-direction: column; gap: 14px;">
        @if (isLoading)
        {
            <p style="text-align: center; color: var(--color-text-secondary); padding: 20px;">@(Loc.IsArabic ? "جاري تحميل الوجبات... ⏳" : "Loading meals... ⏳")</p>
        }
        else if (FilteredMeals.Count == 0)
        {
            <UiEmptyState Icon="🍳" Title="@Loc["meals_empty_title"]" Message="@Loc["meals_empty_desc"]" />
        }
        else
        {
            @foreach (var meal in FilteredMeals)
            {
                <MealSelectionCard Meal="meal"
                                   IsContextMode="isContextMode"
                                   IsFavorite="@(userProfile?.FavoriteMealIds?.Contains(meal.Id) ?? false)"
                                   OnSelect="SelectMeal"
                                   OnFavorite="ToggleFavorite"
                                   OnView="ViewMeal" />
            }
        }
    </div>
</div>

<UiBottomSheet IsOpen="@(showDayPicker && browseMeal is not null)" Eyebrow="@browseMeal?.Name" Title="@(Loc.IsArabic ? "أضيفي هذه الوجبة لأي يوم؟" : "Add this meal to which day?")" OnDismiss="CloseDayPicker">
    <div class="move-days" dir="@Loc.Direction">
        @foreach (var day in currentWeekDays)
        { <button @onclick="() => ChooseBrowseDay(day)">@Loc.GetDayName(day.DayOfWeek)</button> }
    </div>
</UiBottomSheet>

<UiBottomSheet IsOpen="showNewMeal" Title="@(Loc.IsArabic ? "وجبة جديدة" : "New Meal")" Eyebrow="@(Loc.IsArabic ? "أضفها مرة واحدة لتصبح متاحة للجميع" : "Add it once to make it available to all")" OnDismiss="CloseNewMeal">
    <div class="sheet-actions" dir="@Loc.Direction">
        <UiTextInput Placeholder="@(Loc.IsArabic ? "اسم الوجبة" : "Meal name")" @bind-Value="newMealName" />
        <div class="new-meal-type-pills" aria-label="@(Loc.IsArabic ? "نوع الوجبة" : "Meal type")">
            <UiFilterChip Active="@(newMealType == MealType.Meat)" OnClick='() => newMealType = MealType.Meat'>🥩 @Loc["meal_meat"]</UiFilterChip>
            <UiFilterChip Active="@(newMealType == MealType.Chicken)" OnClick='() => newMealType = MealType.Chicken'>🍗 @Loc["meal_chicken"]</UiFilterChip>
            <UiFilterChip Active="@(newMealType == MealType.Fish)" OnClick='() => newMealType = MealType.Fish'>🐟 @Loc["meal_fish"]</UiFilterChip>
            <UiFilterChip Active="@(newMealType == MealType.Vegetarian)" OnClick='() => newMealType = MealType.Vegetarian'>🥦 @Loc["meal_vegetarian"]</UiFilterChip>
            <UiFilterChip Active="@(newMealType == MealType.Vegan)" OnClick='() => newMealType = MealType.Vegan'>🌱 @Loc["meal_vegan"]</UiFilterChip>
        </div>
        @if (!string.IsNullOrWhiteSpace(newMealError)) { <div class="alert-playful settings-feedback">@newMealError</div> }
        <UiButton Variant="primary" OnClick="CreateNewMeal" Disabled="@string.IsNullOrWhiteSpace(newMealName)">@(Loc.IsArabic ? "حفظ واختيار الوجبة" : "Save and Select Meal")</UiButton>
    </div>
</UiBottomSheet>

<UiBottomSheet IsOpen="@(editingMeal is not null)" Title="@(Loc.IsArabic ? "تعديل الوجبة" : "Edit Meal")" Eyebrow="@(Loc.IsArabic ? "عدّل التفاصيل أو استخدمها في خطتك" : "Edit details or use it in your plan")" OnDismiss="CloseMealEditor">
    @if (editingMeal is not null)
    {
        <div class="sheet-actions" dir="@Loc.Direction">
            <UiTextInput Placeholder="@(Loc.IsArabic ? "اسم الوجبة" : "Meal name")" @bind-Value="editingMealName" />
            <div class="new-meal-type-pills" aria-label="@(Loc.IsArabic ? "نوع الوجبة" : "Meal type")">
                <UiFilterChip Active="@(editingMealType == MealType.Meat)" OnClick='() => editingMealType = MealType.Meat'>🥩 @Loc["meal_meat"]</UiFilterChip>
                <UiFilterChip Active="@(editingMealType == MealType.Chicken)" OnClick='() => editingMealType = MealType.Chicken'>🍗 @Loc["meal_chicken"]</UiFilterChip>
                <UiFilterChip Active="@(editingMealType == MealType.Fish)" OnClick='() => editingMealType = MealType.Fish'>🐟 @Loc["meal_fish"]</UiFilterChip>
                <UiFilterChip Active="@(editingMealType == MealType.Vegetarian)" OnClick='() => editingMealType = MealType.Vegetarian'>🥦 @Loc["meal_vegetarian"]</UiFilterChip>
                <UiFilterChip Active="@(editingMealType == MealType.Vegan)" OnClick='() => editingMealType = MealType.Vegan'>🌱 @Loc["meal_vegan"]</UiFilterChip>
            </div>
            @if (!string.IsNullOrWhiteSpace(mealEditorError)) { <div class="alert-playful settings-feedback">@mealEditorError</div> }
            <UiButton Variant="primary" OnClick="SaveMealEdit" Disabled="@string.IsNullOrWhiteSpace(editingMealName)">@(Loc.IsArabic ? "حفظ التعديلات" : "Save Changes")</UiButton>
            <UiButton Variant="secondary" OnClick="UseEditedMeal">@(Loc.IsArabic ? "استخدم هذه الوجبة" : "Use this meal")</UiButton>
            <button class="danger" @onclick="ArchiveEditingMeal">@(Loc.IsArabic ? "إخفاء الوجبة من المكتبة" : "Hide meal from library")</button>
        </div>
    }
</UiBottomSheet>

@code {
    [SupplyParameterFromQuery(Name = "create")]
    public bool CreateRequested { get; set; }

    private List<MealCatalogItem> allMeals = new();
    private List<WeeklyPlanEntry> currentWeekPlan = new();
    private List<DateOnly> currentWeekDays = new();
    private UserProfile? userProfile;

    private string uid = "";
    private bool isLoading = true;
    private string searchText = "";

    private MealType? selectedMealType;
    private bool filterByAppLanguage = true;

    private DateOnly selectedDate;
    private bool isContextMode;
    private bool showDayPicker;
    private MealCatalogItem? browseMeal;
    private string confirmMessage = "";
    private bool showNewMeal;
    private string newMealName = "";
    private string newMealError = "";
    private MealType newMealType = MealType.Vegetarian;
    private MealCatalogItem? editingMeal;
    private string editingMealName = "";
    private string mealEditorError = "";
    private MealType editingMealType;
    private bool pageInitialized;
    private bool openedFromNavAction;

    private List<MealCatalogItem> FilteredMeals
    {
        get
        {
            var query = allMeals.Where(meal => !meal.IsArchived).AsEnumerable();
            if (filterByAppLanguage)
            {
                var activeLang = Loc.CurrentLanguage;
                query = query.Where(m => string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, activeLang, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(searchText))
                query = query.Where(m => m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            if (selectedMealType.HasValue)
                query = query.Where(m => m.MealType == selectedMealType.Value);
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
        isLoading = true;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var startOfWeek = StartOfWeek(today);
        selectedDate = startOfWeek;
        var query = new Uri(Nav.Uri).Query;
        const string dateKey = "day=";
        var index = query.IndexOf(dateKey, StringComparison.OrdinalIgnoreCase);
        if (index >= 0)
        {
            var raw = query[(index + dateKey.Length)..].Split('&')[0];
            if (DateOnly.TryParse(raw, out var parsed)) { selectedDate = parsed; isContextMode = true; }
        }
        currentWeekDays = Enumerable.Range(0, 7).Select(i => startOfWeek.AddDays(i)).ToList();

        await MealService.SeedAsync(new List<Meal>());
        allMeals = await CatalogService.GetAllMealsAsync();
        userProfile = await UserService.GetProfileAsync(uid);
        currentWeekPlan = await UserService.GetWeeklyPlanAsync(uid, startOfWeek, startOfWeek.AddDays(6));

        isLoading = false;
        pageInitialized = true;
        if (CreateRequested) OpenNewMealFromNavigation();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    private void ToggleLanguageFilter() => filterByAppLanguage = !filterByAppLanguage;

    protected override void OnParametersSet()
    {
        if (pageInitialized && CreateRequested && !showNewMeal)
            OpenNewMealFromNavigation();
    }

    private DateOnly StartOfWeek(DateOnly date)
    {
        var diff = (7 + (int)date.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        return date.AddDays(-diff);
    }

    private void SetMealType(MealType? type) => selectedMealType = type;
    private void ViewMeal(MealCatalogItem meal)
    {
        if (isContextMode) { Nav.NavigateTo($"/meal/{meal.Id}"); return; }
        editingMeal = meal;
        editingMealName = meal.Name;
        editingMealType = meal.MealType;
        mealEditorError = "";
    }
    private async Task ToggleFavorite(MealCatalogItem meal)
    {
        await UserService.ToggleFavoriteMealAsync(uid, meal.Id);
        userProfile ??= new UserProfile();
        if (userProfile.FavoriteMealIds.Contains(meal.Id)) userProfile.FavoriteMealIds.Remove(meal.Id); else userProfile.FavoriteMealIds.Add(meal.Id);
    }
    private async Task SelectMeal(MealCatalogItem meal)
    {
        if (isContextMode) await ExecuteAssignment(meal, selectedDate);
        else { browseMeal = meal; showDayPicker = true; }
    }
    private async Task ChooseBrowseDay(DateOnly day) { if (browseMeal is not null) await ExecuteAssignment(browseMeal, day); }
    private void CloseDayPicker() { showDayPicker = false; browseMeal = null; }
    private void OpenNewMeal() { openedFromNavAction = false; showNewMeal = true; newMealName = ""; newMealError = ""; newMealType = MealType.Vegetarian; }
    private void OpenNewMealFromNavigation() { OpenNewMeal(); openedFromNavAction = true; }
    private void CloseNewMeal()
    {
        var clearCreateQuery = openedFromNavAction;
        showNewMeal = false;
        newMealError = "";
        openedFromNavAction = false;
        if (clearCreateQuery) Nav.NavigateTo("/meals", replace: true);
    }
    private async Task CreateNewMeal()
    {
        var name = newMealName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { newMealError = Loc.IsArabic ? "أدخل اسم الوجبة." : "Enter meal name."; return; }
        try
        {
            var created = await CatalogService.CreateMealAsync(new MealCatalogItem
            {
                Name = name,
                MealType = newMealType,
                Language = Loc.CurrentLanguage,
                CreatedBy = uid
            });
            allMeals = await CatalogService.GetAllMealsAsync();
            CloseNewMeal();
            await SelectMeal(created);
        }
        catch (Exception ex) { newMealError = ex.Message; }
    }

    private void CloseMealEditor() { editingMeal = null; editingMealName = ""; mealEditorError = ""; }
    private async Task SaveMealEdit()
    {
        if (editingMeal is null) return;
        var name = editingMealName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { mealEditorError = Loc.IsArabic ? "أدخل اسم الوجبة." : "Enter meal name."; return; }
        try
        {
            editingMeal.Name = name;
            editingMeal.MealType = editingMealType;
            await CatalogService.UpdateMealAsync(editingMeal);
            allMeals = await CatalogService.GetAllMealsAsync();
            confirmMessage = Loc.IsArabic ? "تم حفظ تعديلات الوجبة ✨" : "Meal updated successfully ✨";
            CloseMealEditor();
        }
        catch (Exception ex) { mealEditorError = ex.Message; }
    }
    private async Task UseEditedMeal()
    {
        if (editingMeal is null) return;
        var meal = editingMeal;
        var name = editingMealName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { mealEditorError = Loc.IsArabic ? "أدخل اسم الوجبة." : "Enter meal name."; return; }
        try
        {
            meal.Name = name;
            meal.MealType = editingMealType;
            await CatalogService.UpdateMealAsync(meal);
            allMeals = await CatalogService.GetAllMealsAsync();
            CloseMealEditor();
            await SelectMeal(meal);
        }
        catch (Exception ex) { mealEditorError = ex.Message; }
    }
    private async Task ArchiveEditingMeal()
    {
        if (editingMeal is null) return;
        try
        {
            editingMeal.IsArchived = true;
            await CatalogService.UpdateMealAsync(editingMeal);
            allMeals.RemoveAll(meal => meal.Id == editingMeal.Id);
            confirmMessage = Loc.IsArabic ? "تم إخفاء الوجبة من المكتبة." : "Meal hidden from library.";
            CloseMealEditor();
        }
        catch (Exception ex) { mealEditorError = ex.Message; }
    }

    private async Task ExecuteAssignment(MealCatalogItem meal, DateOnly date)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await UserService.AssignMealToDateAsync(uid, date, meal.Id);

            currentWeekPlan.RemoveAll(e => e.Date == date);
            currentWeekPlan.Add(new WeeklyPlanEntry { Date = date, MealId = meal.Id, IsFavorite = false });

            var currentCache = await CacheService.GetCachedWeekAsync();
            if (currentCache is not null)
            {
                currentCache.RemoveAll(m => m.Id == date.ToString("yyyy-MM-dd"));
                var updated = new Meal
                {
                    Id = date.ToString("yyyy-MM-dd"),
                    Date = date,
                    DayName = date.DayOfWeek.ToString(),
                    Name = meal.Name,
                    MealId = meal.Id,
                    IsFavorite = false,
                    SideDishes = meal.SideDishes,
                    Ingredients = meal.Ingredients,
                    MealType = meal.MealType,
                    Language = meal.Language
                };
                currentCache.Add(updated);
                await CacheService.SetCachedWeekAsync(currentCache);
            }

            var dayLabel = Loc.GetDayName(date.DayOfWeek);
            var message = Uri.EscapeDataString(Loc.IsArabic ? $"تمت إضافة {meal.Name} إلى {dayLabel}" : $"Added {meal.Name} to {dayLabel}");
            Nav.NavigateTo($"/?updated={date:yyyy-MM-dd}&toast={message}");
        }
        catch (Exception ex)
        {
            confirmMessage = Loc.IsArabic ? $"حدث خطأ أثناء الإضافة: {ex.Message}" : $"Error assigning meal: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
