@page "/settings"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject ToastService Toasts
@implements IDisposable

@* The family settings shell (language, appearance, AI, install, about) with Makdous' own account sections first. *@
<div class="app app-content-wrapper">
  <NxtSettingsPage InstallHref="settings/install">
    <AppSections>
      <NxtSettingsSection Icon="👤" Title="@Loc["settings_username_title"]" Description="@(hasUsername ? null : Loc["settings_username_prompt"])">
        @if (hasUsername)
        {
          <div class="nxt-input-row">
            <code class="nxt-input setting-id-code" dir="ltr">@currentUsername</code>
            <NxtIconButton Label="@Loc["copy"]" OnClick="CopyUsername">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            </NxtIconButton>
          </div>
        }
        <label class="nxt-label" for="settings-username">@(hasUsername ? Loc["settings_username_change"] : Loc["settings_username_choose"])</label>
        <div class="nxt-input-row">
          <input id="settings-username" class="nxt-input" dir="ltr" autocomplete="off" @bind="usernameInput" @bind:event="oninput" @onblur="CheckUsername" placeholder="@Loc["settings_username_placeholder"]" />
          <NxtIconButton Label="@Loc["save"]" Accent="true" OnClick="SaveUsername" Disabled="isSavingUsername">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </NxtIconButton>
        </div>
        @if (!string.IsNullOrWhiteSpace(usernameFeedback)) { <p class="friend-feedback @(usernameError ? "error" : "")">@usernameFeedback</p> }
      </NxtSettingsSection>

      <NxtSettingsSection Icon="🔁" Title="@Loc["settings_recover_title"]" Description="@Loc["settings_recover_desc"]">
        <a class="nxt-link" href="settings/recover">@Loc["settings_recover_link"]</a>
      </NxtSettingsSection>
    </AppSections>
  </NxtSettingsPage>
</div>

@code {
  private string uid = "";
  private string currentUsername = "";
  private string usernameInput = "";
  private string usernameFeedback = "";
  private bool usernameError;
  private bool isSavingUsername;
  private bool hasUsername => !string.IsNullOrWhiteSpace(currentUsername);

  protected override async Task OnInitializedAsync() {
    Loc.OnLanguageChanged += HandleLanguageChanged;
    await Loc.InitializeAsync();
    var user = await Auth.GetCurrentUserAsync();
    if (user is null) return;
    uid = user.Uid;
    var profile = await UserService.GetProfileAsync(uid);
    currentUsername = profile?.Username ?? "";
  }

  private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

  private async Task CheckUsername() {
    usernameFeedback = "";
    if (string.IsNullOrWhiteSpace(usernameInput)) return;
    try {
      var available = await UserService.IsUsernameAvailableAsync(usernameInput, uid);
      usernameError = !available;
      usernameFeedback = available ? Loc["settings_username_available"] : Loc["settings_username_taken"];
    } catch (Exception ex) {
      usernameError = true;
      usernameFeedback = ex.Message;
    }
  }

  private async Task SaveUsername() {
    isSavingUsername = true;
    usernameFeedback = "";
    try {
      var username = await UserService.RenameUserAsync(uid, usernameInput);
      await Auth.SetActiveDataKeyAsync(username);
      currentUsername = username;
      uid = username;
      usernameInput = "";
      usernameError = false;
      Toasts.Show(Loc["settings_username_saved"]);
    } catch (Exception ex) {
      usernameError = true;
      usernameFeedback = ex.Message;
    } finally {
      isSavingUsername = false;
    }
  }

  private async Task CopyUsername() {
    await JS.InvokeVoidAsync("navigator.clipboard.writeText", currentUsername);
    Toasts.Show(Loc["settings_username_copied"]);
  }

  public void Dispose() {
    Loc.OnLanguageChanged -= HandleLanguageChanged;
  }
}
