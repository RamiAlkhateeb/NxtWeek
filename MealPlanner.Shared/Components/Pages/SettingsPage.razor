@page "/settings"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject IJSRuntime JS
@inject ILocalizationService Loc
@inject ThemeService Theme
@inject ToastService Toasts
@inject INutritionStore NutritionStore
@inject NavigationManager Nav
@implements IDisposable

@* Three groups: You (profile, meal times, tracking), App (language, look, install, Advanced with the
   Gemini key) and Account. Friends opens from the Week header. *@
<div class="mk-page mk-settings" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <div class="mk-title-block"><h1 class="mk-title">@Loc["settings_title"]</h1></div>
        </div>
    </header>

    <main class="mk-stack">
        <h2 class="mk-set-section">@Loc["settings_you"]</h2>
        <section class="mk-set-card mk-set-list">
            <a class="mk-set-item" href="settings/profile">
                <span class="mk-set-icon is-accent" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg></span>
                <span class="mk-set-link-copy">
                    <strong>@Loc["nut_profile"]</strong>
                    <span>@Loc.T("nut_profile_meta", Loc.Num(nutrition.Age), Loc.Num(nutrition.HeightCm), Loc.Num(nutrition.WeightKg))</span>
                    <span>@Loc.T("settings_targets_meta", Loc.Num(targets.Kcal), Loc.Num(targets.Protein))</span>
                </span>
                <svg class="i mk-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </a>
            <a class="mk-set-item" href="settings/meals">
                <span class="mk-set-icon" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                <span class="mk-set-link-copy">
                    <strong>@Loc["nut_meal_times"]</strong>
                    <span>@Loc.T("settings_meals_a_day", DayMath.SlotsFor(prefs).Count)</span>
                </span>
                <svg class="i mk-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </a>
            <div class="mk-set-item">
                <span class="mk-set-icon" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
                <span class="mk-set-link-copy"><strong id="set-macros">@Loc["settings_track_macros"]</strong><span>@Loc["settings_track_macros_hint"]</span></span>
                <ToggleSwitch Checked="prefs.TrackMacros" Label="@Loc["settings_track_macros"]" CheckedChanged="SetTrackMacrosAsync" />
            </div>
            <div class="mk-set-item">
                <span class="mk-set-icon is-night" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M20 14A8 8 0 1 1 10 4a6.5 6.5 0 0 0 10 10z"/></svg></span>
                <span class="mk-set-link-copy"><strong>@Loc["settings_ramadan"]</strong><span>@Loc["settings_ramadan_hint"]</span></span>
                <ToggleSwitch Checked="prefs.Ramadan" Label="@Loc["settings_ramadan"]" CheckedChanged="SetRamadanAsync" />
            </div>
            <a class="mk-set-item" href="setup">
                <span class="mk-set-icon" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg></span>
                <span class="mk-set-link-copy"><strong>@Loc["settings_setup_again"]</strong><span>@Loc["settings_setup_again_sub"]</span></span>
                <svg class="i mk-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </a>
        </section>

        <h2 class="mk-set-section">@Loc["settings_app"]</h2>
        <section class="mk-set-card">
            <h3>@Loc["settings_lang_title"]</h3>
            <div class="mk-seg is-inset" role="radiogroup" aria-label="@Loc["settings_lang_title"]">
                @foreach (var language in Loc.AvailableLanguages)
                {
                    var code = language.Code;
                    <button role="radio" aria-checked="@(Loc.CurrentLanguage == code)" class="@(Loc.CurrentLanguage == code ? "is-active" : "")" @onclick="() => Loc.SetLanguageAsync(code)">@language.NativeName</button>
                }
            </div>
            <h3>@Loc["settings_theme_title"]</h3>
            <div class="mk-seg is-inset" role="radiogroup" aria-label="@Loc["settings_theme_title"]">
                @foreach (var mode in new[] { "system", "light", "dark" })
                {
                    var value = mode;
                    <button role="radio" aria-checked="@(themeMode == value)" class="@(themeMode == value ? "is-active" : "")" @onclick="() => SetThemeAsync(value)">@Loc["settings_theme_" + value]</button>
                }
            </div>
        </section>

        <a class="mk-set-link" href="settings/install">
            <span class="mk-set-link-copy"><strong>@Loc["settings_install_title"]</strong><span>@Loc["settings_install_desc"]</span></span>
            <svg class="i mk-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </a>

        <section class="mk-set-card is-flush">
            <button class="mk-set-toggle" aria-expanded="@showAdvanced" @onclick="() => showAdvanced = !showAdvanced">
                <span>@Loc["settings_advanced"]</span>
                <svg class="i mk-past-chev @(showAdvanced ? "is-open" : "")" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            @if (showAdvanced)
            {
                <div class="mk-set-advanced"><AiSection /><p class="mk-set-hint is-ai-key">@Loc["nut_ai_key_optional"]</p><MealPhotosBulk /><AboutSection /></div>
            }
            else
            {
                <p class="mk-set-hint">@Loc["settings_advanced_hint"]</p>
            }
        </section>

        <h2 class="mk-set-section">@Loc["nut_account"]</h2>
        <section class="mk-set-card">
            <div class="mk-set-row is-spread">
                <span class="mk-set-link-copy">
                    <span>@(signedInEmail is { Length: > 0 } ? Loc.T("nut_signed_as", signedInEmail) : Loc["nut_signed_out"])</span>
                    <span class="mk-set-hint">@Loc["nut_privacy"]</span>
                </span>
                @if (signedInEmail is { Length: > 0 })
                {
                    <button class="mk-btn is-soft is-sm" @onclick="SignOutAsync">@Loc["nut_sign_out"]</button>
                }
                else
                {
                    <a class="mk-btn is-soft is-sm" href="signin">@Loc["nut_sign_in"]</a>
                }
            </div>
        </section>

        <section class="mk-set-card">
            <h3>@Loc["settings_username_title"]</h3>
            @if (hasUsername)
            {
                <div class="mk-set-row">
                    <code class="mk-set-code" dir="ltr">@currentUsername</code>
                    <button class="mk-square-btn" aria-label="@Loc["copy"]" @onclick="CopyUsername">
                        <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/></svg>
                    </button>
                </div>
                @if (!editingUsername)
                {
                    <button class="mk-link-btn is-block-start" @onclick="() => editingUsername = true">@Loc["settings_username_change"]</button>
                }
            }
            else
            {
                <p class="mk-subtitle">@Loc["settings_username_prompt"]</p>
            }
            @if (!hasUsername || editingUsername)
            {
                <div class="mk-set-row">
                    <input class="mk-input" dir="ltr" autocomplete="off" aria-label="@(hasUsername ? Loc["settings_username_change"] : Loc["settings_username_choose"])" @bind="usernameInput" @bind:event="oninput" @onblur="CheckUsername" placeholder="@Loc["settings_username_placeholder"]" />
                    <button class="mk-square-btn is-ink" aria-label="@Loc["save"]" @onclick="SaveUsername" disabled="@isSavingUsername">
                        <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    </button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(usernameFeedback)) { <p class="mk-notice @(usernameError ? "is-error" : "")">@usernameFeedback</p> }
        </section>

        <a class="mk-set-link" href="settings/recover">
            <span class="mk-set-link-copy"><strong>@Loc["settings_recover_title"]</strong><span>@Loc["settings_recover_desc"]</span></span>
            <svg class="i mk-chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </a>

    </main>
</div>

@code {
  private string uid = "";
  private string currentUsername = "";
  private string usernameInput = "";
  private string usernameFeedback = "";
  private bool usernameError;
  private bool isSavingUsername;
  private bool editingUsername;
  private bool showAdvanced;
  private string themeMode = "system";
  private bool hasUsername => !string.IsNullOrWhiteSpace(currentUsername);
  private NutritionProfile nutrition = new();
  private DailyTargets targets = TargetCalculator.For(new NutritionProfile());
  private MealPrefs prefs = new();
  private string? signedInEmail;

  protected override async Task OnInitializedAsync() {
    Loc.OnLanguageChanged += HandleLanguageChanged;
    // The assistant's "Open Settings" link lands here with the Gemini key and model showing.
    showAdvanced = new Uri(Nav.Uri).Query.Contains("advanced=1", StringComparison.OrdinalIgnoreCase);
    await Loc.InitializeAsync();
    var user = await Auth.GetCurrentUserAsync();
    if (user is null) return;
    uid = user.Uid;
    signedInEmail = user.IsGuest ? null : user.Email;
    themeMode = await Theme.GetAsync();
    try
    {
      var profileTask = UserService.GetProfileAsync(uid);
      var nutritionTask = NutritionStore.GetProfileAsync(uid);
      var prefsTask = NutritionStore.GetMealPrefsAsync(uid);
      await Task.WhenAll(profileTask, nutritionTask, prefsTask);
      prefs = await prefsTask;
      var profile = await profileTask;
      currentUsername = profile?.Username ?? "";
      nutrition = await nutritionTask ?? new NutritionProfile();
      targets = TargetCalculator.For(nutrition);
    }
    catch { /* offline: the cards show the defaults */ }
  }

  private async Task SetThemeAsync(string value) {
    themeMode = value;
    await Theme.SetAsync(value);
  }

  // Preferences, not health data: they save at once, for guests too.
  private Task SetTrackMacrosAsync(bool on) { prefs.TrackMacros = on; return SavePrefsAsync(); }
  private Task SetRamadanAsync(bool on) { prefs.Ramadan = on; return SavePrefsAsync(); }

  private async Task SavePrefsAsync() {
    if (string.IsNullOrEmpty(uid)) return;
    try { await NutritionStore.SaveMealPrefsAsync(uid, prefs); }
    catch { Toasts.Show(Loc["nut_save_error"], isError: true); }
  }

  private async Task SignOutAsync() {
    await Auth.SignOutAsync();
    Nav.NavigateTo("/signin", forceLoad: true);
  }

  private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

  private async Task CheckUsername() {
    usernameFeedback = "";
    if (string.IsNullOrWhiteSpace(usernameInput)) return;
    try {
      var available = await UserService.IsUsernameAvailableAsync(usernameInput, uid);
      usernameError = !available;
      usernameFeedback = available ? Loc["settings_username_available"] : Loc["settings_username_taken"];
    } catch (Exception ex) {
      usernameError = true;
      usernameFeedback = ex.Message;
    }
  }

  private async Task SaveUsername() {
    isSavingUsername = true;
    usernameFeedback = "";
    try {
      var username = await UserService.RenameUserAsync(uid, usernameInput);
      await Auth.SetActiveDataKeyAsync(username);
      currentUsername = username;
      uid = username;
      usernameInput = "";
      editingUsername = false;
      usernameError = false;
      Toasts.Show(Loc["settings_username_saved"]);
    } catch (Exception ex) {
      usernameError = true;
      usernameFeedback = ex.Message;
    } finally {
      isSavingUsername = false;
    }
  }

  private async Task CopyUsername() {
    await JS.InvokeVoidAsync("navigator.clipboard.writeText", currentUsername);
    Toasts.Show(Loc["settings_username_copied"]);
  }

  public void Dispose() {
    Loc.OnLanguageChanged -= HandleLanguageChanged;
  }
}
