@page "/meal/{MealId}"
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Models
@inject IJSRuntime JS
@inject IMealCatalogService CatalogService
@inject IUserService UserService
@inject IAuthService Auth
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="app meal-details-container" dir="@Loc.Direction">
    <div class="back-nav">
        <button class="back-btn" @onclick="GoBack">❌ @Loc["close"]</button>
    </div>

    @if (isLoading)
    {
        <p style="padding: 24px; text-align: center; color: #777">@(Loc.IsArabic ? "جارِ التحميل..." : "Loading...")</p>
    }
    else if (meal is null)
    {
        <div style="padding: 24px; text-align: center;">
            <p style="color: #777; margin-bottom: 16px;">@(Loc.IsArabic ? "لم يتم العثور على تفاصيل الوجبة." : "Meal details not found.")</p>
            <button class="primary-btn" @onclick="GoBack">@(Loc.IsArabic ? "العودة للرئيسية" : "Back to Home")</button>
        </div>
    }
    else
    {
        <div class="meal-details-hero">
            <div class="meal-type-icon">🍳</div>
            <h1 class="meal-title">@meal.Name</h1>
            <div class="badges-row">
                <span class="badge type-badge">@Loc.GetMealTypeName(meal.MealType)</span>
                @if (isFavorite)
                {
                    <span class="badge favorite-badge">⭐ @(Loc.IsArabic ? "مفضلة" : "Favorite")</span>
                }
            </div>
        </div>

        <div class="details-body">
            <div class="details-section">
                <h2>🛒 @Loc["meal_ingredients"]</h2>
                @if (meal.Ingredients == null || meal.Ingredients.Count == 0)
                {
                    <p class="empty-text">@(Loc.IsArabic ? "لم يتم تحديد مكونات بعد لهذه الوجبة." : "No ingredients specified yet.")</p>
                }
                else
                {
                    <ul class="ingredients-list">
                        @foreach (var ing in meal.Ingredients)
                        {
                            <li>
                                <span class="bullet">🔹</span>
                                <span class="text">@ing</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="details-section">
                <h2>🥗 @Loc["meal_side_dishes"]</h2>
                @if (meal.SideDishes == null || meal.SideDishes.Count == 0)
                {
                    <p class="empty-text">@(Loc.IsArabic ? "لم يتم اختيار أطباق جانبية بعد." : "No side dishes specified yet.")</p>
                }
                else
                {
                    <div class="side-dishes-chips">
                        @foreach (var sd in meal.SideDishes)
                        {
                            <span class="side-dish-chip">@sd</span>
                        }
                    </div>
                }
            </div>

            <div class="action-buttons">
                <button class="favorite-toggle-btn @(isFavorite ? "active" : "")" @onclick="ToggleFavorite">
                    @(isFavorite ? (Loc.IsArabic ? "⭐ إزالة من المفضلة" : "⭐ Remove from Favorites") : (Loc.IsArabic ? "☆ إضافة للمفضلة" : "☆ Add to Favorites"))
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string MealId { get; set; } = string.Empty;

    private MealCatalogItem? meal;
    private bool isFavorite = false;
    private bool isLoading = true;
    private string uid = "";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }

        uid = user.Uid;
        meal = await CatalogService.GetMealByIdAsync(MealId);
        
        if (meal != null)
        {
            var profile = await UserService.GetProfileAsync(uid);
            isFavorite = profile?.FavoriteMealIds?.Contains(meal.Id) ?? false;
        }

        isLoading = false;
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }

    private async Task ToggleFavorite()
    {
        if (meal == null || string.IsNullOrEmpty(uid)) return;
        
        await UserService.ToggleFavoriteMealAsync(uid, meal.Id);
        isFavorite = !isFavorite;
    }
}
