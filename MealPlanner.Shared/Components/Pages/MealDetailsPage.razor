@page "/meal/{MealId}"
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Models
@inject IJSRuntime JS
@inject IMealCatalogService CatalogService
@inject IUserService UserService
@inject IAuthService Auth
@inject IMealAssignService Assigner
@inject IDayPlanService DayPlan
@inject INutritionStore NutritionStore
@inject IMealImageService MealImages
@inject IMealPhotoService Photos
@inject IRecipeService Recipes
@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject ToastService Toasts
@inject UndoService Undo
@inject IMealDetailsService MealDetails

<div class="mk-page mk-details" dir="@Loc.Direction">
    @if (isLoading)
    {
        <div class="mk-stack"><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (meal is null)
    {
        <header class="mk-header"><div class="mk-header-row">
            <button class="mk-icon-btn" aria-label="@Loc["meal_close"]" @onclick="Close"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div></header>
        <NxtEmptyState Icon="🍽️" Title="@Loc["meal_not_found"]">
            <a class="mk-btn" href="">@Loc["meal_back_home"]</a>
        </NxtEmptyState>
    }
    else
    {
        var hasOwnPhoto = MealImages.HasPhoto(meal.Id);
        <section class="mk-details-hero mk-tile @MealTypeStyle.T(meal.MealType)" aria-busy="@(isGenerating ? "true" : "false")">
            <MealPhoto Meal="meal" Alt="@meal.Name" Lazy="false" />
            <button class="mk-icon-btn mk-hero-float is-start" aria-label="@Loc["meal_close"]" @onclick="Close">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
            <button class="mk-icon-btn mk-hero-float is-end @(isFavorite ? "is-fav" : "")" aria-pressed="@isFavorite" aria-label="@(isFavorite ? Loc["meal_remove_favorite_short"] : Loc["meal_favorite"])" @onclick="ToggleFavorite">
                <svg viewBox="0 0 24 24" fill="@(isFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-8-5-9.5-10A5 5 0 0 1 12 7a5 5 0 0 1 9.5 4C20 16 12 21 12 21z"/></svg>
            </button>
            <div class="mk-hero-photo">
                @if (!hasOwnPhoto)
                {
                    <button class="mk-pill-btn" disabled="@isGenerating" @onclick="GeneratePhotoAsync">
                        @if (isGenerating) { <span class="nxt-dots" aria-hidden="true"><i></i><i></i><i></i></span> @Loc["nut_photo_making"] }
                        else
                        {
                            <svg class="i" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                            @(hasSharedPhoto ? Loc["nut_photo_remake"] : Loc["nut_photo_make"])
                        }
                    </button>
                }
                @if (hasOwnPhoto)
                {
                    <button class="mk-pill-btn" aria-label="@Loc["meal_remove_photo"]" @onclick="RemovePhoto">
                        <svg class="i" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                }
                <button class="mk-pill-btn" disabled="@isSavingPhoto" @onclick="AddPhoto">
                    <svg class="i" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                    @(hasOwnPhoto ? Loc["meal_change_photo"] : Loc["meal_add_photo"])
                </button>
            </div>
        </section>

        @if (photoError is { Length: > 0 })
        {
            <div class="mk-notice is-error mk-photo-error" role="alert">@Loc.T("nut_photo_failed", photoError)</div>
        }
        <div class="mk-details-body">
            <div class="mk-details-titleblock">
                <div class="mk-details-title-row">
                    <span class="mk-type-label @MealTypeStyle.T(meal.MealType)">@Loc.GetMealTypeName(meal.MealType)</span>
                    <button type="button" class="mk-pill-btn mk-edit-meal" @onclick="OpenEdit">
                        <svg class="i" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>@Loc["meal_edit"]
                    </button>
                </div>
                <h1 class="mk-details-name">@meal.Name</h1>
            </div>

            <div class="mk-details-days">
                <span class="mk-label">@Loc["meal_add_to_day_label"]</span>
                <div class="mk-chip-row is-days" style="margin-inline:-20px;padding-inline:20px">
                    @foreach (var day in days)
                    {
                        <button class="mk-daychip @(day == selectedDay ? "is-active" : "")" aria-pressed="@(day == selectedDay)" aria-label="@Loc.FormatDayDate(day)" @onclick="() => selectedDay = day">
                            <span>@Loc.GetDayAbbr(day.DayOfWeek)</span>
                            <b>@day.Day</b>
                            @if (planned.Contains(day)) { <i class="mk-daychip-dot"></i> }
                        </button>
                    }
                </div>
            </div>

            <div class="mk-card mk-details-card">
                <MealNutritionPanel Meal="meal" OnSaved="_ => StateHasChanged()" />
            </div>

            <div class="mk-card mk-details-card">
                <MealIngredientRows Ingredients="meal.Ingredients" MealName="@meal.Name" />
            </div>

            <section class="mk-card mk-details-card mk-steps" aria-labelledby="steps-h">
                <div class="mk-steps-head">
                    <h2 id="steps-h" class="mk-shop-h">@Loc["nut_steps"]</h2>
                    @if (meal.Steps.Count > 0) { <button class="mk-link-btn" @onclick="OpenSteps">@Loc["meal_edit"]</button> }
                </div>
                @if (meal.Steps.Count > 0)
                {
                    <ol class="mk-step-list">
                        @foreach (var step in meal.Steps)
                        {
                            <li>
                                <span>@step.Text</span>
                                @if (step.Minutes is { } min) { <span class="mk-tag">@Loc.T("nut_dur_min", Loc.Num(min))</span> }
                            </li>
                        }
                    </ol>
                    <a class="mk-btn is-block" href="@($"meal/{Uri.EscapeDataString(meal.Id)}/cook")">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>@Loc["nut_cook_start"]
                    </a>
                }
                else
                {
                    <p class="mk-subtitle">@Loc["nut_steps_none"]</p>
                    <div class="mk-btn-row">
                        <button class="mk-btn" disabled="@isFetchingSteps" @onclick="() => FetchStepsAsync(false)">
                            @if (isFetchingSteps) { <span class="nxt-dots" aria-hidden="true"><i></i><i></i><i></i></span> @Loc["nut_steps_fetching"] }
                            else { <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>@Loc["nut_steps_get"] }
                        </button>
                        <button class="mk-btn is-soft" @onclick="OpenSteps">@Loc["nut_steps_write"]</button>
                    </div>
                }
                @if (stepsError is { Length: > 0 }) { <div class="mk-notice is-error" role="alert">@stepsError</div> }
            </section>

            @if (meal.SideDishes is { Count: > 0 })
            {
                <div class="mk-sides">
                    <span class="mk-label">@Loc["meal_serves_with"]</span>
                    @foreach (var side in meal.SideDishes) { <span class="mk-pill">@side</span> }
                </div>
            }
        </div>

        <div class="mk-details-cta">
            @if (pickSlot is { } ps)
            {
                <button class="mk-btn is-lg is-block" disabled="@isAdding" @onclick="() => AddToSlot(ps)">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>@Loc.T("nut_add_to", Loc[mealPrefs.NameKey(ps)])
                </button>
            }
            else
            {
                var empty = EmptySlotsOf(selectedDay);
                @if (empty.Count == 0)
                {
                    <p class="mk-subtitle mk-cta-note">@Loc["nut_nothing_open"]</p>
                }
                else
                {
                    <div class="mk-cta-slots" role="group" aria-label="@Loc.FormatDayDate(selectedDay)">
                        @foreach (var slot in empty)
                        {
                            var sl = slot;
                            <button class="mk-btn" disabled="@isAdding" @onclick="() => AddToSlot(sl)">
                                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>@Loc[mealPrefs.NameKey(sl)]
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

<NxtBottomSheet IsOpen="showSteps" Title="@Loc["nut_steps"]" Eyebrow="@meal?.Name" OnDismiss="() => showSteps = false">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <label class="mk-label" for="steps-text">@Loc["nut_steps_hint"]</label>
        <textarea id="steps-text" class="mk-input mk-steps-text" rows="8" @bind="stepsText" @bind:event="oninput"></textarea>
        <button class="mk-btn is-lg is-block" disabled="@isSavingSteps" @onclick="SaveStepsAsync">@Loc["save"]</button>
        @if (meal?.Steps.Count > 0)
        {
            <button class="mk-btn is-soft is-block" disabled="@isFetchingSteps" @onclick="() => FetchStepsAsync(true)">@Loc["nut_steps_get_again"]</button>
        }
    </div>
</NxtBottomSheet>

<NxtBottomSheet IsOpen="showEdit" Title="@Loc["meals_edit_meal"]" Eyebrow="@Loc["meals_edit_eyebrow"]" OnDismiss="() => showEdit = false">
    @if (askRecalc && meal is not null)
    {
        @* After a new name: offer to ask Gemini again, so ingredients and nutrition fit the new dish. *@
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <p class="mk-recalc-q">@Loc.T("nut_recalc_q", meal.Name)</p>
            @if (meal.Nutrition is { IsEstimate: false }) { <p class="mk-subtitle">@Loc["nut_recalc_manual_note"]</p> }
            <button class="mk-btn is-lg is-block" disabled="@isRecalculating" @onclick="RecalculateAsync">
                @if (isRecalculating)
                {
                    <span class="mk-busy-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span role="status">@Loc["nut_filling_details"]</span>
                }
                else
                {
                    @Loc["nut_recalc"]
                }
            </button>
            <button class="mk-btn is-soft is-block" disabled="@isRecalculating" @onclick="KeepAsIs">@Loc["nut_recalc_keep"]</button>
        </div>
    }
    else
    {
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <label class="mk-search"><input placeholder="@Loc["meals_meal_name"]" aria-label="@Loc["meals_meal_name"]" @bind="editName" @bind:event="oninput" /></label>
        <div class="mk-chip-wrap" role="group" aria-label="@Loc["meals_meal_type"]">
            @foreach (var type in AllTypes)
            {
                <button class="mk-chip @(editType == type ? "is-active" : "")" @onclick="() => editType = type">@Loc.GetMealTypeName(type)</button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(editError)) { <div class="mk-notice is-error">@editError</div> }
        <button class="mk-btn is-lg is-block" disabled="@string.IsNullOrWhiteSpace(editName)" @onclick="SaveEdit">@Loc["meals_save_changes"]</button>
        @* A meal you added can be deleted; a shared built-in meal can only be hidden. Either way it leaves the library
           (IsArchived), so days that already use it keep showing it, and Undo brings it back. *@
        @if (!confirmDelete)
        {
            <button class="mk-btn is-soft is-block is-danger-text" @onclick="() => confirmDelete = true">@(IsMine ? Loc["meals_delete_meal"] : Loc["meals_hide_meal"])</button>
        }
        else
        {
            <div class="mk-notice is-warn" role="alert">@(IsMine ? Loc["meals_delete_confirm"] : Loc["meals_hide_confirm"])</div>
            <div class="mk-btn-row">
                <button class="mk-btn is-soft" @onclick="() => confirmDelete = false">@Loc["cancel"]</button>
                <button class="mk-btn is-danger-fill" @onclick="HideMeal">@(IsMine ? Loc["meals_delete_meal"] : Loc["meals_hide_meal"])</button>
            </div>
        }
    </div>
    }
</NxtBottomSheet>

@code {
    [Parameter] public string MealId { get; set; } = string.Empty;

    private static readonly MealType[] AllTypes = [MealType.Meat, MealType.Chicken, MealType.Fish, MealType.Vegetarian];

    private MealCatalogItem? meal;
    private bool isFavorite;
    private bool isLoading = true;
    private bool isAdding;
    private bool isSavingPhoto, isGenerating, hasSharedPhoto;
    private bool showSteps, isFetchingSteps, isSavingSteps;
    private string stepsText = "";
    private string? stepsError;

    private void OpenSteps()
    {
        stepsText = RecipeSteps.ToText(meal?.Steps ?? [], Loc["nut_steps_minutes"]);
        stepsError = null;
        showSteps = true;
    }

    private async Task SaveStepsAsync()
    {
        if (meal is null) return;
        isSavingSteps = true;
        try
        {
            await Recipes.SaveStepsAsync(meal, RecipeSteps.Parse(stepsText));
            showSteps = false;
        }
        catch { stepsError = Loc["nut_save_error"]; }
        finally { isSavingSteps = false; }
    }

    // Free steps from the photo worker's text model, written in the meal's own language.
    private async Task FetchStepsAsync(bool replace)
    {
        if (meal is null || isFetchingSteps) return;
        isFetchingSteps = true;
        stepsError = null;
        try
        {
            await Recipes.FetchStepsAsync(meal, replace);
            showSteps = false;
        }
        catch (Exception ex) { stepsError = MealPhotoException.Describe(Loc, ex); showSteps = false; }
        finally { isFetchingSteps = false; }
    }
    private string? photoError;
    private string uid = "";
    private List<DateOnly> days = new();
    private HashSet<DateOnly> planned = new();
    private Dictionary<DateOnly, PlanDay> plan = new();
    private MealPrefs mealPrefs = new();
    // Pick mode from an empty slot on Week: ?day=...&slot=Meal1
    private MealSlot? pickSlot;
    private DateOnly selectedDay;

    private bool showEdit;
    private string editName = "";
    private string editError = "";
    private MealType editType;

    protected override async Task OnInitializedAsync()
    {
        await Loc.InitializeAsync();
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrEmpty(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;

        await MealImages.EnsureLoadedAsync();
        meal = await CatalogService.GetMealByIdAsync(MealId);
        if (meal is not null)
        {
            var profile = await UserService.GetProfileAsync(uid);
            isFavorite = profile?.FavoriteMealIds?.Contains(meal.Id) ?? false;
            try { hasSharedPhoto = await Photos.HasAsync(meal.Id); }
            catch { hasSharedPhoto = false; }

            var today = DateOnly.FromDateTime(DateTime.Today);
            days = Enumerable.Range(0, 14).Select(i => today.AddDays(i)).ToList();
            plan = await DayPlan.GetDaysAsync(uid, days[0], days[^1]);
            planned = plan.Where(d => d.Value.Slots.Count > 0).Select(d => d.Key).ToHashSet();
            mealPrefs = await NutritionStore.GetMealPrefsAsync(uid);
            var slotQuery = QueryValue("slot=");
            if (slotQuery is not null && Enum.TryParse<MealSlot>(slotQuery, out var slot)) pickSlot = slot;

            // Preselect the day we came from; otherwise the first free day, otherwise today.
            var cameFrom = QueryDay();
            if (cameFrom is { } d && d >= today)
            {
                if (!days.Contains(d)) days.Add(d);
                selectedDay = d;
            }
            else selectedDay = days.FirstOrDefault(x => EmptySlotsOf(x).Count > 0, today);
        }
        isLoading = false;
    }

    private DateOnly? QueryDay() => DateOnly.TryParse(QueryValue("day="), out var parsed) ? parsed : null;

    private string? QueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query;
        var i = query.IndexOf(key, StringComparison.OrdinalIgnoreCase);
        return i >= 0 ? query[(i + key.Length)..].Split('&')[0] : null;
    }

    private IReadOnlyList<MealSlot> EmptySlotsOf(DateOnly date)
    {
        var day = plan.GetValueOrDefault(date);
        return DayMath.EmptySlots(day, mealPrefs);
    }

    private async Task Close() => await JS.InvokeVoidAsync("nxtweek.goBack", "/");

    private async Task ToggleFavorite()
    {
        if (meal is null || string.IsNullOrEmpty(uid)) return;
        await UserService.ToggleFavoriteMealAsync(uid, meal.Id);
        isFavorite = !isFavorite;
    }

    private async Task AddToSlot(MealSlot slot)
    {
        if (meal is null) return;
        isAdding = true;
        try
        {
            await Assigner.AssignAsync(uid, selectedDay, meal, slot);
            var message = Uri.EscapeDataString(Loc.T("nut_added_toast", Loc[mealPrefs.NameKey(slot)]));
            Nav.NavigateTo($"/?day={selectedDay:yyyy-MM-dd}&toast={message}");
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, isError: true);
        }
        finally { isAdding = false; }
    }

    // An AI photo for everyone, drawn for free by the photo worker. Shown as the meal's picture wherever it appears.
    private async Task GeneratePhotoAsync()
    {
        if (meal is null || isGenerating) return;
        isGenerating = true;
        photoError = null;
        try
        {
            await Photos.GenerateAsync(meal, replace: hasSharedPhoto);
            hasSharedPhoto = true;
            Toasts.Show(Loc["nut_photo_made"]);
        }
        catch (Exception ex) { photoError = MealPhotoException.Describe(Loc, ex); }
        finally { isGenerating = false; }
    }

    private async Task AddPhoto()
    {
        if (meal is null) return;
        isSavingPhoto = true;
        try
        {
            var dataUrl = await JS.InvokeAsync<string?>("nxtweek.pickPhoto", 480);
            if (string.IsNullOrEmpty(dataUrl)) return;
            await MealImages.SetPhotoAsync(meal.Id, dataUrl);
            Toasts.Show(Loc["meal_photo_private"]);
        }
        catch
        {
            Toasts.Show(Loc["meal_photo_failed"], isError: true);
        }
        finally { isSavingPhoto = false; }
    }

    private async Task RemovePhoto()
    {
        if (meal is null) return;
        try { await MealImages.RemovePhotoAsync(meal.Id); }
        catch { Toasts.Show(Loc["meal_photo_failed"], isError: true); }
    }

    private bool confirmDelete, askRecalc, isRecalculating;
    private bool IsMine => meal is not null && !string.IsNullOrEmpty(uid) && meal.CreatedBy == uid;

    private void OpenEdit()
    {
        if (meal is null) return;
        confirmDelete = false;
        askRecalc = false;
        editName = meal.Name;
        editType = meal.MealType;
        editError = "";
        showEdit = true;
    }

    private async Task SaveEdit()
    {
        if (meal is null) return;
        var name = editName.Trim();
        if (name.Length == 0) { editError = Loc["meals_name_required"]; return; }
        var renamed = !string.Equals(name, meal.Name, StringComparison.Ordinal);
        try
        {
            meal.Name = name;
            meal.MealType = editType;
            await CatalogService.UpdateMealAsync(meal);
        }
        catch { editError = Loc["nut_save_error"]; return; }

        // A new name usually means a different dish: offer to recalculate with Gemini (the user's key).
        if (renamed && await MealDetails.IsAvailableAsync()) { askRecalc = true; return; }
        showEdit = false;
        Toasts.Show(renamed ? $"{Loc["meals_meal_updated"]} {Loc["nut_recalc_no_key"]}" : Loc["meals_meal_updated"]);
    }

    private void KeepAsIs()
    {
        askRecalc = false;
        showEdit = false;
        Toasts.Show(Loc["meals_meal_updated"]);
    }

    // Clears and refills a fresh copy of the meal, so a failed answer never leaves it half cleared.
    private async Task RecalculateAsync()
    {
        if (meal is null) return;
        isRecalculating = true;
        try
        {
            var copy = await CatalogService.GetMealByIdAsync(meal.Id) ?? meal;
            MealDetailsMapper.ForgetForNewName(copy);
            var result = await MealDetails.FillMissingAsync(copy);
            if (result == MealDetailsResult.Filled)
            {
                meal = await CatalogService.GetMealByIdAsync(meal.Id) ?? copy;
                Toasts.Show(Loc["nut_recalc_done"]);
            }
            else Toasts.Show(Loc["nut_recalc_failed"], isError: true);
        }
        catch { Toasts.Show(Loc["nut_recalc_failed"], isError: true); }
        finally
        {
            isRecalculating = false;
            askRecalc = false;
            showEdit = false;
        }
    }

    private async Task HideMeal()
    {
        if (meal is null) return;
        try
        {
            var removed = meal;
            removed.IsArchived = true;
            await CatalogService.UpdateMealAsync(removed);
            showEdit = false;
            Toasts.Hide();
            Undo.Offer(Loc.T(IsMine ? "meals_meal_deleted" : "meals_meal_hidden_named", removed.Name), async () =>
            {
                removed.IsArchived = false;
                await CatalogService.UpdateMealAsync(removed);
            });
            await Close();
        }
        catch (Exception ex) { editError = ex.Message; }
    }
}
