@page "/settings/recover"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="app app-content-wrapper recover-page" dir="@Loc.Direction">
    <UiPageHeader Icon="🔁" Title="@Loc["settings_recover_title"]" Subtitle="@Loc["recover_subtitle"]" />

    <section class="recover-intro">
        <p>@Loc["recover_intro"]</p>
    </section>

    <section class="recover-form-section">
        <label for="recover-username">@Loc["recover_prev_username"]</label>
        <div class="friend-add-form">
            <input id="recover-username" class="ui-text-input" dir="ltr" @bind="usernameInput" @bind:event="oninput" placeholder="@Loc["settings_username_placeholder"]" autocomplete="off" />
            <button class="friend-add-button" @onclick="Lookup" disabled="@(isBusy || string.IsNullOrWhiteSpace(usernameInput))" aria-label="@Loc["search"]">🔍</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(feedback))
        {
            <p class="friend-feedback @(isError ? "error" : "")">@feedback</p>
        }
    </section>

    @if (foundProfile is not null)
    {
        <section class="recover-found">
            <div class="friend-avatar">@Initial(foundProfile.DisplayName)</div>
            <div class="recover-found-copy">
                <strong>@foundProfile.DisplayName</strong>
                <small dir="ltr">@@@foundProfile.Username</small>
            </div>
        </section>

        <p class="recover-warning">⚠️ @Loc.T("recover_warning", foundProfile.Username)</p>

        <div class="recover-actions">
            <UiButton Variant="primary" OnClick="ConfirmRecovery" Disabled="@isBusy">@(isBusy ? Loc["recover_busy"] : Loc["recover_now"])</UiButton>
            <UiButton Variant="ghost" OnClick="ResetFound">@Loc["cancel"]</UiButton>
        </div>
    }

    <button class="recover-back-button" @onclick="GoBack">@Loc["recover_back"]</button>
</div>

@code {
    private string uid = "";
    private string usernameInput = "";
    private string feedback = "";
    private bool isError;
    private bool isBusy;
    private UserProfile? foundProfile;

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        uid = user.Uid;
    }

    private async Task Lookup()
    {
        feedback = "";
        isError = false;
        foundProfile = null;
        var username = usernameInput.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(username)) return;

        if (string.Equals(uid, username, StringComparison.OrdinalIgnoreCase))
        {
            feedback = Loc["recover_already_using"];
            return;
        }

        isBusy = true;
        try
        {
            var profile = await UserService.GetNamedProfileAsync(username);
            if (profile is null)
            {
                isError = true;
                feedback = Loc["recover_not_found"];
                return;
            }
            foundProfile = profile;
            feedback = "";
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
        }
        finally { isBusy = false; }
    }

    private async Task ConfirmRecovery()
    {
        if (foundProfile is null) return;
        isBusy = true;
        feedback = "";
        try
        {
            await Auth.SetActiveDataKeyAsync(foundProfile.Username);
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
            isBusy = false;
        }
    }

    private void ResetFound() { foundProfile = null; feedback = ""; isError = false; }
    private void GoBack() => Nav.NavigateTo("/settings");

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[0].ToString();
}
