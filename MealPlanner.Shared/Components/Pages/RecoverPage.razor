@page "/settings/recover"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="app app-content-wrapper recover-page" dir="@Loc.Direction">
    <UiPageHeader Icon="🔁" Title="@Loc["settings_recover_title"]" Subtitle="@(Loc.IsArabic ? "أعد فتح خطتك باسم المستخدم بعد مسح بيانات المتصفح أو على جهاز جديد" : "Restore your plan with your username after clearing browser data or on a new device")" />

    <section class="recover-intro">
        <p>@(Loc.IsArabic ? "إذا اخترت اسم مستخدم سابقاً ثم حُذفت بيانات المتصفح (أو أضفت التطبيق من جديد)، يمكنك استعادة كل خططك ووجباتك بكتابة اسم المستخدم نفسه الذي اخترته سابقاً." : "If you previously set a username and browser data was cleared, you can recover all your plans and meals by typing the same username.")</p>
    </section>

    <section class="recover-form-section">
        <label for="recover-username">@(Loc.IsArabic ? "اسم المستخدم السابق" : "Previous Username")</label>
        <div class="friend-add-form">
            <input id="recover-username" class="ui-text-input" dir="ltr" @bind="usernameInput" @bind:event="oninput" placeholder="@Loc["settings_username_placeholder"]" autocomplete="off" />
            <button class="friend-add-button" @onclick="Lookup" disabled="@(isBusy || string.IsNullOrWhiteSpace(usernameInput))" aria-label="Search">🔍</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(feedback))
        {
            <p class="friend-feedback @(isError ? "error" : "")">@feedback</p>
        }
    </section>

    @if (foundProfile is not null)
    {
        <section class="recover-found">
            <div class="friend-avatar">@Initial(foundProfile.DisplayName)</div>
            <div class="recover-found-copy">
                <strong>@foundProfile.DisplayName</strong>
                <small dir="ltr">@@@foundProfile.Username</small>
            </div>
        </section>

        <p class="recover-warning">⚠️ @(Loc.IsArabic ? $"هذا الجهاز سيتحول الآن إلى حساب «{foundProfile.Username}». لا يلزم إعادة تسمية أي شيء، وستُعرض كل خططك المخزّنة في السحابة." : $"This device will switch to user '{foundProfile.Username}'. All your cloud-saved plans will be loaded.")</p>

        <div class="recover-actions">
            <UiButton Variant="primary" OnClick="ConfirmRecovery" Disabled="@isBusy">@(isBusy ? (Loc.IsArabic ? "جارٍ الاسترجاع..." : "Recovering...") : (Loc.IsArabic ? "استرجاع خطتي الآن" : "Recover My Plan Now"))</UiButton>
            <UiButton Variant="ghost" OnClick="ResetFound">@Loc["cancel"]</UiButton>
        </div>
    }

    <button class="recover-back-button" @onclick="GoBack">@(Loc.IsArabic ? "➔ العودة إلى الإعدادات" : "← Back to Settings")</button>
</div>

@code {
    private string uid = "";
    private string usernameInput = "";
    private string feedback = "";
    private bool isError;
    private bool isBusy;
    private UserProfile? foundProfile;

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        uid = user.Uid;
    }

    private async Task Lookup()
    {
        feedback = "";
        isError = false;
        foundProfile = null;
        var username = usernameInput.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(username)) return;

        if (string.Equals(uid, username, StringComparison.OrdinalIgnoreCase))
        {
            feedback = Loc.IsArabic ? "أنت تستخدم اسم المستخدم هذا بالفعل على هذا الجهاز." : "You are already using this username on this device.";
            return;
        }

        isBusy = true;
        try
        {
            var profile = await UserService.GetNamedProfileAsync(username);
            if (profile is null)
            {
                isError = true;
                feedback = Loc.IsArabic ? "لم نعثر على حساب بهذا الاسم. تأكد أنك كتبت اسم المستخدم الذي اخترته سابقاً، مع العلم أن البيانات المخزّنة كضيف (بدون اسم مستخدم) لا يمكن استرجاعها." : "No account found with this username. Ensure you entered your previously registered username.";
                return;
            }
            foundProfile = profile;
            feedback = "";
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
        }
        finally { isBusy = false; }
    }

    private async Task ConfirmRecovery()
    {
        if (foundProfile is null) return;
        isBusy = true;
        feedback = "";
        try
        {
            await Auth.SetActiveDataKeyAsync(foundProfile.Username);
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            isError = true;
            feedback = ex.Message;
            isBusy = false;
        }
    }

    private void ResetFound() { foundProfile = null; feedback = ""; isError = false; }
    private void GoBack() => Nav.NavigateTo("/settings");

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[0].ToString();
}
