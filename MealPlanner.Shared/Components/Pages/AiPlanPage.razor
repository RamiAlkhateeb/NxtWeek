@page "/ai-plan"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@implements IDisposable
@inject IAuthService Auth
@inject IMealCatalogService CatalogService
@inject IMealAssignService Assigner
@inject IDayPlanService DayPlan
@inject INutritionStore NutritionStore
@inject IMealImageService MealImages
@inject ILocalizationService Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The assistant: two ready-made asks that run on the device from the user's own targets and meals
   ("Plan my protein for today", "Snack under 250 kcal with protein"). Each answer is a proposal card
   whose items can be removed before it is applied; nothing is saved until "Apply". *@
<div class="mk-page mk-ai" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <BackButton Fallback="/" />
            <div class="mk-ai-heading">
                <span class="mk-ai-badge" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" width="18" height="18"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg></span>
                <h1 class="mk-title is-md">@Loc["nut_assistant"]</h1>
            </div>
            <button class="mk-icon-btn" aria-label="@Loc["ai_new_chat"]" disabled="@(entries.Count == 0 || isBusy)" @onclick="() => entries.Clear()">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </div>
    </header>

    <div class="mk-ai-thread" aria-live="polite">
        @if (entries.Count == 0 && !isBusy)
        {
            <div class="mk-ai-empty">
                <span class="mk-ai-empty-icon" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span>
                <b>@Loc["nut_assistant"]</b>
                <p>@Loc.T("nut_assistant_for", Loc.FormatDayDate(askDate))</p>
            </div>
        }

        @foreach (var entry in entries)
        {
            @if (entry.IsUser)
            {
                <div class="mk-bubble is-user">@entry.Text</div>
            }
            else
            {
                <div class="mk-bubble is-ai @(entry.IsError ? "is-error" : "")" role="@(entry.IsError ? "alert" : null)">@entry.Text</div>
                @if (entry.Applied)
                {
                    <div class="mk-applied" role="status">
                        <span class="mk-applied-check" aria-hidden="true"><svg class="i" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12l5 5 9-10"/></svg></span>
                        <span>@entry.Summary</span>
                    </div>
                }
                else if (entry.Picks.Count > 0)
                {
                    <section class="mk-proposal" aria-label="@Loc["nut_proposal"]">
                        <div class="mk-proposal-head"><span class="mk-proposal-badge"><i></i>@Loc["nut_proposal"]</span></div>
                        <div class="mk-proposal-body">
                            @foreach (var pick in entry.Picks.ToList())
                            {
                                <div class="mk-proposal-row">
                                    <div class="mk-tile mk-proposal-tile @MealTypeStyle.T(pick.Meal.MealType)"><MealPhoto Meal="pick.Meal" Lazy="false" /></div>
                                    <div class="mk-proposal-text-col">
                                        <span class="mk-row-date">@Loc[prefs.NameKey(pick.Slot)]</span>
                                        <span class="mk-proposal-name">@pick.Meal.Name</span>
                                        <span class="mk-row-date">@Loc.T("nut_pick_line", pick.Meal.Name, Loc.Num(pick.Nutrition.Kcal), Loc.Num(pick.Nutrition.Protein))</span>
                                    </div>
                                    <button class="mk-icon-btn is-plain is-muted" aria-label="@Loc.T("nut_slot_entry", Loc["nut_proposal_remove"], pick.Meal.Name)" @onclick="() => entry.Picks.Remove(pick)">
                                        <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                                    </button>
                                </div>
                            }
                            <div class="mk-plan-total">@Loc.T("nut_plan_total", Loc.Num(entry.Picks.Sum(x => x.Nutrition.Protein)), Loc.Num(entry.Picks.Sum(x => x.Nutrition.Kcal)))</div>
                        </div>
                        <div class="mk-proposal-actions">
                            <button class="mk-btn" disabled="@isBusy" @onclick="() => ApplyAsync(entry)">
                                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>@Loc["nut_apply"]
                            </button>
                        </div>
                    </section>
                }
            }
        }

        @if (isBusy)
        {
            <div class="mk-bubble is-ai is-typing" role="status"><span class="nxt-dots"><i></i><i></i><i></i></span> @Loc["ai_thinking_label"]</div>
        }

        <div id="mk-ai-end" class="mk-ai-end"></div>
    </div>
</div>

<div class="mk-ai-composer" dir="@Loc.Direction">
    <div class="mk-chip-row is-wrap">
        <button class="mk-chip is-outline is-accent" disabled="@isBusy" @onclick="() => RunAsync(Ask.Protein)">@Loc["nut_plan_protein"]</button>
        @if (snackOn)
        {
            <button class="mk-chip is-outline is-accent" disabled="@isBusy" @onclick="() => RunAsync(Ask.Snack)">@Loc["nut_chip_snack"]</button>
        }
    </div>
</div>

@code {
    private enum Ask { Protein, Snack }

    private sealed class Entry
    {
        public bool IsUser { get; init; }
        public bool IsError { get; init; }
        public string Text { get; init; } = "";
        public DateOnly Date { get; init; }
        public List<PlannedPick> Picks { get; init; } = new();
        public bool Applied { get; set; }
        public string Summary { get; set; } = "";
    }

    private sealed record DayState(PlanDay? Day, IReadOnlyList<MealSlot> Slots, DayTotals Totals, MealPrefs Prefs, List<MealCatalogItem> Candidates);

    private readonly List<Entry> entries = new();
    private string uid = "";
    private bool isBusy, scrollPending, snackOn = true;
    private MealPrefs prefs = new();
    private DateOnly askDate = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguage;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) { Nav.NavigateTo("/signin"); return; }
        uid = user.Uid;

        // No snack chip for someone who turned the evening snack off.
        try { prefs = await NutritionStore.GetMealPrefsAsync(uid); snackOn = prefs.IsOn(MealSlot.Snack); }
        catch { /* keep the chip */ }

        // From Week's "Plan my day": ai-plan?ask=protein&day=yyyy-MM-dd
        var query = new Uri(Nav.Uri).Query;
        var i = query.IndexOf("day=", StringComparison.OrdinalIgnoreCase);
        if (i >= 0 && DateOnly.TryParse(query[(i + 4)..].Split('&')[0], out var d)) askDate = d;
        if (query.Contains("ask=protein", StringComparison.OrdinalIgnoreCase)) await RunAsync(Ask.Protein);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollPending) return;
        scrollPending = false;
        try { await JS.InvokeVoidAsync("nxtweek.scrollToId", "mk-ai-end", "end"); }
        catch (JSException) { /* purely cosmetic */ }
    }

    private void Add(Entry entry) { entries.Add(entry); scrollPending = true; }

    private async Task<DayState> LoadDayAsync(DateOnly date)
    {
        var profileTask = NutritionStore.GetProfileAsync(uid);
        var prefsTask = NutritionStore.GetMealPrefsAsync(uid);
        var daysTask = DayPlan.GetDaysAsync(uid, date, date);
        var catalogTask = CatalogService.GetAllMealsAsync();
        await Task.WhenAll(profileTask, prefsTask, daysTask, catalogTask);
        var profile = await profileTask ?? new NutritionProfile();
        var prefs = await prefsTask;
        var day = (await daysTask).GetValueOrDefault(date);
        var catalog = (await catalogTask).Where(m => !m.IsArchived).ToList();
        var nutrition = new Dictionary<string, NutritionInfo?>();
        foreach (var m in catalog) nutrition.TryAdd(m.Id, m.Nutrition);
        var totals = DayMath.Totals(day, TargetCalculator.For(profile), id => nutrition.GetValueOrDefault(id), prefs);
        var inLanguage = catalog.Where(m => string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, Loc.CurrentLanguage, StringComparison.OrdinalIgnoreCase)).ToList();
        return new DayState(day, DayMath.SlotsFor(prefs), totals, prefs, inLanguage.Count > 0 ? inLanguage : catalog);
    }

    private async Task RunAsync(Ask ask)
    {
        if (isBusy) return;
        Add(new Entry { IsUser = true, Text = ask == Ask.Protein ? Loc["nut_plan_protein"] : Loc["nut_chip_snack"] });
        isBusy = true;
        StateHasChanged();
        try
        {
            var date = askDate;
            var st = await LoadDayAsync(date);
            var empty = DayMath.EmptySlots(st.Day, st.Prefs);
            var used = Suggestions.UsedMealIds(st.Day, st.Slots);
            if (ask == Ask.Protein)
            {
                var plan = Suggestions.PlanProtein(empty, st.Totals.OpenKcal, st.Totals.OpenProtein, used, st.Candidates);
                if (plan is null)
                    Add(new Entry { Text = empty.Count == 0 ? Loc["nut_nothing_open"] : Loc["nut_no_fit"] });
                else
                    Add(new Entry
                    {
                        Date = date, Picks = plan.Picks.ToList(),
                        Text = Loc.T("nut_assistant_intro", Loc.Num(Math.Max(0, st.Totals.OpenKcal)), Loc.Num(Math.Max(0, st.Totals.OpenProtein)))
                    });
            }
            else if (!empty.Contains(MealSlot.Snack))
            {
                Add(new Entry { Text = Loc["nut_nothing_open"] });
            }
            else if (Suggestions.Snack(st.Totals.OpenKcal, used, st.Candidates) is { } snack)
            {
                Add(new Entry { Date = date, Text = Loc["nut_assistant_snack"], Picks = [new PlannedPick(MealSlot.Snack, snack.Meal, snack.Nutrition)] });
            }
            else
            {
                Add(new Entry { Text = Loc["nut_no_fit"] });
            }
        }
        catch { Add(new Entry { Text = Loc["nut_load_error"], IsError = true }); }
        finally { isBusy = false; scrollPending = true; }
    }

    private async Task ApplyAsync(Entry entry)
    {
        if (isBusy || entry.Applied) return;
        isBusy = true;
        try
        {
            // Only slots that are still empty: the day may have changed since the plan was made.
            var before = await LoadDayAsync(entry.Date);
            foreach (var pick in entry.Picks)
                if (before.Day is null || !before.Day.Slots.ContainsKey(pick.Slot))
                    await Assigner.AssignAsync(uid, entry.Date, pick.Meal, pick.Slot);
            var t = (await LoadDayAsync(entry.Date)).Totals;
            entry.Summary = Loc.T("nut_applied", Loc.Num(t.Eaten.Protein + t.Planned.Protein), Loc.Num(t.Eaten.Kcal + t.Planned.Kcal));
            entry.Applied = true;
        }
        catch { Add(new Entry { Text = Loc["nut_save_error"], IsError = true }); }
        finally { isBusy = false; scrollPending = true; }
    }

    private void OnLanguage() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.OnLanguageChanged -= OnLanguage;
}
