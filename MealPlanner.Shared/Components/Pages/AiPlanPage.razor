@page "/ai-plan"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IGeminiPlannerService GeminiPlanner
@inject IMealCatalogService CatalogService
@inject IUserService UserService
@inject IShoppingListService ShoppingListService
@inject ILocalizationService Loc
@inject NavigationManager Nav

@* The family AI assistant (Nxt.UI AiChat); this page only turns a reply into meals and shopping items. *@
<div class="app app-content-wrapper ai-chat-page" dir="@Loc.Direction">
    <NxtPageHeader Icon="✨" Title="@Loc["ai_plan_title"]" Subtitle="@Loc["ai_plan_subtitle"]" />
    <AiChat OnSend="HandleSendAsync" EmptyText="@Loc["ai_plan_chat_empty"]" Placeholder="@Loc["ai_plan_placeholder_short"]"
            Suggestions="@Suggestions" ShowMic="true" />
</div>

@code {
    private string uid = "";

    private IReadOnlyList<string> Suggestions => Loc.CurrentLanguage switch
    {
        "ar" => ["مكدوس وفطائر ليوم الجمعة", "أضف حليب وبيض وخبز", "خطط لي عشاء نباتي هذا الأسبوع"],
        "de" => ["Pizza am Freitag", "Milch, Eier und Brot auf die Liste", "Plane vegetarische Abendessen diese Woche"],
        _ => ["Pizza on Friday", "Add milk, eggs and bread", "Plan vegetarian dinners this week"]
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }

        uid = user.Uid;
    }

    private async Task<AiReply> HandleSendAsync(string text)
    {
        // The model needs the current list to resolve "remove the milk" to the exact stored item.
        var shops = await ShoppingListService.GetShopsAsync(uid);
        var currentItems = shops.SelectMany(s => s.Items.Values).Select(i => i.Name).ToList();

        var result = await GeminiPlanner.ParsePromptAsync(text, currentItems);
        if (result.Meals.Count == 0 && result.ShoppingItems.Count == 0 && result.RemoveShoppingItems.Count == 0)
            return AiReply.Error(Loc["ai_plan_empty_parse_error"]);

        foreach (var meal in result.Meals)
        {
            var catalogItem = await CatalogService.CreateMealAsync(new MealCatalogItem
            {
                Name = meal.Name,
                MealType = meal.MealType,
                Language = Loc.CurrentLanguage,
                CreatedBy = uid
            });
            await UserService.AssignMealToDateAsync(uid, meal.Date, catalogItem.Id);
        }

        var sections = new List<AiListSection>();
        var didSomething = result.Meals.Count > 0 || result.ShoppingItems.Count > 0;

        // Removals run before additions so "replace milk with oat milk" can't delete the new item.
        if (result.RemoveShoppingItems.Count > 0)
        {
            var (removedByShop, notFound) = await RemoveItemsAsync(shops, result.RemoveShoppingItems);
            foreach (var (shopName, names) in removedByShop)
                sections.Add(new(Loc.T("ai_plan_reply_removed_heading", shopName), names.Select(n => new AiListItem(n)).ToList()));
            if (removedByShop.Count > 0) didSomething = true;
            if (notFound.Count > 0)
                sections.Add(new(Loc["ai_plan_reply_not_found_heading"], notFound.Select(n => new AiListItem(n)).ToList()));
        }

        if (result.Meals.Count > 0)
        {
            sections.Add(new(Loc["ai_plan_preview_meals_heading"],
                result.Meals.Select(m => new AiListItem(m.Name, Loc.FormatDayDate(m.Date))).ToList()));
        }

        if (result.ShoppingItems.Count > 0)
        {
            var shop = await GetOrCreateShopAsync();
            foreach (var item in result.ShoppingItems)
                await ShoppingListService.AddItemAsync(uid, shop.Id, item);
            sections.Add(new(Loc.T("ai_plan_reply_items_heading", shop.Name),
                result.ShoppingItems.Select(i => new AiListItem(i)).ToList()));
        }

        // The reply reports what was actually done.
        return didSomething
            ? new AiReply { Text = Loc["ai_plan_reply_done"], Sections = sections }
            : AiReply.Error(Loc["ai_plan_reply_nothing_found"]);
    }

    /// <summary>Deletes list items matching the requested names (case-insensitive; exact match first,
    /// then a contains match as a fallback for a slightly different wording).</summary>
    private async Task<(List<(string Shop, List<string> Names)> Removed, List<string> NotFound)> RemoveItemsAsync(
        List<ShoppingShop> shops, List<string> requested)
    {
        var removed = new Dictionary<string, List<string>>();
        var notFound = new List<string>();
        var deleted = new HashSet<string>();

        foreach (var name in requested)
        {
            var all = shops.SelectMany(s => s.Items.Values.Select(i => (Shop: s, Item: i)))
                .Where(x => !deleted.Contains(x.Item.Id)).ToList();
            var matches = all.Where(x => string.Equals(x.Item.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)).ToList();
            if (matches.Count == 0)
                matches = all.Where(x => x.Item.Name.Contains(name, StringComparison.OrdinalIgnoreCase)
                                      || name.Contains(x.Item.Name.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            if (matches.Count == 0) { notFound.Add(name); continue; }

            foreach (var (shop, item) in matches)
            {
                await ShoppingListService.DeleteItemAsync(uid, shop.Id, item.Id);
                deleted.Add(item.Id);
                if (!removed.TryGetValue(shop.Name, out var list)) removed[shop.Name] = list = new();
                list.Add(item.Name);
            }
        }

        return (removed.Select(kv => (kv.Key, kv.Value)).ToList(), notFound);
    }

    private async Task<ShoppingShop> GetOrCreateShopAsync()
    {
        var shops = await ShoppingListService.GetShopsAsync(uid);
        return shops.Count > 0
            ? shops[0]
            : await ShoppingListService.AddShopAsync(uid, Loc["ai_plan_default_shop_name"]);
    }
}
