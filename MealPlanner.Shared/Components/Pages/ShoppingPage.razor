@page "/shopping"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@implements IDisposable
@inject IAuthService Auth
@inject IShoppingListService ShoppingListService
@inject IDayPlanService DayPlan
@inject IMealCatalogService CatalogService
@inject IAisleService Aisles
@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject ToastService Toasts
@inject INutritionStore NutritionStore
@inject IMealImageService MealImages
@inject IUserService UserService
@inject LiveWatch Live

@* Shopping by servings: the meals still to cook from today to Sunday (servings and meal prep change the plan
   itself), and one list grouped by aisle that follows them. The list is brought in line with the plan on
   every visit and after every change here (ShoppingAggregator.Sync): only items it made itself and that are
   not bought are changed. Items typed by hand stay as they are. Bought items stay in place, struck through.
   While syncing with a friend the list is shared (it lives with the friend who asked), its amounts count both
   people's servings, and it updates live when either of you changes it. *@
<div class="mk-page mk-shopping" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <BackButton Fallback="/" />
            <div class="mk-title-block">
                <h1 class="mk-title">@Loc["shopping_title"]</h1>
                <p class="mk-subtitle">@Loc["nut_shop_sub"]</p>
                @if (partnerName is { Length: > 0 })
                {
                    <span class="mk-tag is-ok mk-shared-tag">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/></svg>
                        @Loc.T("nut_shop_shared_with", partnerName)
                    </span>
                }
            </div>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="mk-stack"><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (loadError)
    {
        <div class="mk-stack">
            <div class="mk-notice is-error" role="alert">@Loc["nut_load_error"]</div>
            <button class="mk-btn is-block" @onclick="ReloadAsync">@Loc["nut_retry"]</button>
        </div>
    }
    else
    {
        var all = AllItems;
        var left = all.Count(x => !x.Item.IsBought);
        <main class="mk-stack">
            <section class="mk-planned" aria-labelledby="planned-h">
                <h2 id="planned-h" class="mk-shop-h">@Loc["nut_planned_meals"]</h2>
                @if (planned.Count == 0)
                {
                    <p class="mk-subtitle">@Loc["nut_nothing_planned"]</p>
                }
                else
                {
                    @* Two rows of small chips that scroll sideways; a chip opens servings and meal prep. *@
                    <div class="mk-plan-chips" role="list">
                        @foreach (var p in planned)
                        {
                            var entry = p;
                            <button type="button" role="listitem" class="mk-plan-chip" @onclick="() => editing2 = entry"
                                    aria-label="@Loc.T("nut_plan_chip_label", entry.Meal.Name, Loc.GetDayName(entry.Date.DayOfWeek), Loc.Servings(entry.Entry.Servings))">
                                <b>@Loc.GetShortDayName(entry.Date.DayOfWeek)</b>
                                <span class="mk-plan-chip-name">@entry.Meal.Name</span>
                                @if (entry.Entry.Servings != 1) { <span class="mk-plan-chip-x">@NutFormat.Times(Loc.Servings(entry.Entry.Servings))</span> }
                                @if (entry.Entry.PrepBatches > 1)
                                {
                                    <span class="mk-plan-chip-prep" title="@Loc.T("nut_prep_times", entry.Entry.PrepBatches)"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2zM3 11h18M9 7c0-1.5 1-2.5 3-2.5S15 5.5 15 7"/></svg>@NutFormat.Times(entry.Entry.PrepBatches.ToString())</span>
                                }
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="mk-card mk-shop-card" aria-labelledby="list-h">
                <div class="mk-shop-list-head">
                    <h2 id="list-h" class="mk-shop-h">@Loc["nut_shopping_list"]</h2>
                    @if (all.Count > 0)
                    {
                        <span class="mk-tag @(left == 0 ? "is-ok" : "")" aria-label="@Loc.T("nut_shop_left", Loc.Num(left), Loc.Num(all.Count))">@Loc.T("nut_days_on_count", Loc.Num(left), Loc.Num(all.Count))</span>
                    }
                </div>

                @* A real form: Enter on mobile keyboards submits it too. *@
                <form class="mk-quickadd" @onsubmit="QuickAddAsync" @onsubmit:preventDefault>
                    <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <input placeholder="@Loc["shopping_add_item"]" aria-label="@Loc["shopping_add_item"]" @bind="newItemName" @bind:event="oninput" enterkeyhint="done" autocomplete="off" />
                    <button type="submit" class="mk-quickadd-add" disabled="@(string.IsNullOrWhiteSpace(newItemName) || isSaving)">@Loc["add"]</button>
                </form>

                @if (all.Count == 0)
                {
                    <p class="mk-subtitle mk-shop-empty">@Loc["nut_shop_empty"]</p>
                }

                @foreach (var (shop, item) in Ordered(all.Where(x => !x.Item.IsBought))) { @ItemRow(shop, item) }

                @{ var bought = all.Where(x => x.Item.IsBought).ToList(); }
                @if (bought.Count > 0)
                {
                    <button class="mk-bought-toggle" aria-expanded="@(showBought ? "true" : "false")" @onclick="() => showBought = !showBought">
                        <span>@Loc.T("shopping_bought_n", Loc.Num(bought.Count))</span>
                        <svg class="i mk-past-chev @(showBought ? "is-open" : "")" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    @if (showBought)
                    {
                        @foreach (var (shop, item) in Ordered(bought)) { @ItemRow(shop, item) }
                        @if (Clearable.Count > 0)
                        {
                            <button class="mk-btn is-soft is-sm is-block" disabled="@isClearing" @onclick="ClearBoughtAsync">@Loc.T("nut_clear_bought", Loc.Num(Clearable.Count))</button>
                        }
                    }
                }
            </section>
        </main>
    }
</div>

@code {
    private RenderFragment ItemRow(ShoppingShop shop, ShoppingItem item) => @<div class="mk-shop-item @(item.IsBought ? "is-bought" : "")">
        <button class="mk-check @(item.IsBought ? "is-on" : "")" role="checkbox" aria-checked="@(item.IsBought ? "true" : "false")" aria-label="@item.Name" @onclick="() => ToggleItemAsync(shop, item)">
            @if (item.IsBought) { <svg class="i" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg> }
        </button>
        <button class="mk-shop-item-name" aria-label="@Loc.T("nut_slot_entry", Loc["nut_edit_item"], item.Name)" @onclick="() => OpenEdit(shop, item)">
            <span>@item.Name</span>
            @if (item.UsedIn > 1) { <span class="mk-subtitle">@Loc.T("nut_used_in", Loc.Num(item.UsedIn))</span> }
        </button>
        @if (QuantityText(item) is { Length: > 0 } qty) { <b class="mk-shop-amount">@qty</b> }
    </div>;
}

<NxtBottomSheet IsOpen="editing2 is not null" Eyebrow="@(editing2 is { } pe ? $"{Loc.GetDayName(pe.Date.DayOfWeek)} · {Loc[slotPrefs.NameKey(pe.Slot)]}" : null)" Title="@editing2?.Meal.Name" OnDismiss="() => editing2 = null">
    @if (editing2 is { } entry)
    {
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <div class="mk-sheet-row">
                <span class="mk-sheet-row-title">@Loc["nut_servings_label"]</span>
                <ServingsStepper Value="entry.Entry.Servings" ValueChanged="v => UpdatePlannedAsync(entry, e => e.Servings = v)" />
            </div>
            <div class="mk-sheet-group">
                <span class="mk-sheet-row-copy"><span class="mk-sheet-row-title">@Loc["nut_prep"]</span><span class="mk-sheet-row-hint">@Loc["nut_prep_hint"]</span></span>
                <div class="mk-seg is-inset" role="group" aria-label="@Loc["nut_prep"]">
                    @foreach (var n in new[] { 1, 2, 3 })
                    {
                        var batches = n;
                        <button type="button" class="@(entry.Entry.PrepBatches == batches ? "is-active" : "")" aria-pressed="@(entry.Entry.PrepBatches == batches ? "true" : "false")" @onclick="() => UpdatePlannedAsync(entry, e => e.PrepBatches = batches)">@(batches == 1 ? Loc["nut_off"] : NutFormat.Times(batches.ToString()))</button>
                    }
                </div>
            </div>
        </div>
    }
</NxtBottomSheet>


<NxtBottomSheet IsOpen="@(editing is not null)" Title="@editName" OnDismiss="CloseEdit">
    @if (editing is not null)
    {
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <label class="mk-search"><input aria-label="@Loc["shopping_item_name"]" @bind="editName" @bind:event="oninput" /></label>
            <div class="mk-edit-row">
                <span class="mk-label">@Loc["shopping_quantity"]</span>
                <div class="mk-stepper is-large" role="group" aria-label="@Loc["shopping_quantity"]">
                    <button aria-label="@Loc["shopping_increase"]" @onclick="() => editQuantity++">+</button>
                    <span>@editQuantity</span>
                    <button aria-label="@Loc["shopping_decrease"]" disabled="@(editQuantity <= 1)" @onclick="() => editQuantity--">−</button>
                </div>
            </div>
            <label class="mk-search"><input placeholder="@Loc["shopping_unit_placeholder"]" aria-label="@Loc["shopping_unit"]" @bind="editUnit" @bind:event="oninput" /></label>
            @if (!string.IsNullOrEmpty(editing.IngredientKey))
            {
                <p class="mk-subtitle">@Loc["nut_shop_auto_note"]</p>
            }
            <button class="mk-btn is-lg is-block" disabled="@string.IsNullOrWhiteSpace(editName)" @onclick="SaveEditAsync">@Loc["save"]</button>
            @* An item the plan needs would only come back; it is ticked instead. *@
            @if (string.IsNullOrEmpty(editing.IngredientKey) || !Needed.Contains(editing.IngredientKey))
            {
                <button class="mk-btn is-soft is-block is-danger-text" @onclick="DeleteEditingAsync">@Loc["delete"]</button>
            }
        </div>
    }
</NxtBottomSheet>

@code {
    private readonly SemaphoreSlim syncLock = new(1, 1);
    private List<ShoppingShop> shops = new();
    private List<PlannedEntry> planned = new();
    // The sync partner's meals still to cook: they count in the shared list's amounts but are not shown above.
    private List<PlannedEntry> partnerPlanned = new();
    private SyncLink? link;
    private string? partnerName;
    private readonly List<IAsyncDisposable> watches = new();
    private Dictionary<string, MealCatalogItem> catalog = new();
    private MealPrefs slotPrefs = new();
    private string uid = "";
    private bool isLoading = true, loadError, isSaving, isClearing;
    private string newItemName = "";
    private PlannedEntry? editing2;
    private bool showBought;

    // Open items read in shop order: by aisle, then by name.
    private IEnumerable<(ShoppingShop Shop, ShoppingItem Item)> Ordered(IEnumerable<(ShoppingShop Shop, ShoppingItem Item)> items)
    {
        var order = Aisles.All.Select((a, i) => (a.Key, i)).ToDictionary(x => x.Key, x => x.i);
        return items.OrderBy(x => order.GetValueOrDefault(Aisles.For(x.Item.Name, x.Item.Aisle).Key, 99))
                    .ThenBy(x => x.Item.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    private async Task QuickAddAsync()
    {
        await AddItemAsync();
        newItemName = "";
    }
    private ShoppingItem? editing;
    private ShoppingShop? editingShop;
    private string editName = "", editUnit = "";
    private int editQuantity = 1;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly Sunday => Today.AddDays((7 - (int)Today.DayOfWeek) % 7);

    // Older accounts may still have several stores; their items are shown together, by aisle.
    private List<(ShoppingShop Shop, ShoppingItem Item)> AllItems =>
        shops.SelectMany(s => s.Items.Values.Select(i => (s, i))).ToList();

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguageChanged;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;
        await ReloadAsync();
        await WatchAsync();
    }

    // Live: the shared list changing (a tick on the other phone), or the plan changing (here or by the partner).
    private async Task WatchAsync()
    {
        foreach (var w in watches) await w.DisposeAsync();
        watches.Clear();
        if (loadError) return;
        try
        {
            var owner = await ShoppingListService.GetListOwnerAsync(uid);
            watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(owner)}/shopping", RefreshAsync));
            watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(uid)}/days", RefreshAsync, Today.ToString("yyyy-MM-dd")));
            if (link is { Partner.Length: > 0 } l)
                watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(l.Partner)}/days", RefreshAsync, Today.ToString("yyyy-MM-dd")));
        }
        catch { /* live updates are a bonus; the page works without them */ }
    }

    private async Task RefreshAsync()
    {
        if (isLoading || syncLock.CurrentCount == 0) return;
        try
        {
            await LoadAsync();
            await SyncAsync();
        }
        catch { /* keep what is shown */ }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = false;
        try { await LoadAsync(); }
        catch { loadError = true; }
        finally { isLoading = false; }
        if (!loadError) await SyncAsync();
    }

    private async Task LoadAsync()
    {
        try { link = await NutritionStore.GetSyncLinkAsync(uid); }
        catch { link = null; }
        var shopsTask = ShoppingListService.GetShopsAsync(uid);
        var prefsTask = NutritionStore.GetMealPrefsAsync(uid);
        var daysTask = DayPlan.GetDaysAsync(uid, Today, Sunday);
        var catalogTask = CatalogService.GetAllMealsAsync();
        await Task.WhenAll(shopsTask, prefsTask, daysTask, catalogTask, MealImages.EnsureLoadedAsync());
        shops = await shopsTask;
        catalog = (await catalogTask).ToDictionary(m => m.Id);
        slotPrefs = await prefsTask;
        planned = ShoppingAggregator.PlannedEntries(await daysTask, catalog, Today, Sunday, slotPrefs);
        partnerPlanned = new();
        partnerName = null;
        if (link is { Partner.Length: > 0 } l)
        {
            try
            {
                // Their meal times are theirs to read; every slot counts here.
                var everySlot = new MealPrefs { On = Enum.GetValues<MealSlot>().ToList() };
                partnerPlanned = ShoppingAggregator.PlannedEntries(await DayPlan.GetDaysAsync(l.Partner, Today, Sunday), catalog, Today, Sunday, everySlot);
                var profile = await UserService.GetProfileAsync(l.Partner);
                partnerName = string.IsNullOrWhiteSpace(profile?.DisplayName) ? l.Partner : profile.DisplayName;
            }
            catch { partnerName = l.Partner; }
        }
    }

    // Brings the list in line with the planned meals, servings and meal prep. One run at a time.
    private async Task SyncAsync()
    {
        await syncLock.WaitAsync();
        try
        {
            var lines = ShoppingAggregator.Merge(planned.Concat(partnerPlanned));
            var all = AllItems;
            var sync = ShoppingAggregator.Sync(all.Select(x => x.Item), lines);
            if (sync.IsEmpty) return;
            var shopOf = all.ToDictionary(x => x.Item.Id, x => x.Shop.Id);
            var target = shops.FirstOrDefault() ?? await ShoppingListService.AddShopAsync(uid, Loc["ai_plan_default_shop_name"]);
            foreach (var line in sync.Add)
            {
                var aisle = string.IsNullOrEmpty(line.Aisle) ? Aisles.For(line.Name).Key : line.Aisle;
                await ShoppingListService.AddItemAsync(uid, target.Id, line.Name, new ShoppingItemOptions(
                    Quantity: ShoppingAggregator.StoredQuantity(line), Unit: line.Unit, Aisle: aisle,
                    SourceMeal: line.FirstMeal, IngredientKey: line.Key, UsedIn: line.UsedIn));
            }
            foreach (var (item, line) in sync.Update)
                await ShoppingListService.UpdateAutoItemAsync(uid, shopOf[item.Id], item.Id, ShoppingAggregator.StoredQuantity(line), line.UsedIn, line.FirstMeal);
            foreach (var item in sync.Remove)
                await ShoppingListService.DeleteItemAsync(uid, shopOf[item.Id], item.Id);
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch { Toasts.Show(Loc["nut_save_error"], isError: true); }
        finally { syncLock.Release(); }
    }

    // Servings and meal prep are the same values Week shows; changing them here changes the plan and the list.
    private async Task UpdatePlannedAsync(PlannedEntry entry, Action<SlotEntry> change)
    {
        change(entry.Entry);
        try
        {
            await DayPlan.UpdateEntryAsync(uid, entry.Date, entry.Slot, change);
            await SyncAsync();
        }
        catch
        {
            Toasts.Show(Loc["nut_save_error"], isError: true);
            await ReloadAsync();
        }
    }

    // Measured amounts read "1.2 kg", "750 g", "3 pc"; units typed by hand are shown as written.
    private string QuantityText(ShoppingItem item)
    {
        if (ShoppingAggregator.Format(item.Quantity, item.Unit, Loc.NumberCulture()) is { } f)
            return NutFormat.Isolate($"{f.Amount} {Loc[UnitKey(f.Unit)]}");
        var unit = string.IsNullOrWhiteSpace(item.Unit) ? "" : " " + item.Unit;
        if (item.Quantity <= 1 && unit.Length == 0) return "";
        return NutFormat.Isolate($"{Loc.Num(Math.Max(1, item.Quantity))}{unit}");
    }

    private static string UnitKey(string unit) => unit switch { "kg" => "nut_kg", "g" => "nut_g", "l" => "nut_l", "ml" => "nut_ml", _ => "nut_pc" };


    private async Task AddItemAsync()
    {
        var name = newItemName.Trim();
        if (name.Length == 0 || isSaving) return;
        isSaving = true;
        try
        {
            var shop = shops.FirstOrDefault() ?? await ShoppingListService.AddShopAsync(uid, Loc["ai_plan_default_shop_name"]);
            await ShoppingListService.AddItemAsync(uid, shop.Id, name, new ShoppingItemOptions(Aisle: Aisles.For(name).Key));
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch { Toasts.Show(Loc["nut_save_error"], isError: true); }
        finally { isSaving = false; }
    }

    private async Task ToggleItemAsync(ShoppingShop shop, ShoppingItem item)
    {
        item.IsBought = !item.IsBought;                       // optimistic: the list reacts immediately
        item.BoughtAtUtc = item.IsBought ? DateTime.UtcNow : null;
        try { await ShoppingListService.SetItemBoughtAsync(uid, shop.Id, item.Id, item.IsBought); }
        catch
        {
            item.IsBought = !item.IsBought;
            Toasts.Show(Loc["nut_save_error"], isError: true);
        }
    }

    // Ingredient keys the planned meals still need.
    private HashSet<string> Needed => ShoppingAggregator.Merge(planned.Concat(partnerPlanned)).Select(l => l.Key).ToHashSet();

    // Bought items that can go: typed by hand, or no longer needed by the plan. A bought item the plan still
    // needs stays ticked, so it does not come back as "to buy".
    private List<(ShoppingShop Shop, ShoppingItem Item)> Clearable
    {
        get
        {
            var needed = Needed;
            return AllItems.Where(x => x.Item.IsBought && (string.IsNullOrEmpty(x.Item.IngredientKey) || !needed.Contains(x.Item.IngredientKey))).ToList();
        }
    }

    private async Task ClearBoughtAsync()
    {
        isClearing = true;
        try
        {
            foreach (var (shop, item) in Clearable)
                await ShoppingListService.DeleteItemAsync(uid, shop.Id, item.Id);
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch { Toasts.Show(Loc["nut_save_error"], isError: true); }
        finally { isClearing = false; }
    }

    private void OpenEdit(ShoppingShop shop, ShoppingItem item)
    {
        editing = item;
        editingShop = shop;
        editName = item.Name;
        editQuantity = Math.Max(1, item.Quantity);
        editUnit = item.Unit ?? "";
    }

    private void CloseEdit() { editing = null; editingShop = null; }

    private async Task SaveEditAsync()
    {
        if (editing is null || editingShop is null) return;
        try
        {
            await ShoppingListService.UpdateItemAsync(uid, editingShop.Id, editing.Id, editName, editQuantity, editUnit);
            CloseEdit();
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch { Toasts.Show(Loc["nut_save_error"], isError: true); CloseEdit(); }
    }

    private async Task DeleteEditingAsync()
    {
        if (editing is null || editingShop is null) return;
        try
        {
            await ShoppingListService.DeleteItemAsync(uid, editingShop.Id, editing.Id);
            CloseEdit();
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch { Toasts.Show(Loc["nut_save_error"], isError: true); CloseEdit(); }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Loc.OnLanguageChanged -= OnLanguageChanged;
        foreach (var w in watches) _ = w.DisposeAsync().AsTask();
    }
}
