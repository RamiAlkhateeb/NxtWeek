@page "/shopping"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject IAuthService Auth
@inject IShoppingListService ShoppingListService
@inject NavigationManager Nav
@inject ILocalizationService Loc

<div class="app app-content-wrapper shopping-page" dir="@Loc.Direction">
    <header class="ui-page-header shopping-page-header">
        <div>
            <h1><span class="shopping-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8h14l-1 11H6z"/><path d="M8 8a4 4 0 0 1 8 0"/><path d="M9.5 13.5h.01M14.5 13.5h.01"/></svg></span> @(Loc.IsArabic ? "المشتريات" : "Shopping")</h1>
            <p>@(Loc.IsArabic ? "رتّب مشترياتك حسب المتجر" : "Organize your shopping by store")</p>
        </div>
    </header>

    <main class="shopping-content">
        <UiButton Variant="primary" CssClass="shopping-add-shop" OnClick="OpenAddShop">+ @(Loc.IsArabic ? "أضف متجرًا" : "Add Store")</UiButton>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert-playful shopping-feedback">@errorMessage</div>
        }

        @if (isLoading)
        {
            <div class="shopping-loading">@(Loc.IsArabic ? "جارٍ تحميل قائمة المشتريات…" : "Loading shopping list…")</div>
        }
        else if (shops.Count == 0)
        {
            <UiEmptyState Icon="🛒" Title="@(Loc.IsArabic ? "قائمة المشتريات جاهزة" : "Shopping list is ready")" Message="@(Loc.IsArabic ? "أضف متجرًا ثم دوّن ما تحتاجه منه." : "Add a store and list what you need.")">
                <UiButton Variant="primary" OnClick="OpenAddShop">@(Loc.IsArabic ? "أضف أول متجر" : "Add First Store")</UiButton>
            </UiEmptyState>
        }
        else
        {
            <div class="shopping-shops">
                @foreach (var shop in shops)
                {
                    var items = shop.Items?.Values ?? Enumerable.Empty<ShoppingItem>();
                    var orderedItems = items.OrderBy(item => item.IsBought).ThenBy(item => item.CreatedAtUtc).ToList();
                    var deleteShopLabel = Loc.IsArabic ? $"حذف {shop.Name}" : $"Delete {shop.Name}";
                    var addItemLabel = Loc.IsArabic ? $"أضف عنصرًا إلى {shop.Name}" : $"Add item to {shop.Name}";
                    <UiCard CssClass="shopping-shop-card">
                        <div class="shopping-shop-header">
                            <div>
                                <h2><span class="shopping-inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 10h16v10H4z"/><path d="m4 10 2-6h12l2 6M8 20v-5h4v5M15 14h2"/></svg></span>@shop.Name</h2>
                                <span class="shopping-count">@items.Count() @(Loc.IsArabic ? "عنصر" : "items")</span>
                            </div>
                            <UiButton Variant="ghost" CssClass="shopping-delete-shop shopping-svg-action" OnClick="() => RequestDeleteShop(shop)" title="@(Loc.IsArabic ? "حذف المتجر" : "Delete Store")" aria-label="@deleteShopLabel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg></UiButton>
                        </div>

                        <div class="shopping-add-item">
                            <UiTextInput Value="@GetItemDraft(shop.Id)" ValueChanged="value => SetItemDraft(shop.Id, value)" Placeholder="@(Loc.IsArabic ? "أضف عنصرًا" : "Add item")" aria-label="@addItemLabel" />
                            <UiButton Variant="secondary" OnClick="() => AddItemAsync(shop.Id)">@(Loc.IsArabic ? "إضافة" : "Add")</UiButton>
                        </div>

                        @if (orderedItems.Count == 0)
                        {
                            <p class="shopping-empty-shop">@(Loc.IsArabic ? "لا توجد عناصر بعد — أضف أول عنصر." : "No items yet — add your first item.")</p>
                        }
                        else
                        {
                            <div class="shopping-items">
                                @foreach (var item in orderedItems)
                                {
                                    var toggleItemLabel = $"{(item.IsBought ? (Loc.IsArabic ? "إلغاء شراء" : "Uncheck") : (Loc.IsArabic ? "تم الشراء" : "Bought"))}: {item.Name}";
                                    var deleteItemLabel = $"{Loc["delete"]} {item.Name}";
                                    <div class="shopping-item @(item.IsBought ? "is-bought" : "")">
                                        <button class="shopping-item-toggle" @onclick="() => ToggleItemAsync(shop.Id, item)" aria-label="@toggleItemLabel"><svg viewBox="0 0 24 24" aria-hidden="true">@if (item.IsBought) { <path d="m5 12 4.2 4.2L19 6.5"/> } else { <circle cx="12" cy="12" r="8"/> }</svg></button>
                                        <button class="shopping-item-name" @onclick="() => ToggleItemAsync(shop.Id, item)">@item.Name</button>
                                        <button class="shopping-item-delete shopping-svg-action" @onclick="() => DeleteItemAsync(shop.Id, item.Id)" aria-label="@deleteItemLabel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg></button>
                                    </div>
                                }
                            </div>
                        }
                    </UiCard>
                }
            </div>
        }
    </main>
</div>

<UiBottomSheet IsOpen="showAddShop" Title="@(Loc.IsArabic ? "متجر جديد" : "New Store")" Eyebrow="@(Loc.IsArabic ? "رتّب مشترياتك بالطريقة التي تناسبك" : "Organize your shopping the way you like")" OnDismiss="CloseAddShop">
    <div class="sheet-actions" dir="@Loc.Direction">
        <UiTextInput Placeholder="@(Loc.IsArabic ? "اسم المتجر، مثل كارفور أو بنده" : "Store name, e.g. Walmart")" @bind-Value="newShopName" />
        @if (!string.IsNullOrWhiteSpace(addShopError)) { <div class="alert-playful shopping-feedback">@addShopError</div> }
        <UiButton Variant="primary" OnClick="AddShopAsync" Disabled="@string.IsNullOrWhiteSpace(newShopName)">@(Loc.IsArabic ? "إضافة متجر" : "Add Store")</UiButton>
    </div>
</UiBottomSheet>

<UiBottomSheet IsOpen="@(shopPendingDeletion is not null)" Title="@(Loc.IsArabic ? "حذف المتجر؟" : "Delete Store?")" Eyebrow="@(Loc.IsArabic ? "سيُحذف المتجر وكل العناصر الموجودة فيه." : "The store and all its items will be deleted.")" OnDismiss="CancelDeleteShop">
    <div class="sheet-actions" dir="@Loc.Direction">
        <UiButton Variant="danger" OnClick="ConfirmDeleteShopAsync">@(Loc.IsArabic ? $"حذف {shopPendingDeletion?.Name}" : $"Delete {shopPendingDeletion?.Name}")</UiButton>
        <UiButton Variant="ghost" OnClick="CancelDeleteShop">@Loc["cancel"]</UiButton>
    </div>
</UiBottomSheet>

@code {
    private readonly Dictionary<string, string> itemDrafts = new();
    private List<ShoppingShop> shops = new();
    private string uid = "";
    private bool isLoading = true;
    private bool showAddShop;
    private string newShopName = "";
    private string addShopError = "";
    private string errorMessage = "";
    private ShoppingShop? shopPendingDeletion;

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }

        uid = user.Uid;
        await LoadShopsAsync();
    }

    private async Task LoadShopsAsync()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            shops = await ShoppingListService.GetShopsAsync(uid);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddShop()
    {
        newShopName = "";
        addShopError = "";
        showAddShop = true;
    }

    private void CloseAddShop()
    {
        showAddShop = false;
        newShopName = "";
        addShopError = "";
    }

    private async Task AddShopAsync()
    {
        if (string.IsNullOrWhiteSpace(newShopName)) return;
        addShopError = "";
        try
        {
            await ShoppingListService.AddShopAsync(uid, newShopName);
            CloseAddShop();
            await LoadShopsAsync();
        }
        catch (Exception ex) { addShopError = ex.Message; }
    }

    private string GetItemDraft(string shopId) => itemDrafts.TryGetValue(shopId, out var value) ? value : "";
    private void SetItemDraft(string shopId, string value) => itemDrafts[shopId] = value;

    private async Task AddItemAsync(string shopId)
    {
        try
        {
            await ShoppingListService.AddItemAsync(uid, shopId, GetItemDraft(shopId));
            itemDrafts[shopId] = "";
            await LoadShopsAsync();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task ToggleItemAsync(string shopId, ShoppingItem item)
    {
        try { await ShoppingListService.SetItemBoughtAsync(uid, shopId, item.Id, !item.IsBought); await LoadShopsAsync(); }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task DeleteItemAsync(string shopId, string itemId)
    {
        try { await ShoppingListService.DeleteItemAsync(uid, shopId, itemId); await LoadShopsAsync(); }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void RequestDeleteShop(ShoppingShop shop) => shopPendingDeletion = shop;
    private void CancelDeleteShop() => shopPendingDeletion = null;
    private async Task ConfirmDeleteShopAsync()
    {
        if (shopPendingDeletion is null) return;
        try { await ShoppingListService.DeleteShopAsync(uid, shopPendingDeletion.Id); shopPendingDeletion = null; await LoadShopsAsync(); }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
