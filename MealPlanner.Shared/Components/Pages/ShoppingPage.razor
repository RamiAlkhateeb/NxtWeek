@page "/shopping"
@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@using MealPlanner.Shared.Nutrition
@implements IDisposable
@inject IAuthService Auth
@inject IShoppingListService ShoppingListService
@inject IShoppingStoreService Stores
@inject IShoppingListOwner ListOwner
@inject IStoreLogoService StoreLogos
@inject IDayPlanService DayPlan
@inject IMealCatalogService CatalogService
@inject IAisleService Aisles
@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject ToastService Toasts
@inject INutritionStore NutritionStore
@inject IMealImageService MealImages
@inject IUserService UserService
@inject LiveWatch Live
@inject IJSRuntime JS
@inject UndoService Undo

@* Shopping by servings: the meals still to cook from today to Sunday (servings and meal prep change the plan
   itself), and one list grouped by aisle that follows them. The list is brought in line with the plan on
   every visit and after every change here (ShoppingAggregator.Sync): only items it made itself and that are
   not bought are changed. Items typed by hand stay as they are. Bought items stay in their store, struck through, after the items still to buy.
   While syncing with a friend the list is shared (it lives with the friend who asked), its amounts count both
   people's servings, and it updates live when either of you changes it. *@
<div class="mk-page mk-shopping" dir="@Loc.Direction">
    <header class="mk-header">
        <div class="mk-header-row">
            <BackButton Fallback="/" />
            <div class="mk-title-block">
                <h1 class="mk-title">@Loc["shopping_title"]</h1>
                <p class="mk-subtitle">@Loc["nut_shop_sub"]</p>
                @if (partnerName is { Length: > 0 })
                {
                    <span class="mk-tag is-ok mk-shared-tag">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/></svg>
                        @Loc.T("nut_shop_shared_with", partnerName)
                    </span>
                }
            </div>
            <button class="mk-icon-btn" aria-label="@Loc["nut_share_list"]" disabled="@(isLoading || !AllItems.Any(x => !x.Item.IsBought))" @onclick="ShareListAsync">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>
            </button>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="mk-stack"><NxtSkeleton /><NxtSkeleton /><NxtSkeleton /></div>
    }
    else if (loadError)
    {
        <div class="mk-stack">
            <div class="mk-notice is-error" role="alert">@Loc["nut_load_error"]</div>
            <button class="mk-btn is-block" @onclick="ReloadAsync">@Loc["nut_retry"]</button>
        </div>
    }
    else
    {
        var all = AllItems;
        var left = all.Count(x => !x.Item.IsBought);
        <main class="mk-stack">
            <section class="mk-planned" aria-labelledby="planned-h">
                <h2 id="planned-h" class="mk-shop-h">@Loc["nut_planned_meals"]</h2>
                @if (planned.Count == 0)
                {
                    <p class="mk-subtitle">@Loc["nut_nothing_planned"]</p>
                }
                else
                {
                    @* Two rows of small chips that scroll sideways; a chip opens servings and meal prep. *@
                    <div class="mk-plan-chips" role="list">
                        @foreach (var p in planned)
                        {
                            var entry = p;
                            <button type="button" role="listitem" class="mk-plan-chip" @onclick="() => editing2 = entry"
                                    aria-label="@Loc.T("nut_plan_chip_label", entry.Meal.Name, Loc.GetDayName(entry.Date.DayOfWeek), Loc.Servings(entry.Entry.Servings))">
                                <b>@Loc.GetShortDayName(entry.Date.DayOfWeek)</b>
                                <span class="mk-plan-chip-name">@entry.Meal.Name</span>
                                @if (entry.Entry.Servings != 1) { <span class="mk-plan-chip-x">@NutFormat.Times(Loc.Servings(entry.Entry.Servings))</span> }
                                @if (entry.Entry.PrepBatches > 1)
                                {
                                    <span class="mk-plan-chip-prep" title="@Loc.T("nut_prep_times", entry.Entry.PrepBatches)"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 11h14v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2zM3 11h18M9 7c0-1.5 1-2.5 3-2.5S15 5.5 15 7"/></svg>@NutFormat.Times(entry.Entry.PrepBatches.ToString())</span>
                                }
                            </button>
                        }
                    </div>
                }
            </section>

            @* Rows swipe: towards the reading end ticks an item, towards the start removes it (nxtweek.swipeRows). *@
            <section class="mk-card mk-shop-card" aria-labelledby="list-h" @ref="listCard">
                <div class="mk-shop-list-head">
                    <h2 id="list-h" class="mk-shop-h">@Loc["nut_shopping_list"]</h2>
                    @if (all.Count > 0)
                    {
                        <span class="mk-tag @(left == 0 ? "is-ok" : "")" aria-label="@Loc.T("nut_shop_left", Loc.Num(left), Loc.Num(all.Count))">@Loc.T("nut_days_on_count", Loc.Num(left), Loc.Num(all.Count))</span>
                    }
                    <button type="button" class="mk-link-btn mk-add-store" @onclick="OpenAddStore">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>@Loc["shopping_add_store"]
                    </button>
                </div>

                @* A real form: Enter on mobile keyboards submits it too. *@
                <form class="mk-quickadd" @onsubmit="QuickAddAsync" @onsubmit:preventDefault>
                    <svg class="i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <input placeholder="@Loc["shopping_add_item"]" aria-label="@Loc["shopping_add_item"]" @bind="newItemName" @bind:event="oninput" enterkeyhint="done" autocomplete="off" />
                    <button type="submit" class="mk-quickadd-add" disabled="@(string.IsNullOrWhiteSpace(newItemName) || isBusy)">@Loc["add"]</button>
                </form>
                @if (shops.Count > 1)
                {
                    <div class="mk-store-chips" role="group" aria-label="@Loc["shopping_which_store"]">
                        @foreach (var shop in OrderedShops)
                        {
                            var sh = shop;
                            <button type="button" class="mk-chip mk-store-chip @(AddTarget?.Id == sh.Id ? "is-active" : "")" aria-pressed="@(AddTarget?.Id == sh.Id ? "true" : "false")" @onclick="() => addShopId = sh.Id"><StoreThumb Shop="sh" Small="true" />@sh.Name</button>
                        }
                    </div>
                }

                @if (all.Count == 0)
                {
                    <p class="mk-subtitle mk-shop-empty">@Loc["nut_shop_empty"]</p>
                }

                @if (shops.Count > 1)
                {
                    var firstStore = true;
                    @* a single store needs no heading; with several, each has its picture, count and options *@
                    @foreach (var shop in OrderedShops)
                    {
                        var sh = shop;
                        var open = Ordered(all.Where(x => x.Shop.Id == sh.Id && !x.Item.IsBought)).ToList();
                        var boughtHere = Ordered(all.Where(x => x.Shop.Id == sh.Id && x.Item.IsBought)).ToList();
                        <div class="mk-store-head @(firstStore ? "is-first" : "")">
                            <StoreThumb Shop="sh" />
                            <span class="mk-store-head-name">@sh.Name</span>
                            <span class="mk-subtitle">@(open.Count == 1 ? Loc["nut_aisle_item_one"] : Loc.T("nut_aisle_items", Loc.Num(open.Count)))</span>
                            <button type="button" class="mk-icon-btn is-plain is-muted" aria-label="@Loc.T("nut_slot_entry", Loc["shopping_store_options"], sh.Name)" @onclick="() => OpenStoreMenu(sh)">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
                            </button>
                        </div>
                        @if (open.Count == 0 && boughtHere.Count == 0) { <p class="mk-subtitle mk-store-empty">@Loc["nut_store_empty"]</p> }
                        @foreach (var (shop2, item) in open) { @ItemRow(shop2, item) }
                        @* Bought items stay with their store, struck through, after the ones still to buy. *@
                        @foreach (var (shop2, item) in boughtHere) { @ItemRow(shop2, item) }
                        firstStore = false;
                    }
                }
                else
                {
                    @foreach (var (shop, item) in Ordered(all.Where(x => !x.Item.IsBought))) { @ItemRow(shop, item) }
                    @foreach (var (shop, item) in Ordered(all.Where(x => x.Item.IsBought))) { @ItemRow(shop, item) }
                }

                @if (all.Count > 0) { <p class="mk-shop-hint">@Loc["nut_swipe_hint"]</p> }

                @if (Clearable.Count > 0)
                {
                    <button class="mk-btn is-soft is-sm is-block mk-clear-bought" disabled="@isBusy" @onclick="ClearBoughtAsync">@Loc.T("nut_clear_bought", Loc.Num(Clearable.Count))</button>
                }

                @if (all.Count > 0)
                {
                    <button type="button" class="mk-link-btn is-danger-text mk-clear-list" @onclick="() => confirmClear = true">
                        <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>@Loc["nut_clear_list"]
                    </button>
                }
            </section>
        </main>
    }
</div>

@code {
    private RenderFragment ItemRow(ShoppingShop shop, ShoppingItem item) => @<div class="mk-shop-item @(item.IsBought ? "is-bought" : "")" data-swipe-id="@($"{shop.Id}/{item.Id}")">
        <button class="mk-check @(item.IsBought ? "is-on" : "")" role="checkbox" aria-checked="@(item.IsBought ? "true" : "false")" aria-label="@item.Name" @onclick="() => ToggleItemAsync(shop, item)">
            @if (item.IsBought) { <svg class="i" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg> }
        </button>
        <button class="mk-shop-item-name" aria-label="@Loc.T("nut_slot_entry", Loc["nut_edit_item"], item.Name)" @onclick="() => OpenEdit(shop, item)">
            <span>@item.Name</span>
            @if (item.UsedIn > 1)
            {
                <span class="mk-subtitle">@Loc.T("nut_used_in", Loc.Num(item.UsedIn))</span>
            }
        </button>
        @if (QuantityText(item) is { Length: > 0 } qty) { <b class="mk-shop-amount">@qty</b> }
    </div>;
}

<NxtBottomSheet IsOpen="editing2 is not null" Eyebrow="@(editing2 is { } pe ? $"{Loc.GetDayName(pe.Date.DayOfWeek)} · {Loc[slotPrefs.NameKey(pe.Slot)]}" : null)" Title="@editing2?.Meal.Name" OnDismiss="() => editing2 = null">
    @if (editing2 is { } entry)
    {
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <div class="mk-sheet-row">
                <span class="mk-sheet-row-title">@Loc["nut_servings_label"]</span>
                <ServingsStepper Value="entry.Entry.Servings" ValueChanged="v => UpdatePlannedAsync(entry, e => e.Servings = v)" />
            </div>
            <div class="mk-sheet-group">
                <span class="mk-sheet-row-copy"><span class="mk-sheet-row-title">@Loc["nut_prep"]</span><span class="mk-sheet-row-hint">@Loc["nut_prep_hint"]</span></span>
                <div class="mk-seg is-inset" role="group" aria-label="@Loc["nut_prep"]">
                    @foreach (var n in new[] { 1, 2, 3 })
                    {
                        var batches = n;
                        <button type="button" class="@(entry.Entry.PrepBatches == batches ? "is-active" : "")" aria-pressed="@(entry.Entry.PrepBatches == batches ? "true" : "false")" @onclick="() => UpdatePlannedAsync(entry, e => e.PrepBatches = batches)">@(batches == 1 ? Loc["nut_off"] : NutFormat.Times(batches.ToString()))</button>
                    }
                </div>
            </div>
        </div>
    }
</NxtBottomSheet>


<NxtBottomSheet IsOpen="@(editing is not null)" Title="@editName" OnDismiss="CloseEdit">
    @if (editing is not null)
    {
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <label class="mk-search"><input aria-label="@Loc["shopping_item_name"]" @bind="editName" @bind:event="oninput" /></label>
            <div class="mk-edit-row">
                <span class="mk-label">@Loc["shopping_quantity"]</span>
                <div class="mk-stepper is-large" role="group" aria-label="@Loc["shopping_quantity"]">
                    <button aria-label="@Loc["shopping_increase"]" @onclick="() => editQuantity++">+</button>
                    <span>@editQuantity</span>
                    <button aria-label="@Loc["shopping_decrease"]" disabled="@(editQuantity <= 1)" @onclick="() => editQuantity--">−</button>
                </div>
            </div>
            <label class="mk-search"><input placeholder="@Loc["shopping_unit_placeholder"]" aria-label="@Loc["shopping_unit"]" @bind="editUnit" @bind:event="oninput" /></label>
            @if (shops.Count > 1)
            {
                <span class="mk-label">@Loc["shopping_which_store"]</span>
                <div class="mk-chip-wrap" role="group" aria-label="@Loc["shopping_which_store"]">
                    @foreach (var shop in OrderedShops)
                    {
                        var sh = shop;
                        <button type="button" class="mk-chip mk-store-chip @(editShopId == sh.Id ? "is-active" : "")" aria-pressed="@(editShopId == sh.Id ? "true" : "false")" @onclick="() => editShopId = sh.Id"><StoreThumb Shop="sh" Small="true" />@sh.Name</button>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(editing.IngredientKey))
            {
                <p class="mk-subtitle">@Loc["nut_shop_auto_note"]</p>
            }
            <button class="mk-btn is-lg is-block" disabled="@string.IsNullOrWhiteSpace(editName)" @onclick="SaveEditAsync">@Loc["save"]</button>
            @* Any item can go. One the plan added stays away until the plan needs more of it. *@
            <button class="mk-btn is-soft is-block is-danger-text" @onclick="DeleteEditingAsync">@Loc["delete"]</button>
        </div>
    }
</NxtBottomSheet>

<NxtBottomSheet IsOpen="confirmClear" Title="@Loc["nut_clear_list_q"]" Eyebrow="@Loc["shopping_title"]" OnDismiss="() => confirmClear = false">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <p>@(Needed.Count > 0 ? Loc["nut_clear_list_note_plan"] : Loc["nut_clear_list_note"])</p>
        <button class="mk-btn is-lg is-block is-danger-fill" disabled="@isBusy" @onclick="ClearListAsync">@Loc["nut_clear_list"]</button>
        <button class="mk-btn is-soft is-block" @onclick="() => confirmClear = false">@Loc["cancel"]</button>
    </div>
</NxtBottomSheet>

<NxtBottomSheet IsOpen="showAddStore" Title="@Loc["shopping_new_store"]" Eyebrow="@Loc["shopping_new_store_eyebrow"]" OnDismiss="() => showAddStore = false">
    <form class="mk-sheet-body" dir="@Loc.Direction" @onsubmit="AddStoreAsync" @onsubmit:preventDefault>
        <label class="mk-search"><input placeholder="@Loc["shopping_store_placeholder"]" aria-label="@Loc["shopping_store_placeholder"]" @bind="storeName" @bind:event="oninput" autocomplete="off" /></label>
        @if (storeError is { Length: > 0 }) { <div class="mk-notice is-error" role="alert">@storeError</div> }
        <button type="submit" class="mk-btn is-lg is-block" disabled="@(string.IsNullOrWhiteSpace(storeName) || isBusy)">@Loc["shopping_add_store"]</button>
    </form>
</NxtBottomSheet>

<NxtBottomSheet IsOpen="menuShop is not null" Title="@menuShop?.Name" Eyebrow="@Loc["shopping_store_options"]" OnDismiss="() => menuShop = null">
    @if (menuShop is { } ms)
    {
        <div class="mk-sheet-body" dir="@Loc.Direction">
            <form class="mk-store-rename" @onsubmit="RenameStoreAsync" @onsubmit:preventDefault>
                <label class="mk-search"><input aria-label="@Loc["nut_store_name"]" @bind="storeName" @bind:event="oninput" autocomplete="off" /></label>
                <button type="submit" class="mk-btn" disabled="@(string.IsNullOrWhiteSpace(storeName) || storeName.Trim() == ms.Name || isBusy)">@Loc["save"]</button>
            </form>
            @if (storeError is { Length: > 0 }) { <div class="mk-notice is-error" role="alert">@storeError</div> }
            @if (shops.Count > 1)
            {
                <p>@Loc.T("nut_store_delete_note", ShoppingStores.HeirOf(ms.Id, shops)!.Name)</p>
                <button class="mk-btn is-soft is-block is-danger-text" disabled="@isBusy" @onclick="DeleteStoreAsync">@Loc.T("shopping_delete_store_named", ms.Name)</button>
            }
        </div>
    }
</NxtBottomSheet>

@code {
    private List<ShoppingShop> shops = new();
    private Dictionary<string, string> routes = new();
    // Plan items the user removed (ShoppingAggregator.DismissKey → amount the plan needed then).
    private Dictionary<string, int> dismissed = new();
    private List<PlannedEntry> planned = new();
    // The sync partner's meals still to cook: they count in the shared list's amounts but are not shown above.
    private List<PlannedEntry> partnerPlanned = new();
    private Dictionary<string, MealCatalogItem> catalog = new();
    private MealPrefs slotPrefs = new();
    private SyncLink? link;
    private string? partnerName;
    private readonly List<IAsyncDisposable> watches = new();
    private string uid = "";
    private bool isLoading = true, loadError, showAddStore, confirmClear;
    private string newItemName = "", storeName = "", storeError = "";
    private string? addShopId, editShopId;
    private ShoppingShop? menuShop;
    private PlannedEntry? editing2;
    private ShoppingItem? editing;
    private ShoppingShop? editingShop;
    private string editName = "", editUnit = "";
    private int editQuantity = 1;

    // One change at a time. A live update that arrives meanwhile (often the echo of this very change) waits and
    // is applied once afterwards, so the list is never read half way through a change.
    private readonly SemaphoreSlim gate = new(1, 1);
    private bool isBusy, refreshWaiting;
    private readonly HashSet<string> askedLogos = new();

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly Sunday => Today.AddDays((7 - (int)Today.DayOfWeek) % 7);

    private ShoppingShop? DefaultShop => ShoppingStores.Default(shops);
    private List<ShoppingShop> OrderedShops => ShoppingStores.Ordered(shops);
    private ShoppingShop? AddTarget => shops.FirstOrDefault(x => x.Id == addShopId) ?? DefaultShop;

    private List<(ShoppingShop Shop, ShoppingItem Item)> AllItems =>
        shops.SelectMany(s => s.Items.Values.Select(i => (s, i))).ToList();

    // Ingredient keys the planned meals still need.
    private HashSet<string> Needed => ShoppingAggregator.Merge(planned.Concat(partnerPlanned)).Select(l => l.Key).ToHashSet();

    // Bought items that can go: typed by hand, or no longer needed by the plan. A bought item the plan still
    // needs stays ticked, so it does not come back as "to buy".
    private List<(ShoppingShop Shop, ShoppingItem Item)> Clearable
    {
        get
        {
            var needed = Needed;
            return AllItems.Where(x => x.Item.IsBought && (string.IsNullOrEmpty(x.Item.IngredientKey) || !needed.Contains(x.Item.IngredientKey))).ToList();
        }
    }

    // Open items read in shop order: by aisle, then by name.
    private IEnumerable<(ShoppingShop Shop, ShoppingItem Item)> Ordered(IEnumerable<(ShoppingShop Shop, ShoppingItem Item)> items)
    {
        var order = Aisles.All.Select((a, i) => (a.Key, i)).ToDictionary(x => x.Key, x => x.i);
        return items.OrderBy(x => order.GetValueOrDefault(Aisles.For(x.Item.Name, x.Item.Aisle).Key, 99))
                    .ThenBy(x => x.Item.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += OnLanguageChanged;
        var user = await Auth.GetCurrentUserAsync();
        if (user is null || string.IsNullOrWhiteSpace(user.Uid))
        {
            Nav.NavigateTo("/signin");
            return;
        }
        uid = user.Uid;
        await ReloadAsync();
        await WatchAsync();
    }

    // Live: the shared list changing (a tick on the other phone), or the plan changing (here or by the partner).
    private async Task WatchAsync()
    {
        foreach (var w in watches) await w.DisposeAsync();
        watches.Clear();
        if (loadError) return;
        try
        {
            var owner = await ListOwner.GetAsync(uid);
            watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(owner)}/shopping", RefreshAsync));
            watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(uid)}/days", RefreshAsync, Today.ToString("yyyy-MM-dd")));
            if (link is { Partner.Length: > 0 } l)
                watches.Add(await Live.WatchAsync($"users/{LiveWatch.Key(l.Partner)}/days", RefreshAsync, Today.ToString("yyyy-MM-dd")));
        }
        catch { /* live updates are a bonus; the page works without them */ }
    }

    private async Task RefreshAsync()
    {
        if (isLoading) return;
        if (!await gate.WaitAsync(0)) { refreshWaiting = true; return; }
        try { await LoadAndSyncAsync(); }
        catch { /* keep what is shown */ }
        finally { gate.Release(); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        loadError = false;
        await gate.WaitAsync();
        try { await LoadAndSyncAsync(); }
        catch { loadError = true; }
        finally
        {
            gate.Release();
            isLoading = false;
        }
        _ = FindLogosAsync();
    }

    // Runs one change, then reads the list again (and brings it in line with the plan). A failed change shows
    // <paramref name="onError"/> (a toast by default) and the list as it really is.
    // True when the change itself succeeded.
    private async Task<bool> ChangeAsync(Func<Task> change, Action? onError = null)
    {
        await gate.WaitAsync();
        isBusy = true;
        var ok = true;
        try
        {
            try { await change(); }
            catch { ok = false; (onError ?? (() => Toasts.Show(Loc["nut_save_error"], isError: true)))(); }
            refreshWaiting = false;
            try { await LoadAndSyncAsync(); } catch { /* keep what is shown */ }
        }
        finally
        {
            isBusy = false;
            gate.Release();
        }
        if (refreshWaiting) { refreshWaiting = false; await RefreshAsync(); }
        return ok;
    }

    private async Task LoadAndSyncAsync()
    {
        await LoadAsync();
        if (await SyncWithPlanAsync()) shops = await ShoppingListService.GetShopsAsync(uid);
    }

    private async Task LoadAsync()
    {
        try { link = await NutritionStore.GetSyncLinkAsync(uid); }
        catch { link = null; }
        var shopsTask = ShoppingListService.GetShopsAsync(uid);
        var prefsTask = NutritionStore.GetMealPrefsAsync(uid);
        var daysTask = DayPlan.GetDaysAsync(uid, Today, Sunday);
        var catalogTask = CatalogService.GetAllMealsAsync();
        await Task.WhenAll(shopsTask, prefsTask, daysTask, catalogTask, MealImages.EnsureLoadedAsync());
        shops = await shopsTask;
        try { routes = await Stores.GetStoreRoutesAsync(uid); } catch { routes = new(); }
        try { dismissed = await ShoppingListService.GetDismissedAsync(uid); } catch { dismissed = new(); }
        catalog = (await catalogTask).ToDictionary(m => m.Id);
        slotPrefs = await prefsTask;
        planned = ShoppingAggregator.PlannedEntries(await daysTask, catalog, Today, Sunday, slotPrefs);
        partnerPlanned = new();
        partnerName = null;
        if (link is { Partner.Length: > 0 } l)
        {
            try
            {
                // Their meal times are theirs to read; every slot counts here.
                var everySlot = new MealPrefs { On = Enum.GetValues<MealSlot>().ToList() };
                partnerPlanned = ShoppingAggregator.PlannedEntries(await DayPlan.GetDaysAsync(l.Partner, Today, Sunday), catalog, Today, Sunday, everySlot);
                var profile = await UserService.GetProfileAsync(l.Partner);
                partnerName = string.IsNullOrWhiteSpace(profile?.DisplayName) ? l.Partner : profile.DisplayName;
            }
            catch { partnerName = l.Partner; }
        }
    }

    // Brings the list in line with the planned meals, servings and meal prep. True when it changed anything.
    private async Task<bool> SyncWithPlanAsync()
    {
        var lines = ShoppingAggregator.Merge(planned.Concat(partnerPlanned));
        var sync = ShoppingAggregator.Sync(AllItems.Select(x => x.Item), lines, dismissed);
        if (sync.IsEmpty) return false;
        var storeOf = ShoppingStores.StoreOfItems(shops);
        var fallback = DefaultShop ?? await Stores.GetOrAddDefaultAsync(uid, Loc["ai_plan_default_shop_name"]);
        foreach (var line in sync.Add)
        {
            var store = ShoppingStores.Remembered(StoreRoute.Key(line.Key, line.Name), routes, shops) ?? fallback;
            var aisle = string.IsNullOrEmpty(line.Aisle) ? Aisles.For(line.Name).Key : line.Aisle;
            await ShoppingListService.AddItemAsync(uid, store.Id, line.Name, new ShoppingItemOptions(
                Quantity: ShoppingAggregator.StoredQuantity(line), Unit: line.Unit, Aisle: aisle,
                SourceMeal: line.FirstMeal, IngredientKey: line.Key, UsedIn: line.UsedIn));
        }
        foreach (var (item, line) in sync.Update)
            await ShoppingListService.UpdateAutoItemAsync(uid, storeOf[item.Id], item.Id, ShoppingAggregator.StoredQuantity(line), line.UsedIn, line.FirstMeal);
        if (sync.Remove.Count > 0)
            await ShoppingListService.RemoveItemsAsync(uid, sync.Remove.Select(i => (storeOf[i.Id], i.Id)));
        if (sync.Undismiss.Count > 0)
            await ShoppingListService.UndismissAsync(uid, sync.Undismiss);
        return sync.Add.Count + sync.Update.Count + sync.Remove.Count > 0;
    }

    // Stores without a picture yet get one from the AI (Gemini with the user's key, else the worker) in the background, once each.
    private async Task FindLogosAsync()
    {
        foreach (var shop in shops.Where(s => !s.LogoChecked && askedLogos.Add(s.Id)).ToList())
        {
            if (await StoreLogos.FindAsync(shop.Name) is not { } look) return; // the AI is not answering
            try
            {
                await Stores.SetLookAsync(uid, shop.Id, look);
                (shop.LogoDomain, shop.Emoji, shop.LogoChecked) = (look.Domain, look.Emoji, true);
                await InvokeAsync(StateHasChanged);
            }
            catch { /* tried again next visit */ }
        }
    }

    // Servings and meal prep are the same values Week shows; changing them here changes the plan and the list.
    private Task UpdatePlannedAsync(PlannedEntry entry, Action<SlotEntry> change)
    {
        change(entry.Entry);
        return (Task)ChangeAsync(() => DayPlan.UpdateEntryAsync(uid, entry.Date, entry.Slot, change));
    }

    // Measured amounts read "1.2 kg", "750 g", "3 pc"; units typed by hand are shown as written.
    private string QuantityText(ShoppingItem item)
    {
        if (ShoppingAggregator.Format(item.Quantity, item.Unit, Loc.NumberCulture()) is { } f)
            return NutFormat.Isolate($"{f.Amount} {Loc[UnitKey(f.Unit)]}");
        var unit = string.IsNullOrWhiteSpace(item.Unit) ? "" : " " + item.Unit;
        if (item.Quantity <= 1 && unit.Length == 0) return "";
        return NutFormat.Isolate($"{Loc.Num(Math.Max(1, item.Quantity))}{unit}");
    }

    private static string UnitKey(string unit) => unit switch { "kg" => "nut_kg", "g" => "nut_g", "l" => "nut_l", "ml" => "nut_ml", _ => "nut_pc" };

    private async Task QuickAddAsync()
    {
        var name = newItemName.Trim();
        if (name.Length == 0 || isBusy) return;
        newItemName = "";
        await ChangeAsync(async () =>
        {
            var shop = AddTarget ?? await Stores.GetOrAddDefaultAsync(uid, Loc["ai_plan_default_shop_name"]);
            await ShoppingListService.AddItemAsync(uid, shop.Id, name, new ShoppingItemOptions(Aisle: Aisles.For(name).Key));
        });
    }

    private async Task ToggleItemAsync(ShoppingShop shop, ShoppingItem item)
    {
        item.IsBought = !item.IsBought;                       // optimistic: the list reacts immediately
        if (item.IsBought) await BuzzAsync();
        item.BoughtAtUtc = item.IsBought ? DateTime.UtcNow : null;
        try { await ShoppingListService.SetItemBoughtAsync(uid, shop.Id, item.Id, item.IsBought); }
        catch
        {
            item.IsBought = !item.IsBought;
            Toasts.Show(Loc["nut_save_error"], isError: true);
        }
    }

    private Task ClearBoughtAsync() =>
        ChangeAsync(() => ShoppingListService.RemoveItemsAsync(uid, Clearable.Select(x => (x.Shop.Id, x.Item.Id))));

    // Empties the list. The planned meals' items stay away too, until the plan needs more of them.
    private async Task ClearListAsync()
    {
        confirmClear = false;
        var dismiss = ShoppingAggregator.Merge(planned.Concat(partnerPlanned))
            .ToDictionary(l => ShoppingAggregator.DismissKey(l.Key), ShoppingAggregator.StoredQuantity);
        var removed = AllItems.Select(x => (x.Shop.Id, x.Item)).ToList();
        var newlyDismissed = dismiss.Keys.Where(k => !dismissed.ContainsKey(k)).ToList();   // before the reload
        if (await ChangeAsync(() => ShoppingListService.ClearAsync(uid, dismiss)))
            OfferUndo(Loc["nut_clear_list_done"], removed, newlyDismissed);
    }

    private void OpenEdit(ShoppingShop shop, ShoppingItem item)
    {
        editing = item;
        editingShop = shop;
        editName = item.Name;
        editQuantity = Math.Max(1, item.Quantity);
        editUnit = item.Unit ?? "";
        editShopId = shop.Id;
    }

    private void CloseEdit() { editing = null; editingShop = null; }

    private async Task SaveEditAsync()
    {
        if (editing is not { } item || editingShop is not { } from) return;
        var (name, quantity, unit, to) = (editName.Trim(), editQuantity, string.IsNullOrWhiteSpace(editUnit) ? null : editUnit.Trim(), editShopId);
        CloseEdit();
        await ChangeAsync(async () =>
        {
            await ShoppingListService.UpdateItemAsync(uid, from.Id, item.Id, name, quantity, unit);
            if (to is { } target && target != from.Id)
            {
                (item.Name, item.Quantity, item.Unit) = (name, quantity, unit);
                // One write moves it; next time this item is on the list it goes to the same store.
                await Stores.MoveItemAsync(uid, from.Id, target, item);
            }
        });
    }

    private async Task DeleteEditingAsync()
    {
        if (editing is not { } item || editingShop is not { } shop) return;
        CloseEdit();
        await RemoveAsync(shop, item);
    }

    // Removes one item, with Undo. A plan item is remembered as removed, so the list does not add it straight back.
    private async Task RemoveAsync(ShoppingShop shop, ShoppingItem item)
    {
        var removal = ShoppingAggregator.DismissFor(item, ShoppingAggregator.Merge(planned.Concat(partnerPlanned)));
        var dismiss = removal is { } r ? new Dictionary<string, int> { [r.Key] = r.Amount } : null;
        if (await ChangeAsync(() => ShoppingListService.RemoveItemsAsync(uid, [(shop.Id, item.Id)], dismiss)))
            OfferUndo(Loc.T("nut_item_removed", item.Name), [(shop.Id, item)], dismiss?.Keys.ToList() ?? []);
    }

    private void OfferUndo(string text, List<(string ShopId, ShoppingItem Item)> items, List<string> undismiss)
    {
        Toasts.Hide();
        Undo.Offer(text, async () =>
        {
            if (!await ChangeAsync(() => ShoppingListService.RestoreItemsAsync(uid, items, undismiss))) throw new InvalidOperationException();
            await InvokeAsync(StateHasChanged);
        });
    }

    // A swipe on a row: "tick" toggles bought, "remove" removes it (with Undo).
    [JSInvokable]
    public async Task OnSwipe(string id, string action)
    {
        var parts = id.Split('/', 2);
        if (parts.Length != 2 || shops.FirstOrDefault(s => s.Id == parts[0]) is not { } shop
            || shop.Items.Values.FirstOrDefault(i => i.Id == parts[1]) is not { } item) return;
        if (action == "tick") await ToggleItemAsync(shop, item);
        else if (action == "remove") { _ = BuzzAsync(); await RemoveAsync(shop, item); }
        StateHasChanged();
    }

    private async Task BuzzAsync()
    {
        try { await JS.InvokeVoidAsync("nxtweek.buzz", 12); } catch { /* no vibration here */ }
    }

    private ElementReference listCard;
    private DotNetObjectReference<ShoppingPage>? self;
    private int swipeWatch;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (swipeWatch != 0 || isLoading || loadError) return;
        self ??= DotNetObjectReference.Create(this);
        try { swipeWatch = await JS.InvokeAsync<int>("nxtweek.swipeRows.watch", listCard, self, nameof(OnSwipe)); }
        catch { swipeWatch = -1; /* tapping still works */ }
    }

    // The open items as text, by store and in shop order, for WhatsApp and the like.
    private async Task ShareListAsync()
    {
        var all = AllItems.Where(x => !x.Item.IsBought).ToList();
        var groups = shops.Count > 1
            ? OrderedShops.Select(sh => new ShareGroup(sh.Name, Ordered(all.Where(x => x.Shop.Id == sh.Id)).Select(x => new ShareLine(x.Item.Name, PlainQuantity(x.Item))).ToList()))
            : [new ShareGroup(null, Ordered(all).Select(x => new ShareLine(x.Item.Name, PlainQuantity(x.Item))).ToList())];
        var text = ShoppingText.Build(Loc["nut_share_list_title"], groups);
        string result;
        try { result = await JS.InvokeAsync<string>("nxtweek.shareText", Loc["nut_share_list_title"], text); }
        catch { result = "failed"; }
        if (result == "copied") Toasts.Show(Loc["nut_share_list_copied"]);
        else if (result == "failed") Toasts.Show(Loc["nut_save_error"], isError: true);
    }

    // The amount without the invisible direction marks used on screen.
    private string PlainQuantity(ShoppingItem item) =>
        QuantityText(item).Replace("\u2066", "").Replace("\u2067", "").Replace("\u2068", "").Replace("\u2069", "");

    private void OpenAddStore() { storeName = ""; storeError = ""; showAddStore = true; }

    private async Task AddStoreAsync()
    {
        var name = storeName.Trim();
        if (name.Length == 0 || isBusy) return;
        if (ShoppingStores.NameTaken(name, shops)) { storeError = Loc["nut_store_exists"]; return; }
        ShoppingShop? added = null;
        await ChangeAsync(async () =>
        {
            // A list with no store yet gets its default one first, so the new store is not the default.
            await Stores.GetOrAddDefaultAsync(uid, Loc["ai_plan_default_shop_name"]);
            added = await Stores.AddShopAsync(uid, name);
        }, () => storeError = Loc["nut_save_error"]);
        if (added is null) return;
        addShopId = added.Id;
        showAddStore = false;
        _ = FindLogosAsync();
    }

    private void OpenStoreMenu(ShoppingShop shop) { menuShop = shop; storeName = shop.Name; storeError = ""; }

    private async Task RenameStoreAsync()
    {
        if (menuShop is not { } shop || isBusy) return;
        var name = storeName.Trim();
        if (name.Length == 0) return;
        if (ShoppingStores.NameTaken(name, shops, shop.Id)) { storeError = Loc["nut_store_exists"]; return; }
        var ok = true;
        await ChangeAsync(async () =>
        {
            await Stores.RenameShopAsync(uid, shop.Id, name);
            // A new name may be another chain: its picture is looked up again.
            await Stores.SetLookAsync(uid, shop.Id, null);
            askedLogos.Remove(shop.Id);
        }, () => { ok = false; storeError = Loc["nut_save_error"]; });
        if (!ok) return;
        menuShop = null;
        _ = FindLogosAsync();
    }

    // Deleting a store keeps its items: they move to the default store (or the next one) in the same write.
    private async Task DeleteStoreAsync()
    {
        if (menuShop is not { } shop || ShoppingStores.HeirOf(shop.Id, shops) is not { } heir || isBusy) return;
        var ok = true;
        await ChangeAsync(() => Stores.DeleteShopAsync(uid, shop.Id, heir.Id), () => { ok = false; storeError = Loc["nut_save_error"]; });
        if (!ok) return;
        if (addShopId == shop.Id) addShopId = null;
        menuShop = null;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (swipeWatch > 0) _ = JS.InvokeVoidAsync("nxtweek.swipeRows.unwatch", swipeWatch).AsTask();
        self?.Dispose();
        Loc.OnLanguageChanged -= OnLanguageChanged;
        foreach (var w in watches) _ = w.DisposeAsync().AsTask();
    }
}
