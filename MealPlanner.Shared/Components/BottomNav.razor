@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject IAuthService Auth
@inject IUserService UserService
@implements IDisposable

@if (!IsHidden())
{
    <nav class="mk-nav" dir="@Loc.Direction" aria-label="@Loc["app_title"]">
        <a href="" class="mk-nav-item @(IsActive("") ? "is-active" : "")" aria-current="@(IsActive("") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_week"]</span>
        </a>
        <a href="meals" class="mk-nav-item @(IsActive("meals") ? "is-active" : "")" aria-current="@(IsActive("meals") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10"/><path d="M17 21V3c-2.5 1.5-3.5 4-3.5 8H17"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_meals"]</span>
        </a>
        <a href="ai-plan" class="mk-nav-item is-center" aria-current="@(IsActive("ai-plan") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_assistant"]</span>
        </a>
        <a href="shopping" class="mk-nav-item @(IsActive("shopping") ? "is-active" : "")" aria-current="@(IsActive("shopping") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_shopping"]</span>
        </a>
        <a href="friends" class="mk-nav-item @(IsActive("friends") ? "is-active" : "")" aria-current="@(IsActive("friends") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5c2 .7 3.5 2.6 3.5 5.5"/></svg>
                @if (pendingRequests > 0) { <span class="mk-nav-badge" aria-label="@Loc.T("nav_friends_requests", pendingRequests)">@pendingRequests</span> }
            </span>
            <span class="mk-nav-label">@Loc["nav_friends"]</span>
        </a>
    </nav>
}

@code {
    private int pendingRequests;
    private bool loadingRequests;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await RefreshRequestsAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            await RefreshRequestsAsync();
            StateHasChanged();
        });
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    // The badge on Friends counts requests waiting for an answer. Failing to load it is cosmetic.
    private async Task RefreshRequestsAsync()
    {
        if (loadingRequests) return;
        loadingRequests = true;
        try
        {
            var user = await Auth.GetCurrentUserAsync();
            if (user is null || string.IsNullOrWhiteSpace(user.Uid)) { pendingRequests = 0; return; }
            var profile = await UserService.GetProfileAsync(user.Uid);
            pendingRequests = profile?.IncomingFriendRequests?.Count ?? 0;
        }
        catch { /* offline or not signed in yet */ }
        finally { loadingRequests = false; }
    }

    private string RelativePath()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var q = relative.IndexOfAny(['?', '#']);
        if (q >= 0) relative = relative[..q];
        return relative.Trim('/');
    }

    private bool IsHidden()
    {
        var path = RelativePath();
        return path.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase)
            || path.Equals("welcome", StringComparison.OrdinalIgnoreCase)
            || path.Equals("signin", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActive(string path) => RelativePath().Equals(path.Trim('/'), StringComparison.OrdinalIgnoreCase)
        // The month calendar is the second half of the Week tab.
        || (path.Length == 0 && RelativePath().Equals("month", StringComparison.OrdinalIgnoreCase));

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
