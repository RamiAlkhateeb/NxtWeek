@inject NavigationManager Nav
@inject ILocalizationService Loc
@inject IAuthService Auth
@inject IUserService UserService
@implements IDisposable

@if (!IsHidden())
{
    <nav class="mk-nav" dir="@Loc.Direction" aria-label="@Loc["app_title"]">
        <a href="" class="mk-nav-item @(IsActive("") ? "is-active" : "")" aria-current="@(IsActive("") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_week"]</span>
        </a>
        <a href="meals" class="mk-nav-item @(IsActive("meals") ? "is-active" : "")" aria-current="@(IsActive("meals") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10"/><path d="M17 21V3c-2.5 1.5-3.5 4-3.5 8H17"/></svg>
            </span>
            <span class="mk-nav-label">@Loc["nav_meals"]</span>
        </a>
        <a href="settings" class="mk-nav-item @(IsActive("settings") ? "is-active" : "")" aria-current="@(IsActive("settings") ? "page" : null)">
            <span class="mk-nav-icon" aria-hidden="true">
                <svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3 1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8 1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                @if (pendingRequests > 0) { <span class="mk-nav-badge" aria-label="@Loc.T("nav_friends_requests", pendingRequests)">@pendingRequests</span> }
            </span>
            <span class="mk-nav-label">@Loc["nav_settings"]</span>
        </a>
    </nav>
}

@code {
    private int pendingRequests;
    private bool loadingRequests;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await RefreshRequestsAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            await RefreshRequestsAsync();
            StateHasChanged();
        });
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    // The badge on Friends counts requests waiting for an answer. Failing to load it is cosmetic.
    private async Task RefreshRequestsAsync()
    {
        if (loadingRequests) return;
        loadingRequests = true;
        try
        {
            var user = await Auth.GetCurrentUserAsync();
            if (user is null || string.IsNullOrWhiteSpace(user.Uid)) { pendingRequests = 0; return; }
            var profile = await UserService.GetProfileAsync(user.Uid);
            pendingRequests = profile?.IncomingFriendRequests?.Count ?? 0;
        }
        catch { /* offline or not signed in yet */ }
        finally { loadingRequests = false; }
    }

    private string RelativePath()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var q = relative.IndexOfAny(['?', '#']);
        if (q >= 0) relative = relative[..q];
        return relative.Trim('/');
    }

    private bool IsHidden()
    {
        var path = RelativePath();
        return path.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase)
            || path.Equals("welcome", StringComparison.OrdinalIgnoreCase)
            || path.Equals("signin", StringComparison.OrdinalIgnoreCase);
    }

    // Month, Shopping and the Assistant open from Week; Profile and Friends from Settings.
    private static readonly Dictionary<string, string[]> TabChildren = new()
    {
        [""] = ["month", "shopping", "ai-plan"],
        ["meals"] = ["meal"],
        ["settings"] = ["friends"]
    };

    private bool IsActive(string path)
    {
        var current = RelativePath();
        if (current.Equals(path, StringComparison.OrdinalIgnoreCase)) return true;
        if (path.Length > 0 && current.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase)) return true;
        return TabChildren.TryGetValue(path, out var children)
            && children.Any(c => current.Equals(c, StringComparison.OrdinalIgnoreCase) || current.StartsWith(c + "/", StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
