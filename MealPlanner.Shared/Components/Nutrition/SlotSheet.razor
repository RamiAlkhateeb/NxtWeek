@inject ILocalizationService Loc
@inject IMealImageService MealImages

@* One slot, short enough to fit without scrolling: the two main actions first (mark as eaten or undo,
   change meal), then servings and meal prep, the nutrition as one line that opens into the full grid, and
   move, copy and remove at the bottom. Swipe down (or tap outside) to close. *@
<NxtBottomSheet IsOpen="IsOpen && Entry is not null" Eyebrow="@SlotLabel" Title="@Name" OnDismiss="OnDismiss">
    @if (Entry is not null)
    {
        var baseNutrition = Entry.Quick is { } q
            ? new NutritionInfo { Kcal = q.Kcal, Protein = q.Protein, Carbs = q.Carbs, Fat = q.Fat, Source = NutritionSource.Manual }
            : Meal?.Nutrition;
        var answered = Entry.Eaten || Entry.Skipped;
        <div class="mk-sheet-body mk-slot-sheet" dir="@Loc.Direction">
            <div class="mk-btn-row">
                <button type="button" class="mk-btn @(answered ? "is-soft" : "")" style="flex:2 1 auto" @onclick="OnToggleEaten">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>@(answered ? Loc["nut_undo"] : Loc["nut_mark_eaten"])
                </button>
                <button type="button" class="mk-btn is-soft" @onclick="OnChangeMeal">@Loc["nut_replace"]</button>
            </div>

            <div class="mk-sheet-row">
                <span class="mk-sheet-row-title">@Loc["nut_servings_label"]</span>
                <ServingsStepper Value="Entry.Servings" ValueChanged="OnServings" />
            </div>

            @if (!Entry.IsQuick && ShowPrep)
            {
                <div class="mk-sheet-row mk-prep-row">
                    <span class="mk-sheet-row-title">@Loc["nut_prep"]</span>
                    <div class="mk-seg is-inset" role="group" aria-label="@Loc["nut_prep"]">
                        @foreach (var k in new[] { 1, 2, 3 })
                        {
                            var batches = k;
                            <button type="button" class="@(Entry.PrepBatches == batches ? "is-active" : "")" aria-pressed="@(Entry.PrepBatches == batches ? "true" : "false")" @onclick="() => OnPrep.InvokeAsync(batches)">@(batches == 1 ? Loc["nut_off"] : NutFormat.Times(batches.ToString()))</button>
                        }
                    </div>
                </div>
            }

            @if (baseNutrition is not null)
            {
                <button type="button" class="mk-nut-line" aria-expanded="@(showNutrition ? "true" : "false")" @onclick="() => showNutrition = !showNutrition">
                    <span class="mk-nut-line-values">
                        <b>@Loc.Num(baseNutrition.Kcal * Entry.Servings) @Loc["nut_kcal"]</b>
                        <span class="mk-nut-line-p">@Loc.Num(baseNutrition.Protein * Entry.Servings) @Loc["nut_g"] @Loc["nut_protein"]</span>
                        <SourceBadge Source="@baseNutrition.Source" />
                    </span>
                    <span class="mk-nut-line-more">@(showNutrition ? Loc["nut_less"] : Loc["nut_details"])
                        <svg class="i mk-past-chev @(showNutrition ? "is-open" : "")" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </span>
                </button>
                @if (showNutrition)
                {
                    <section class="mk-nut">
                        <span class="mk-nut-head-title">@Loc["nut_per_serving"] × @Loc.Servings(Entry.Servings)</span>
                        <NutritionGrid Nutrition="baseNutrition" Servings="Entry.Servings" />
                        <div class="mk-gauge-row"><ProteinGauge Protein="baseNutrition.Protein" /><span>@Loc["nut_aim"]</span></div>
                    </section>
                }
            }
            else if (Meal is not null)
            {
                <MealNutritionPanel Meal="Meal" OnSaved="_ => OnMealSaved.InvokeAsync()" />
            }

            <div class="mk-sheet-actions">
                <button type="button" class="mk-btn is-sm is-soft" @onclick="OnMove">
                    <svg class="i mk-flip-rtl" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>@Loc["nut_move"]
                </button>
                <button type="button" class="mk-btn is-sm is-soft" @onclick="OnCopy">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/></svg>@Loc["nut_copy_to_day"]
                </button>
                <button type="button" class="mk-btn is-sm is-soft is-danger-text" @onclick="OnRemove">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>@Loc["nut_remove"]
                </button>
            </div>
        </div>
    }
</NxtBottomSheet>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public MealSlot Slot { get; set; }
    [Parameter] public string Time { get; set; } = "";
    [Parameter] public SlotEntry? Entry { get; set; }
    [Parameter] public MealCatalogItem? Meal { get; set; }
    /// <summary>Meal prep only applies to this week's shopping.</summary>
    [Parameter] public bool ShowPrep { get; set; }
    [Parameter] public EventCallback<double> OnServings { get; set; }
    [Parameter] public EventCallback<int> OnPrep { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnToggleEaten { get; set; }
    [Parameter] public EventCallback OnChangeMeal { get; set; }
    [Parameter] public EventCallback OnMove { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }
    /// <summary>The slot's name as shown (Ramadan mode renames slots).</summary>
    [Parameter] public string? SlotName { get; set; }
    [Parameter] public EventCallback OnMealSaved { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private bool showNutrition;
    private MealSlot? shownSlot;

    // The nutrition details start closed for each slot opened.
    protected override void OnParametersSet()
    {
        if (!IsOpen) { shownSlot = null; return; }
        if (shownSlot != Slot) { shownSlot = Slot; showNutrition = false; }
    }

    private string Name => Entry?.Quick?.Name ?? Meal?.Name ?? "";
    private string SlotLabel => string.IsNullOrEmpty(Time) ? (SlotName ?? Loc["nut_slot_" + Slot]) : Loc.T("nut_slot_time", SlotName ?? Loc["nut_slot_" + Slot], Time);
}
