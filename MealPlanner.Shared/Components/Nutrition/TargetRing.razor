@using System.Globalization
@implements IAsyncDisposable
@inject ILocalizationService Loc
@inject IJSRuntime JS

@* A smartwatch-style ring: the solid arc is what was eaten, the faint arc what is planned on top, the grey track
   what is still open. The ring always starts at 12 o'clock and runs clockwise, in every language.
   With OverIsGood (water) going past the target is a goal reached, not an "over". With OnTap the whole ring is a
   button (water: tap to add a glass), and OnLongPress adds a hold (water: hold to remove a glass, nxtweek.longPress). *@
@{
    var (eatenArc, plannedArc, reached) = DayStatus.RingArcs(Eaten, Planned, Target);
    var done = OverIsGood && Target > 0 && Eaten >= Target;
    var over = reached && !OverIsGood;
    var left = Math.Round(Target - Eaten);
    var leftText = Loc.T(over ? "nut_unit_over" : "nut_unit_left", Unit);
    var status = done ? DoneText ?? "" : $"{Loc.Num(Math.Abs(left))} {leftText}";
    var label = Loc.T("nut_ring_label", Label, Loc.Num(Eaten), Loc.Num(Target), Unit, status);
    var colour = over ? "var(--mk-accent)" : Colour;
}
<div class="mk-ring @(over ? "is-over" : "") @(done ? "is-done" : "") @CssClass">
    @if (OnTap.HasDelegate)
    {
        <button type="button" class="mk-ring-figure is-tap" aria-label="@($"{label}. {TapLabel}")" @ref="tapButton" @onclick="TapAsync">
            @Body(colour, eatenArc, plannedArc, done, left, leftText)
        </button>
    }
    else
    {
        <figure class="mk-ring-figure" role="img" aria-label="@label">
            @Body(colour, eatenArc, plannedArc, done, left, leftText)
        </figure>
    }
</div>

@code {
    private const double R = 50;
    private static readonly double Circumference = 2 * Math.PI * R;

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public double Eaten { get; set; }
    [Parameter] public double Planned { get; set; }
    [Parameter] public double Target { get; set; }
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Colour { get; set; } = "var(--mk-kc)";
    /// <summary>Past the target is good (water): the ring stays in its colour and shows <see cref="DoneText"/>.</summary>
    [Parameter] public bool OverIsGood { get; set; }
    /// <summary>The line under the ring once the target is reached ("Goal reached").</summary>
    [Parameter] public string? DoneText { get; set; }
    /// <summary>The small line in the middle, instead of "of {target} {unit}".</summary>
    [Parameter] public string? OfText { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Makes the whole ring a button (water: add a glass).</summary>
    [Parameter] public EventCallback OnTap { get; set; }
    /// <summary>What a tap does, read after the ring's numbers ("Tap to add a glass").</summary>
    [Parameter] public string? TapLabel { get; set; }
    /// <summary>Holding the ring (only with <see cref="OnTap"/>): water removes a glass.</summary>
    [Parameter] public EventCallback OnLongPress { get; set; }

    private ElementReference tapButton;
    private DotNetObjectReference<TargetRing>? self;
    private int pressWatch;
    private DateTime lastLongPress;

    private Task TapAsync()
    {
        // The click right after a hold is not a tap (nxtweek.longPress swallows it too).
        if (DateTime.UtcNow - lastLongPress < TimeSpan.FromMilliseconds(700)) return Task.CompletedTask;
        return OnTap.InvokeAsync();
    }

    [JSInvokable]
    public Task LongPressed()
    {
        lastLongPress = DateTime.UtcNow;
        return OnLongPress.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pressWatch != 0 || !OnTap.HasDelegate || !OnLongPress.HasDelegate) return;
        self ??= DotNetObjectReference.Create(this);
        try { pressWatch = await JS.InvokeAsync<int>("nxtweek.longPress.watch", tapButton, self, nameof(LongPressed), 500); }
        catch { pressWatch = -1; /* taps still work */ }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (pressWatch > 0) await JS.InvokeVoidAsync("nxtweek.longPress.unwatch", pressWatch); }
        catch { /* the page is going away */ }
        self?.Dispose();
    }

    // Spans only, so the same content is valid inside a button and inside a figure.
    private RenderFragment Body(string colour, double eatenArc, double plannedArc, bool done, double left, string leftText) => __builder =>
    {
        <span class="mk-ring-dial">
            <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="mk-ring-track" cx="60" cy="60" r="@R" />
                <circle class="mk-ring-arc is-planned @(plannedArc <= 0 ? "is-empty" : "")" cx="60" cy="60" r="@R" stroke="@Colour"
                        stroke-dasharray="@Dash(plannedArc)" stroke-dashoffset="@Offset(eatenArc)" />
                <circle class="mk-ring-arc @(eatenArc <= 0 ? "is-empty" : "")" cx="60" cy="60" r="@R" stroke="@colour" stroke-dasharray="@Dash(eatenArc)" />
            </svg>
            <span class="mk-ring-centre">
                <b>@Loc.Num(Eaten)</b>
                <span>@(OfText ?? Loc.T("nut_ring_of", Loc.Num(Target), Unit))</span>
            </span>
        </span>
        <span class="mk-ring-caption">
            <span class="mk-ring-label"><i style="background:@Colour"></i>@Label</span>
            @if (done)
            {
                <span class="mk-ring-left is-done">@DoneText</span>
            }
            else
            {
                <span class="mk-ring-left"><b>@Loc.Num(Math.Abs(left))</b> @leftText</span>
            }
        </span>
    };

    // An arc of the given share of the ring, as "length gap".
    private static string Dash(double share) =>
        string.Create(CultureInfo.InvariantCulture, $"{share * Circumference:0.##} {Circumference:0.##}");

    // The planned arc starts where the eaten one ends.
    private static string Offset(double share) =>
        (-share * Circumference).ToString("0.##", CultureInfo.InvariantCulture);
}
