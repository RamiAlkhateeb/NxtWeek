@inject ILocalizationService Loc

@* The day against its targets: calories and protein as two rings, each with what is left (or over).
   "Details" adds eaten / planned / open, and carbs and fat only when the user tracks them. *@
@{
    var t = Totals.Targets;
    var e = Totals.Eaten;
    var pl = Totals.Planned;
}
<section class="mk-tp" aria-label="@Loc["nut_daily_targets"]">
    <div class="mk-rings">
        <TargetRing Label="@Loc["nut_calories"]" Colour="var(--mk-kc)" Eaten="e.Kcal" Planned="pl.Kcal" Target="t.Kcal" Unit="@Loc["nut_kcal"]" />
        <TargetRing Label="@Loc["nut_protein"]" Colour="var(--mk-pro)" Eaten="e.Protein" Planned="pl.Protein" Target="t.Protein" Unit="@Loc["nut_g"]" />
    </div>

    @if (expanded)
    {
        <div class="mk-tp-more" id="mk-tp-more">
            <div class="mk-legend">
                <span><i style="background:var(--mk-kc)"></i>@Loc["nut_eaten"] @Loc.Num(e.Kcal)</span>
                <span><i style="background:var(--mk-kc);opacity:.35"></i>@Loc["nut_planned"] @Loc.Num(pl.Kcal)</span>
                <span><i class="is-open"></i>@Loc["nut_open"] @Loc.Num(Math.Max(0, Totals.OpenKcal))</span>
            </div>
            @if (TrackMacros)
            {
                <div class="mk-tp-macro-pair">
                    <div>
                        <span class="mk-tp-small">@Loc.T("nut_of_target", Loc["nut_carbs"], Loc.Num(e.Carbs), Loc.Num(t.Carbs), Loc["nut_g"])</span>
                        <MacroBar Eaten="e.Carbs" Planned="pl.Carbs" Target="t.Carbs" Colour="var(--mk-carb)" Thin="true" />
                    </div>
                    <div>
                        <span class="mk-tp-small">@Loc.T("nut_of_target", Loc["nut_fat"], Loc.Num(e.Fat), Loc.Num(t.Fat), Loc["nut_g"])</span>
                        <MacroBar Eaten="e.Fat" Planned="pl.Fat" Target="t.Fat" Colour="var(--mk-fat)" Thin="true" />
                    </div>
                </div>
            }
            <div class="mk-tp-hint">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                <span>@Loc["nut_aim"]</span>
            </div>
        </div>
    }

    <div class="mk-tp-foot">
        <button type="button" class="mk-tp-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="mk-tp-more" @onclick="() => expanded = !expanded">
            @(expanded ? Loc["nut_less"] : Loc["nut_details"])
            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="@(expanded ? "M6 15l6-6 6 6" : "M6 9l6 6 6-6")"/></svg>
        </button>
        @FootContent
    </div>
</section>

@code {
    [Parameter, EditorRequired] public DayTotals Totals { get; set; } = default!;
    /// <summary>Settings → "Track carbs and fat". Off: Details shows calories only.</summary>
    [Parameter] public bool TrackMacros { get; set; }
    /// <summary>Extra buttons beside Details ("Plan my day").</summary>
    [Parameter] public RenderFragment? FootContent { get; set; }

    private bool expanded;
}
