@inject ILocalizationService Loc
@inject IMealImageService MealImages

@* One meal of the day. Empty: a single "Add a meal" target. Filled: the meal or quick add with its
   tags and nutrition; tapping it opens the slot sheet. Once today's planned meal is past its time,
   the card asks "Did you eat this?" — there is no tick button. *@
@if (Entry is null)
{
    <button type="button" class="mk-slot is-empty" aria-label="@Loc.T("nut_slot_entry", SlotLabel, Loc["nut_add_meal"])" @onclick="OnAdd">
        <span class="mk-slot-body">
            <span class="mk-slot-label">@SlotLabel</span>
            <span class="mk-slot-add">@Loc["nut_add_meal"]</span>
        </span>
        <span class="mk-slot-plus" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>
    </button>
}
else
{
    var n = DayMath.Of(Entry, _ => Meal?.Nutrition);
    var name = Entry.Quick?.Name ?? Meal?.Name ?? "";
    <div class="mk-slot is-filled @(Entry.Eaten || Entry.Skipped ? "is-eaten" : "")">
        <button type="button" class="mk-slot-open" aria-label="@Loc.T("nut_slot_entry", Loc["nut_slot_" + Slot], name)" @onclick="OnOpen">
            @if (Entry.IsQuick || Meal is null)
            {
                <span class="mk-slot-tile is-quick" aria-hidden="true"><svg class="i" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span>
            }
            else
            {
                <span class="mk-slot-tile mk-tile @MealTypeStyle.T(Meal.MealType)" aria-hidden="true"><img src="@MealImages.GetImageUrl(Meal)" alt="" loading="lazy" /></span>
            }
            <span class="mk-slot-body">
                <span class="mk-slot-label">
                    @SlotLabel
                    @if (Entry.Eaten) { <span class="mk-tag is-ok">@Loc["nut_eaten_tag"]</span> }
                    else if (Entry.Skipped) { <span class="mk-tag">@Loc["nut_skipped"]</span> }
                    @if (Entry.Leftover) { <span class="mk-tag is-warn">@Loc["nut_leftover"]</span> }
                    @if (Entry.IsQuick) { <span class="mk-tag is-accent">@Loc["nut_quick_tag"]</span> }
                    @if (Entry.Servings != 1) { <span class="mk-tag">@NutFormat.Times(Loc.Servings(Entry.Servings))</span> }
                    @if (Entry.PrepBatches > 1) { <span class="mk-tag is-ok">@Loc["nut_prep"] @NutFormat.Times(Entry.PrepBatches.ToString())</span> }
                </span>
                <span class="mk-slot-name @(Entry.Skipped ? "is-struck" : "")">@name</span>
                @if (n.Missing)
                {
                    <NutritionChips Nutrition="null" />
                }
                else
                {
                    var shown = new NutritionInfo { Kcal = n.Totals.Kcal, Protein = n.Totals.Protein, Source = n.Source ?? NutritionSource.Manual };
                    <NutritionChips Nutrition="shown" />
                }
            </span>
        </button>
        @if (AskEaten)
        {
            <div class="mk-checkin" role="group" aria-label="@Loc.T("nut_slot_entry", Loc["nut_did_eat"], name)">
                <span class="mk-checkin-q">@Loc["nut_did_eat"]</span>
                <button type="button" class="mk-btn is-sm" @onclick="() => OnAnswer.InvokeAsync(true)">
                    <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>@Loc["nut_yes"]
                </button>
                <button type="button" class="mk-btn is-sm is-card" @onclick="() => OnAnswer.InvokeAsync(false)">@Loc["nut_no"]</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public MealSlot Slot { get; set; }
    [Parameter] public string Time { get; set; } = "";
    /// <summary>The slot's name; differs from the default in Ramadan mode.</summary>
    [Parameter] public string? Name { get; set; }
    [Parameter] public SlotEntry? Entry { get; set; }
    [Parameter] public MealCatalogItem? Meal { get; set; }
    /// <summary>Today's planned meal whose time has passed: show "Did you eat this?".</summary>
    [Parameter] public bool AskEaten { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    /// <summary>True = eaten, false = skipped.</summary>
    [Parameter] public EventCallback<bool> OnAnswer { get; set; }

    private string SlotName => Name ?? Loc["nut_slot_" + Slot];
    private string SlotLabel => string.IsNullOrEmpty(Time) ? SlotName : Loc.T("nut_slot_time", SlotName, Time);
}
