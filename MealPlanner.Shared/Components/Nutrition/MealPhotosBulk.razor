@implements IDisposable
@inject IMealPhotoService Photos
@inject IMealCatalogService Catalog
@inject IMealImageService MealImages
@inject ILocalizationService Loc

@* Settings → Advanced: AI photos for every meal (in the app's language) that has none yet, one after another,
   drawn for free by the photo worker. Shows progress, can be stopped, waits once when asked to slow down, and
   stops by itself when today's free allowance is used up or the service cannot be reached.
   The photos are shared with everyone, so each meal only ever needs one. *@
<div class="mk-bulk-photos" dir="@Loc.Direction">
    <span class="mk-sheet-row-copy">
        <span class="mk-sheet-row-title">@Loc["nut_photos_bulk_title"]</span>
        <span class="mk-sheet-row-hint">@Loc["nut_photos_bulk_hint"]</span>
    </span>

    @if (missing is null)
    {
        @if (message is { Length: > 0 }) { <p class="mk-subtitle" role="status">@message</p> }
        <button class="mk-btn is-soft is-sm" disabled="@isCounting" @onclick="CountAsync">@Loc["nut_photos_bulk_check"]</button>
    }
    else if (running)
    {
        <div class="mk-bulk-progress" role="status" aria-live="polite">
            <span>@Loc.T("nut_photos_bulk_progress", Loc.Num(done), Loc.Num(total), current)</span>
            <span class="mk-bar"><i style="width:@(total == 0 ? 0 : done * 100 / total)%"></i></span>
        </div>
        <button class="mk-btn is-soft is-sm" @onclick="() => cancel?.Cancel()">@Loc["nut_photos_bulk_stop"]</button>
    }
    else
    {
        @if (message is { Length: > 0 }) { <p class="mk-subtitle" role="status">@message</p> }
        @if (hasOwnerCode)
        {
            <p class="mk-subtitle">@Loc["nut_owner_code_on"]</p>
        }
        else if (quota is { } q)
        {
            <p class="mk-subtitle">@Loc.T("nut_photos_left_week", Loc.Num(q.Left), Loc.Num(q.Limit))</p>
        }
        @if (missing.Count == 0)
        {
            <p class="mk-subtitle">@Loc["nut_photos_bulk_none"]</p>
        }
        else if (!hasOwnerCode && quota is { Left: 0 })
        {
            <p class="mk-subtitle">@Loc.T("nut_photo_err_weekly", Loc.Num(MealPhotoService.WeeklyLimit))</p>
        }
        else
        {
            <button class="mk-btn is-sm" @onclick="RunAsync">@Loc.T("nut_photos_bulk_start", Loc.Num(Batch))</button>
        }
    }
    <details class="mk-owner-code">
        <summary>@Loc["nut_owner_code"]</summary>
        <form class="mk-store-rename" @onsubmit="SaveOwnerCodeAsync" @onsubmit:preventDefault>
            <label class="mk-search"><input type="password" autocomplete="off" aria-label="@Loc["nut_owner_code"]" placeholder="@Loc["nut_owner_code"]" @bind="ownerCode" @bind:event="oninput" /></label>
            <button type="submit" class="mk-btn is-sm">@Loc["save"]</button>
        </form>
        <span class="mk-subtitle">@Loc["nut_owner_code_hint"]</span>
    </details>
</div>

@code {
    private bool isCounting, running;
    private List<MealCatalogItem>? missing;
    private PhotoQuota? quota;
    private string ownerCode = "";
    private bool hasOwnerCode;

    protected override async Task OnInitializedAsync()
    {
        ownerCode = await Photos.GetOwnerCodeAsync() ?? "";
        hasOwnerCode = ownerCode.Length > 0;
    }

    private async Task SaveOwnerCodeAsync()
    {
        await Photos.SetOwnerCodeAsync(ownerCode);
        hasOwnerCode = ownerCode.Trim().Length > 0;
        message = hasOwnerCode ? Loc["nut_owner_code_saved"] : "";
    }

    // Never more than this week's photos left.
    private int Batch => hasOwnerCode ? missing?.Count ?? 0 : Math.Min(missing?.Count ?? 0, quota?.Left ?? MealPhotoService.WeeklyLimit);
    private int done, total;
    private string current = "", message = "";
    private CancellationTokenSource? cancel;

    // Meals in the app's language without their own private photo or a shared one.
    private async Task CountAsync()
    {
        isCounting = true;
        message = "";
        try
        {
            await MealImages.EnsureLoadedAsync();
            var meals = (await Catalog.GetAllMealsAsync())
                .Where(m => !m.IsArchived && string.IsNullOrWhiteSpace(m.PhotoUrl) && !MealImages.HasPhoto(m.Id)
                         && string.Equals(string.IsNullOrWhiteSpace(m.Language) ? "ar" : m.Language, Loc.CurrentLanguage, StringComparison.OrdinalIgnoreCase))
                .ToList();
            var list = new List<MealCatalogItem>();
            foreach (var m in meals) if (!await Photos.HasAsync(m.Id)) list.Add(m);
            missing = list;
            quota = await Photos.GetQuotaAsync();
        }
        catch { message = Loc["nut_load_error"]; missing = new(); }
        finally { isCounting = false; }
    }

    private async Task RunAsync()
    {
        if (missing is not { Count: > 0 }) return;
        running = true;
        message = "";
        done = 0;
        total = Batch;
        cancel = new CancellationTokenSource();
        var left = new List<MealCatalogItem>(missing);
        var made = 0;
        try
        {
            foreach (var meal in missing.Take(total))
            {
                if (cancel.IsCancellationRequested) break;
                current = meal.Name;
                StateHasChanged();
                try
                {
                    try { await Photos.GenerateAsync(meal); }
                    catch (MealPhotoException busy) when (busy.Problem == MealPhotoProblem.Busy)
                    {
                        // Too fast for the per-minute limit: wait once, then try this meal again.
                        await Task.Delay(TimeSpan.FromSeconds(30), cancel.Token);
                        await Photos.GenerateAsync(meal);
                    }
                    left.Remove(meal);
                    made++;
                }
                catch (MealPhotoException failed) when (failed.Problem == MealPhotoProblem.Failed)
                {
                    // One dish the model would not draw: skip it and carry on.
                }
                catch (TaskCanceledException) { break; }
                catch (Exception ex)
                {
                    message = MealPhotoException.Describe(Loc, ex);
                    break;
                }
                done++;
            }
            if (message.Length == 0) message = Loc.T("nut_photos_bulk_done", Loc.Num(made));
        }
        finally
        {
            missing = left;
            running = false;
            try { quota = await Photos.GetQuotaAsync(); } catch { /* keep the last count */ }
        }
    }

    public void Dispose() => cancel?.Cancel();
}
