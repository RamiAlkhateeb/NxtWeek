@inject ILocalizationService Loc
@inject IMealImageService MealImages

@* Up to three meals for an empty slot, with why each one fits. *@
<NxtBottomSheet IsOpen="IsOpen" Title="@Loc.T("nut_suggest_for", Loc["nut_slot_" + Slot])" OnDismiss="OnDismiss">
    <div class="mk-sheet-body" dir="@Loc.Direction">
        <section class="mk-card mk-budget">
            <div class="mk-tp-row">
                <span class="mk-sheet-row-title">@Loc["nut_open"]</span>
                <span><b>@Loc.Num(Math.Max(0, Totals.OpenKcal))</b> @Loc["nut_kcal"] · <b>@Loc.Num(Math.Max(0, Totals.OpenProtein))</b> @Loc["nut_g"] @Loc["nut_protein"]</span>
            </div>
            <MacroBar Eaten="Totals.Eaten.Kcal + Totals.Planned.Kcal" Target="Totals.Targets.Kcal" Thin="true" />
            <MacroBar Eaten="Totals.Eaten.Protein + Totals.Planned.Protein" Target="Totals.Targets.Protein" Colour="var(--mk-pro)" Thin="true" />
        </section>

        @if (Items.Count == 0)
        {
            <div class="mk-note">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
                <span>@Loc["nut_no_fit"]</span>
            </div>
        }
        else
        {
            <div class="mk-suggest-list">
                @foreach (var s in Items)
                {
                    var item = s;
                    <div class="mk-suggest">
                        <span class="mk-slot-tile mk-tile @MealTypeStyle.T(item.Meal.MealType)" aria-hidden="true"><img src="@MealImages.GetImageUrl(item.Meal)" alt="" loading="lazy" /></span>
                        <span class="mk-slot-body">
                            <span class="mk-slot-name">@item.Meal.Name</span>
                            <NutritionChips Nutrition="item.Nutrition" />
                            <span class="mk-suggest-reason">@Loc.T("nut_reason", Loc.Num(item.Nutrition.Protein), Loc.Num(Math.Max(0, Totals.OpenKcal)))</span>
                        </span>
                        <button type="button" class="mk-icon-btn is-ink" aria-label="@Loc.T("nut_slot_entry", Loc.T("nut_add_to", Loc["nut_slot_" + Slot]), item.Meal.Name)" @onclick="() => OnAdd.InvokeAsync(item.Meal)">
                            <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        </button>
                    </div>
                }
            </div>
        }

        <div class="mk-btn-row">
            <button type="button" class="mk-btn is-soft" @onclick="OnBrowse">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v8M4 3v5a3 3 0 0 0 6 0V3M7 11v10"/><path d="M17 21V3c-2.5 1.5-3.5 4-3.5 8H17"/></svg>@Loc["nut_browse"]
            </button>
            <button type="button" class="mk-btn is-soft" @onclick="OnQuickAdd">
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>@Loc["nut_quick_add"]
            </button>
        </div>
    </div>
</NxtBottomSheet>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public MealSlot Slot { get; set; }
    [Parameter, EditorRequired] public DayTotals Totals { get; set; } = default!;
    [Parameter] public IReadOnlyList<Suggestion> Items { get; set; } = [];
    [Parameter] public EventCallback<MealCatalogItem> OnAdd { get; set; }
    [Parameter] public EventCallback OnBrowse { get; set; }
    [Parameter] public EventCallback OnQuickAdd { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}
