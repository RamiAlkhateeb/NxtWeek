<button type="button" class="mk-switch @(Checked ? "is-on" : "")" role="switch" aria-checked="@(Checked ? "true" : "false")" aria-label="@Label" @onclick="() => CheckedChanged.InvokeAsync(!Checked)"><i></i></button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
}
