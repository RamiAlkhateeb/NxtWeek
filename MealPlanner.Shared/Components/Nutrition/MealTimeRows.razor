@inject ILocalizationService Loc

@* One row per meal, sorted by its time: on/off, name, time. Meal 1 is always on.
   Used by Settings → Meal times and by the first-run setup. *@
<div class="mk-times" dir="@Loc.Direction">
    @foreach (var slot in Enum.GetValues<MealSlot>().OrderBy(s => Prefs.Times.GetValueOrDefault(s, ""), StringComparer.Ordinal))
    {
        var s = slot;
        var on = Prefs.IsOn(s);
        var always = s == MealSlot.Meal1;
        var name = Loc["nut_slot_" + s];
        <div class="mk-times-row @(on ? "" : "is-off")">
            <ToggleSwitch Checked="on" Disabled="always" DescribedBy="@(always ? $"always-{s}" : null)" Label="@Loc.T("nut_meal_on_for", name)" CheckedChanged="v => SetOn(s, v)" />
            <label for="tm-@s" class="mk-times-name">
                @name
                @if (always) { <small id="always-@s">@Loc["nut_always_on"]</small> }
            </label>
            <input id="tm-@s" class="mk-input mk-time" type="time" dir="ltr" disabled="@(!on)" value="@Prefs.Times.GetValueOrDefault(s)"
                   aria-label="@Loc.T("nut_time_for", name)" @onchange="e => SetTime(s, e.Value?.ToString())" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public MealPrefs Prefs { get; set; } = default!;
    /// <summary>Raised after a switch or a time changed; the owner saves.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task SetOn(MealSlot slot, bool on)
    {
        Prefs.SetOn(slot, on);
        return OnChanged.InvokeAsync();
    }

    private Task SetTime(MealSlot slot, string? value)
    {
        if (!TimeOnly.TryParse(value, out var t)) return Task.CompletedTask;
        Prefs.Times[slot] = t.ToString("HH:mm");
        return OnChanged.InvokeAsync();
    }
}
