@inject ILocalizationService Loc

@* Weight (raw weigh-ins, 7-day average, planned line) or waist over 2 or 4 weeks. Time runs
   left to right in every language, so the chart is never mirrored. *@
@{
    const double W = 340, H = 196, pl = 38, pr = 10, pt = 12, pb = 26;
    var start = Today.AddDays(-(RangeDays - 1));
    var raw = Points.Where(p => p.Date >= start && p.Date <= Today).ToList();
    var all = raw.Concat(Average).Concat(Planned).Select(p => p.Value).ToList();
}
@if (all.Count > 0)
{
    var lo = all.Min();
    var hi = all.Max();
    var pad = (hi - lo) * .15 + .2;
    lo -= pad; hi += pad;
    double X(DateOnly d) => pl + (d.DayNumber - start.DayNumber) / (double)Math.Max(1, RangeDays - 1) * (W - pl - pr);
    double Y(double v) => pt + (hi - v) / (hi - lo) * (H - pt - pb);
    string Line(IEnumerable<ChartPoint> pts) => string.Join("", pts.Select((p, k) => $"{(k == 0 ? "M" : "L")}{F(X(p.Date))} {F(Y(p.Value))}"));
    var mid = start.AddDays((RangeDays - 1) / 2);
    <div class="mk-chart" dir="ltr">
        <svg viewBox="0 0 340 196" role="img" aria-label="@AriaLabel">
            @for (var k = 0; k < 4; k++)
            {
                var v = lo + (hi - lo) * k / 3;
                <g>
                    <line x1="@F(pl)" x2="@F(W - pr)" y1="@F(Y(v))" y2="@F(Y(v))" stroke="var(--nxt-border)" stroke-width="1" />
                    <text x="@F(pl - 6)" y="@F(Y(v) + 4)" text-anchor="end" font-size="10.5" fill="var(--mk-muted)" font-weight="700">@Loc.Dec1(v)</text>
                </g>
            }
            @foreach (var (date, anchor) in new[] { (start, "start"), (mid, "middle"), (Today, "end") })
            {
                <g><text x="@F(X(date))" y="@F(H - 6)" text-anchor="@anchor" font-size="10.5" fill="var(--mk-muted)" font-weight="700">@Loc.T("nut_day_month", date.Day, Loc.GetMonthName(date.Month))</text></g>
            }
            @if (Planned.Count > 1)
            {
                <path d="@Line(Planned)" fill="none" stroke="var(--mk-ok)" stroke-width="2" stroke-dasharray="5 5" stroke-linecap="round" />
            }
            @if (IsWaist && raw.Count > 1)
            {
                <path d="@Line(raw)" fill="none" stroke="var(--mk-fat)" stroke-width="2.2" stroke-linejoin="round" opacity=".6" />
            }
            @foreach (var p in raw)
            {
                <circle cx="@F(X(p.Date))" cy="@F(Y(p.Value))" r="@(IsWaist ? "3.6" : "2.6")" fill="@(IsWaist ? "var(--mk-fat)" : "var(--mk-muted)")" opacity="@(IsWaist ? "1" : ".55")" />
            }
            @if (Average.Count > 1)
            {
                <path d="@Line(Average)" fill="none" stroke="var(--mk-kc)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            }
            @if (raw.Count == 1)
            {
                <g><text x="@F(X(raw[0].Date) + 8)" y="@F(Y(raw[0].Value) - 8)" font-size="11" font-weight="800" fill="var(--nxt-text)">@Loc.Dec1(raw[0].Value)</text></g>
            }
        </svg>
    </div>
    <div class="mk-legend">
        @if (IsWaist)
        {
            <span><i style="background:var(--mk-fat)"></i>@Loc["nut_waist"] (@Loc["nut_cm"])</span>
        }
        else
        {
            <span><i style="background:var(--mk-muted);opacity:.55"></i>@Loc["nut_raw"]</span>
            <span><i style="background:var(--mk-kc)"></i>@Loc["nut_avg7"]</span>
            @if (Planned.Count > 1) { <span><i style="background:var(--mk-ok)"></i>@Loc["nut_plan_line"]</span> }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartPoint> Points { get; set; } = [];
    [Parameter] public IReadOnlyList<ChartPoint> Average { get; set; } = [];
    [Parameter] public IReadOnlyList<ChartPoint> Planned { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public int RangeDays { get; set; } = 28;
    [Parameter] public bool IsWaist { get; set; }

    private string AriaLabel => IsWaist ? Loc["nut_waist"] : Loc["nut_weight_tab"];
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
