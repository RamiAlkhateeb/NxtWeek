@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Nutrition

@* A store's picture: its logo (from the domain the AI found), else its emoji, else its first letter.
   A logo that fails to load falls back to the emoji or letter. *@
<span class="mk-store-thumb @(Small ? "is-sm" : "")" aria-hidden="true">
    @if (Shop.LogoDomain is { Length: > 0 } domain && !failed)
    {
        <img src="@StoreLogo.IconUrl(domain)" alt="" loading="lazy" referrerpolicy="no-referrer" @onerror="() => failed = true" />
    }
    else if (Shop.Emoji is { Length: > 0 } emoji)
    {
        <span class="mk-store-thumb-emoji">@emoji</span>
    }
    else
    {
        <span class="mk-store-thumb-letter">@StoreLogo.Initial(Shop.Name)</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public ShoppingShop Shop { get; set; } = default!;
    [Parameter] public bool Small { get; set; }

    private bool failed;
    private string? shownDomain;

    protected override void OnParametersSet()
    {
        if (shownDomain == Shop.LogoDomain) return;
        shownDomain = Shop.LogoDomain;
        failed = false;
    }
}
