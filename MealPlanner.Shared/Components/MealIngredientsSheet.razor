@using MealPlanner.Shared.Models
@using MealPlanner.Shared.Services
@inject ILocalizationService Loc

@* "What's in this dish": opened from the Week hero and (indirectly) the Meals grid. *@
<NxtBottomSheet IsOpen="IsOpen" Title="@MealName" Eyebrow="@(MealType is null ? null : Loc.GetMealTypeName(MealType.Value))" OnDismiss="OnDismiss">
    <div class="mk-sheet-body mk-ingredients-sheet" dir="@Loc.Direction">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <div class="mk-tile mk-sheet-tile @MealTypeStyle.T(MealType)"><img src="@ImageUrl" alt="@MealName" loading="lazy" /></div>
        }

        @if (CatalogMeal is not null)
        {
            <MealNutritionPanel Meal="CatalogMeal" />
        }

        <MealIngredientRows Ingredients="Ingredients" MealName="@MealName" />

        @if (SideDishes is { Count: > 0 })
        {
            <div class="mk-sides">
                <span class="mk-label">@Loc["meal_side_dishes"]</span>
                @foreach (var side in SideDishes) { <span class="mk-pill">@side</span> }
            </div>
        }

        @ChildContent
    </div>
</NxtBottomSheet>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string MealName { get; set; } = "";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public MealType? MealType { get; set; }
    [Parameter] public List<string>? Ingredients { get; set; }
    [Parameter] public List<string>? SideDishes { get; set; }
    /// <summary>The catalog row, when known: shows (and edits) its nutrition per serving.</summary>
    [Parameter] public MealCatalogItem? CatalogMeal { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
