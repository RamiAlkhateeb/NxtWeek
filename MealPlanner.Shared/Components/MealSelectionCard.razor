@using MealPlanner.Shared.Models

<article class="meal-selection-card ui-card" dir="rtl" @onclick="HandleCardClick">
    <div class="meal-selection-main" role="button" tabindex="0" aria-label="تعديل @Meal.Name">
        <h2>@Meal.Name</h2>
        <div class="badges-row">
            <span class="badge type-badge">@Meal.MealType</span>
        </div>
    </div>
    <div class="meal-selection-actions">
        <button class="icon-action" title="المفضلة" aria-label="المفضلة" @onclick="() => OnFavorite.InvokeAsync(Meal)" @onclick:stopPropagation="true">@(IsFavorite ? "❤️" : "♡")</button>
        @if (IsContextMode)
        {
            <span @onclick:stopPropagation="true"><UiButton Variant="primary" CssClass="meal-select-button" OnClick="() => OnSelect.InvokeAsync(Meal)">✓ اختر هذه الوجبة</UiButton></span>
        }
        else
        {
            <span @onclick:stopPropagation="true"><UiButton Variant="secondary" CssClass="meal-select-button" OnClick="() => OnSelect.InvokeAsync(Meal)">استخدام هذه الوجبة</UiButton></span>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public MealCatalogItem Meal { get; set; } = new();
    [Parameter] public bool IsContextMode { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback<MealCatalogItem> OnSelect { get; set; }
    [Parameter] public EventCallback<MealCatalogItem> OnFavorite { get; set; }
    [Parameter] public EventCallback<MealCatalogItem> OnView { get; set; }
    private Task HandleCardClick() => IsContextMode ? Task.CompletedTask : OnView.InvokeAsync(Meal);
}
