@using System.Globalization
@inject ILocalizationService Loc

<header class="selected-day-header" dir="@Loc.Direction">
    <span class="caption">@(Loc.IsArabic ? "إضافة وجبة إلى" : "Add meal to")</span>
    <strong>🍲 @Date.ToString("dddd d MMMM", Loc.IsArabic ? ArabicCulture : EnglishCulture)</strong>
    <h1>@(Loc.IsArabic ? "اختر وجبة" : "Choose Meal")</h1>
</header>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    private static readonly CultureInfo ArabicCulture = new("ar-EG");
    private static readonly CultureInfo EnglishCulture = new("en-US");
}
