@inject ILocalizationService Loc

<header class="selected-day-header" dir="@Loc.Direction">
    <span class="caption">@Loc["selectedday_add_to"]</span>
    <strong>🍲 @Loc.FormatDayDate(Date)</strong>
    <h1>@Loc["week_choose_meal"]</h1>
</header>

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
}
