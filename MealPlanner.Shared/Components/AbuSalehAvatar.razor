@* Abu Saleh, as a logo mark: a colour badge with just the face, no body — the
   same composition as wwwroot/logo.svg, but themeable (uses the CSS custom
   properties) since it renders inline rather than as a static PNG icon.
   Use this wherever the mascot sits beside the wordmark (the Week header);
   use the full-body <AbuSaleh> for loading and empty states. *@
<svg class="abu-saleh-avatar @CssClass" viewBox="0 0 200 200" width="@Size" height="@Size"
     role="@(string.IsNullOrWhiteSpace(Label) ? "presentation" : "img")"
     aria-hidden="@(string.IsNullOrWhiteSpace(Label) ? "true" : null)"
     aria-label="@Label"
     xmlns="http://www.w3.org/2000/svg">
    <circle cx="100" cy="100" r="100" fill="var(--color-primary)" />
    <circle cx="100" cy="106" r="72" fill="#FFFCF2" />

    <circle cx="61" cy="98" r="9" fill="#E5B189" />
    <circle cx="139" cy="98" r="9" fill="#E5B189" />
    <circle cx="100" cy="94" r="38" fill="#F0C9A4" />
    <path d="M78 70c8-9 36-11 46 2-14-6-32-6-46-2Z" fill="#FFFFFF" opacity=".45" />

    <g stroke="#4A3B36" stroke-width="5" stroke-linecap="round" fill="none">
        <path d="M80 82c4-4 10-4 14-1" />
        <path d="M120 82c-4-4-10-4-14-1" />
    </g>
    <circle cx="87" cy="94" r="5" fill="#3A2A38" />
    <circle cx="113" cy="94" r="5" fill="#3A2A38" />
    <path d="M100 98v8" stroke="#D9A97F" stroke-width="5" stroke-linecap="round" fill="none" />

    <path d="M100 114c-6-8-18-10-24-4-5 5-2 12 6 13 8 1 15-3 18-9 3 6 10 10 18 9 8-1 11-8 6-13-6-6-18-4-24 4Z"
          fill="#4A3B36" />
    <path d="M88 126c7 7 17 7 24 0" fill="none" stroke="#B9836A" stroke-width="4" stroke-linecap="round" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 44;
    [Parameter] public string CssClass { get; set; } = "";

    /// <summary>Accessible name. Left empty the mark is decorative — the right
    /// call next to a wordmark that already says "Sahtein".</summary>
    [Parameter] public string? Label { get; set; }
}
