@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Loc
@using MealPlanner.Shared.Components
@using MealPlanner.Shared.Services

@if (isInitializing)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; background-color: #0b0b0d;">
        <span style="font-size: 64px; animation: bounce 1.5s infinite;">🍳</span>
        <p style="font-family: sans-serif; color: #a89a9b; font-size: 18px; margin-top: 16px;">@Loc["loading"]</p>
    </div>
}
else
{
    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(MealPlanner.Shared._Imports).Assembly }">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">@Loc["not_found"]</p>
            </LayoutView>
        </NotFound>
    </Router>

    @if (needsEmailConfirmation)
    {
        <div class="ios-install-backdrop">
            <section class="ios-install-guide" dir="@Loc.Direction">
                <span class="ios-install-icon">✉️</span>
                <h2>@Loc["email_confirm_title"]</h2>
                <p>@Loc["email_confirm_desc"]</p>
                <input class="ui-text-input" type="email" @bind="confirmationEmail" placeholder="name@example.com" />
                @if (!string.IsNullOrWhiteSpace(emailLinkError)) { <p class="error-msg">@emailLinkError</p> }
                <button @onclick="CompleteEmailLink" disabled="@string.IsNullOrWhiteSpace(confirmationEmail)">@Loc["email_confirm_continue"]</button>
            </section>
        </div>
    }

    @if (showFirstLaunchWizard)
    {
        <div class="welcome-wizard-backdrop" role="dialog" aria-modal="true" aria-labelledby="welcome-wizard-title">
            <section class="welcome-wizard" dir="@Loc.Direction">
                <button class="welcome-wizard-close" @onclick="DismissFirstLaunchWizard" aria-label="@Loc["wizard_close"]">✕</button>
                <div class="welcome-wizard-head">
                    <h2 id="welcome-wizard-title">@Loc["wizard_title"]</h2>
                    <p>@Loc.T("wizard_steps", welcomeSlide + 1)</p>
                </div>

                <AddToHomeCarousel @bind-Current="welcomeSlide" ShowProgress="false" OnFinish="DismissFirstLaunchWizard" />

                <button class="welcome-wizard-skip" @onclick="DismissFirstLaunchWizard">@Loc["wizard_skip"]</button>
            </section>
        </div>
    }

    @if (showIosInstallGuide && !needsEmailConfirmation && !showFirstLaunchWizard)
    {
        <div class="ios-home-guide-backdrop" role="presentation">
            <section class="ios-home-guide" dir="@Loc.Direction" role="dialog" aria-modal="true" aria-labelledby="ios-home-guide-title">
                <span class="ios-home-guide-icon" aria-hidden="true">📲</span>
                <h2 id="ios-home-guide-title">@Loc["ios_guide_title"]</h2>
                <p>@Loc["ios_guide_desc"]</p>
                <img class="ios-home-guide-gif" src="@($"assets/ios-add-to-home.gif?play={iosGuideReplayKey}")" alt="@Loc["ios_guide_alt"]" />
                <div class="ios-home-guide-actions">
                    <button class="ios-home-guide-replay" @onclick="ReplayIosInstallGuide">@Loc["ios_guide_replay"]</button>
                    <button class="ios-home-guide-got-it" @onclick="DismissIosInstallGuide">@Loc["ios_guide_gotit"]</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private bool isInitializing = true;
    private bool needsEmailConfirmation;
    private bool showIosInstallGuide;
    private bool showFirstLaunchWizard;
    private int welcomeSlide;
    private string confirmationEmail = "";
    private string emailLinkError = "";
    private long iosGuideReplayKey;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Loc.InitializeAsync();
            var linked = await Auth.CompleteStoredEmailLinkAsync();
            if (linked is null && await Auth.HasPendingEmailLinkAsync()) needsEmailConfirmation = true;
            await ResolveUserAsync(linked ?? await Auth.GetCurrentUserAsync(), await Auth.GetPendingEmailLinkUsernameAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[App] Error pre-fetching profile: {ex.Message}");
        }
        finally
        {
            isInitializing = false;
        }
    }

    private async Task CompleteEmailLink()
    {
        try
        {
            var user = await Auth.CompleteEmailLinkAsync(confirmationEmail.Trim());
            if (user is null) throw new InvalidOperationException(Loc["email_link_invalid"]);
            await ResolveUserAsync(user, await Auth.GetPendingEmailLinkUsernameAsync());
            needsEmailConfirmation = false;
        }
        catch (Exception ex) { emailLinkError = ex.Message; }
    }

    // Guest Mode does not require a username. A new visitor is given an
    // auto-generated week and can pick a username later (profile icon in the
    // corner keeps a nudge until they do). Here we only ensure a local profile
    // exists so later reads have a stable key to write to.
    private async Task ResolveUserAsync(AuthUser? user, string pendingUsername)
    {
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        if (!user.IsGuest && !string.IsNullOrWhiteSpace(user.AuthUid))
        {
            var dataKey = await UserService.GetDataKeyForAuthUidAsync(user.AuthUid);
            if (string.IsNullOrWhiteSpace(dataKey) && !string.IsNullOrWhiteSpace(pendingUsername))
            {
                await UserService.LinkAuthAccountAsync(pendingUsername, user.AuthUid, user.Email);
                dataKey = pendingUsername;
            }
            if (!string.IsNullOrWhiteSpace(dataKey))
            {
                await Auth.SetActiveDataKeyAsync(dataKey);
                user = await Auth.GetCurrentUserAsync();
            }
        }
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        var profile = await UserService.GetProfileAsync(user.Uid);
        if (profile is null)
        {
            profile = new UserProfile { Uid = user.Uid, DisplayName = user.IsGuest ? Loc["guest_name"] : user.DisplayName };
            await UserService.CreateProfileAsync(profile);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("nxtweek.checkVersion");
            showFirstLaunchWizard = !needsEmailConfirmation && await JS.InvokeAsync<bool>("nxtweek.shouldShowFirstLaunchWizard");
            showIosInstallGuide = await JS.InvokeAsync<bool>("nxtweek.shouldShowIosInstallGuide");
            if (showFirstLaunchWizard || showIosInstallGuide) StateHasChanged();
        }
    }

    private async Task DismissFirstLaunchWizard()
    {
        showFirstLaunchWizard = false;
        welcomeSlide = 0;
        await JS.InvokeVoidAsync("nxtweek.markFirstLaunchWizardSeen");
    }

    private async Task DismissIosInstallGuide()
    {
        showIosInstallGuide = false;
        await JS.InvokeVoidAsync("nxtweek.markIosInstallGuideSeen");
    }

    private void ReplayIosInstallGuide() => iosGuideReplayKey = DateTime.UtcNow.Ticks;
}
