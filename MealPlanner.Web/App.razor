@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (isInitializing)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; background-color: #f8fafc;">
        <span style="font-size: 64px; animation: bounce 1.5s infinite;">🍳</span>
        <p style="font-family: sans-serif; color: #64748b; font-size: 18px; margin-top: 16px; direction: rtl;">جاري التحميل...</p>
    </div>
}
else
{
    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(MealPlanner.Shared._Imports).Assembly }">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>

    @if (needsEmailConfirmation)
    {
        <div class="ios-install-backdrop">
            <section class="ios-install-guide" dir="rtl">
                <span class="ios-install-icon">✉️</span>
                <h2>أكمل تسجيل الدخول</h2>
                <p>اكتب البريد الإلكتروني الذي أرسلنا إليه الرابط للتأكد من هويتك.</p>
                <input class="ui-text-input" type="email" @bind="confirmationEmail" placeholder="name@example.com" />
                @if (!string.IsNullOrWhiteSpace(emailLinkError)) { <p class="error-msg">@emailLinkError</p> }
                <button @onclick="CompleteEmailLink" disabled="@string.IsNullOrWhiteSpace(confirmationEmail)">متابعة</button>
            </section>
        </div>
    }
}

@code {
    private bool isInitializing = true;
    private bool needsEmailConfirmation;
    private string confirmationEmail = "";
    private string emailLinkError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var linked = await Auth.CompleteStoredEmailLinkAsync();
            if (linked is null && await Auth.HasPendingEmailLinkAsync()) needsEmailConfirmation = true;
            await ResolveUserAsync(linked ?? await Auth.GetCurrentUserAsync(), await Auth.GetPendingEmailLinkUsernameAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[App] Error pre-fetching profile: {ex.Message}");
        }
        finally
        {
            isInitializing = false;
        }
    }

    private async Task CompleteEmailLink()
    {
        try
        {
            var user = await Auth.CompleteEmailLinkAsync(confirmationEmail.Trim());
            if (user is null) throw new InvalidOperationException("رابط تسجيل الدخول غير صالح.");
            await ResolveUserAsync(user, await Auth.GetPendingEmailLinkUsernameAsync());
            needsEmailConfirmation = false;
        }
        catch (Exception ex) { emailLinkError = ex.Message; }
    }

    private async Task ResolveUserAsync(AuthUser? user, string pendingUsername)
    {
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        if (!user.IsGuest && !string.IsNullOrWhiteSpace(user.AuthUid))
        {
            var dataKey = await UserService.GetDataKeyForAuthUidAsync(user.AuthUid);
            if (string.IsNullOrWhiteSpace(dataKey) && !string.IsNullOrWhiteSpace(pendingUsername))
            {
                await UserService.LinkAuthAccountAsync(pendingUsername, user.AuthUid, user.Email);
                dataKey = pendingUsername;
            }
            if (!string.IsNullOrWhiteSpace(dataKey))
            {
                await Auth.SetActiveDataKeyAsync(dataKey);
                user = await Auth.GetCurrentUserAsync();
            }
        }
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        var profile = await UserService.GetProfileAsync(user.Uid);
        if (profile is null)
            await UserService.CreateProfileAsync(new UserProfile { Uid = user.Uid, DisplayName = user.IsGuest ? "ضيف" : user.DisplayName });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("nxtweek.checkVersion");
    }
}
