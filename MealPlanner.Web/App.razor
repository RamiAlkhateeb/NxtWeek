@inject IAuthService Auth
@inject IUserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using MealPlanner.Shared.Components

@if (isInitializing)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh; flex-direction: column; background-color: #f8fafc;">
        <span style="font-size: 64px; animation: bounce 1.5s infinite;">🍳</span>
        <p style="font-family: sans-serif; color: #64748b; font-size: 18px; margin-top: 16px; direction: rtl;">جاري التحميل...</p>
    </div>
}
else
{
    <Router AppAssembly="@typeof(Program).Assembly"
            AdditionalAssemblies="new[] { typeof(MealPlanner.Shared._Imports).Assembly }">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>

    @if (needsEmailConfirmation)
    {
        <div class="ios-install-backdrop">
            <section class="ios-install-guide" dir="rtl">
                <span class="ios-install-icon">✉️</span>
                <h2>أكمل تسجيل الدخول</h2>
                <p>اكتب البريد الإلكتروني الذي أرسلنا إليه الرابط للتأكد من هويتك.</p>
                <input class="ui-text-input" type="email" @bind="confirmationEmail" placeholder="name@example.com" />
                @if (!string.IsNullOrWhiteSpace(emailLinkError)) { <p class="error-msg">@emailLinkError</p> }
                <button @onclick="CompleteEmailLink" disabled="@string.IsNullOrWhiteSpace(confirmationEmail)">متابعة</button>
            </section>
        </div>
    }

    @if (showIosInstallGuide && !needsEmailConfirmation && !showUsernameOnboarding)
    {
        <div class="ios-home-guide-backdrop" role="presentation">
            <section class="ios-home-guide" dir="rtl" role="dialog" aria-modal="true" aria-labelledby="ios-home-guide-title">
                <span class="ios-home-guide-icon" aria-hidden="true">📲</span>
                <h2 id="ios-home-guide-title">أضف مكدوس إلى الشاشة الرئيسية</h2>
                <p>اضغط زر المشاركة في Safari، ثم اختر «إضافة إلى الشاشة الرئيسية».</p>
                <img class="ios-home-guide-gif" src="@($"assets/ios-add-to-home.gif?play={iosGuideReplayKey}")" alt="شرح إضافة مكدوس إلى الشاشة الرئيسية على iPhone" />
                <div class="ios-home-guide-actions">
                    <button class="ios-home-guide-replay" @onclick="ReplayIosInstallGuide">إعادة العرض</button>
                    <button class="ios-home-guide-got-it" @onclick="DismissIosInstallGuide">فهمت</button>
                </div>
            </section>
        </div>
    }

    <UiBottomSheet IsOpen="showUsernameOnboarding" Title="اختر اسم مستخدم" Eyebrow="حتى يتمكن أصدقاؤك من العثور عليك" OnDismiss="() => { }">
        <div class="sheet-actions">
            <p>استخدم 3 إلى 20 حرفاً إنجليزياً أو رقماً أو علامة _.</p>
            <input class="ui-text-input" dir="ltr" @bind="onboardingUsername" @bind:event="oninput" @onblur="CheckOnboardingUsername" placeholder="مثال: rami_food" />
            @if (!string.IsNullOrWhiteSpace(usernameOnboardingFeedback)) { <p class="friend-feedback @(usernameOnboardingError ? "error" : "")">@usernameOnboardingFeedback</p> }
            <UiButton Variant="primary" OnClick="SaveOnboardingUsername" Disabled="@(isSavingOnboardingUsername || string.IsNullOrWhiteSpace(onboardingUsername))">@(isSavingOnboardingUsername ? "جارِ الحفظ..." : "حفظ والمتابعة")</UiButton>
        </div>
    </UiBottomSheet>
}

@code {
    private bool isInitializing = true;
    private bool needsEmailConfirmation;
    private bool showIosInstallGuide;
    private string confirmationEmail = "";
    private string emailLinkError = "";
    private long iosGuideReplayKey;
    private bool showUsernameOnboarding;
    private bool usernameOnboardingError;
    private bool isSavingOnboardingUsername;
    private string onboardingUsername = "";
    private string usernameOnboardingFeedback = "";
    private AuthUser? onboardingUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var linked = await Auth.CompleteStoredEmailLinkAsync();
            if (linked is null && await Auth.HasPendingEmailLinkAsync()) needsEmailConfirmation = true;
            await ResolveUserAsync(linked ?? await Auth.GetCurrentUserAsync(), await Auth.GetPendingEmailLinkUsernameAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[App] Error pre-fetching profile: {ex.Message}");
        }
        finally
        {
            isInitializing = false;
        }
    }

    private async Task CompleteEmailLink()
    {
        try
        {
            var user = await Auth.CompleteEmailLinkAsync(confirmationEmail.Trim());
            if (user is null) throw new InvalidOperationException("رابط تسجيل الدخول غير صالح.");
            await ResolveUserAsync(user, await Auth.GetPendingEmailLinkUsernameAsync());
            needsEmailConfirmation = false;
        }
        catch (Exception ex) { emailLinkError = ex.Message; }
    }

    private async Task ResolveUserAsync(AuthUser? user, string pendingUsername)
    {
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        if (!user.IsGuest && !string.IsNullOrWhiteSpace(user.AuthUid))
        {
            var dataKey = await UserService.GetDataKeyForAuthUidAsync(user.AuthUid);
            if (string.IsNullOrWhiteSpace(dataKey) && !string.IsNullOrWhiteSpace(pendingUsername))
            {
                await UserService.LinkAuthAccountAsync(pendingUsername, user.AuthUid, user.Email);
                dataKey = pendingUsername;
            }
            if (!string.IsNullOrWhiteSpace(dataKey))
            {
                await Auth.SetActiveDataKeyAsync(dataKey);
                user = await Auth.GetCurrentUserAsync();
            }
        }
        if (user is null || string.IsNullOrWhiteSpace(user.Uid)) return;
        var profile = await UserService.GetProfileAsync(user.Uid);
        if (profile is null)
        {
            profile = new UserProfile { Uid = user.Uid, DisplayName = user.IsGuest ? "ضيف" : user.DisplayName };
            await UserService.CreateProfileAsync(profile);
        }
        if (user.IsGuest && string.IsNullOrWhiteSpace(profile.Username))
        {
            onboardingUser = user;
            showUsernameOnboarding = true;
        }
    }

    private async Task CheckOnboardingUsername()
    {
        usernameOnboardingFeedback = "";
        if (string.IsNullOrWhiteSpace(onboardingUsername) || onboardingUser is null) return;
        try
        {
            var available = await UserService.IsUsernameAvailableAsync(onboardingUsername, onboardingUser.Uid);
            usernameOnboardingError = !available;
            usernameOnboardingFeedback = available ? "اسم المستخدم متاح ✓" : "اسم المستخدم مستخدم بالفعل.";
        }
        catch (Exception ex) { usernameOnboardingError = true; usernameOnboardingFeedback = ex.Message; }
    }

    private async Task SaveOnboardingUsername()
    {
        if (onboardingUser is null) return;
        isSavingOnboardingUsername = true;
        usernameOnboardingFeedback = "";
        try
        {
            var username = await UserService.RenameUserAsync(onboardingUser.Uid, onboardingUsername);
            await Auth.SetActiveDataKeyAsync(username);
            showUsernameOnboarding = false;
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex) { usernameOnboardingError = true; usernameOnboardingFeedback = ex.Message; }
        finally { isSavingOnboardingUsername = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("nxtweek.checkVersion");
            showIosInstallGuide = await JS.InvokeAsync<bool>("nxtweek.shouldShowIosInstallGuide");
            if (showIosInstallGuide) StateHasChanged();
        }
    }

    private async Task DismissIosInstallGuide()
    {
        showIosInstallGuide = false;
        await JS.InvokeVoidAsync("nxtweek.markIosInstallGuideSeen");
    }

    private void ReplayIosInstallGuide() => iosGuideReplayKey = DateTime.UtcNow.Ticks;
}
