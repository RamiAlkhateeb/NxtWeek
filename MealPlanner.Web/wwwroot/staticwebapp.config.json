{
  "routes": [
    {
      "route": "/version.json",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    }
  ],
  "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/css/*",
            "/js/*",
            "/assets/*",
            "/_framework/*",
            "*.{css,scss,js,json,png,jpg,gif,ico}"
        ]
    }
}
